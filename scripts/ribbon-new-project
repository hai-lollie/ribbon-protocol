#!/usr/bin/env bash
# ribbon-new-project — unpack or update a standalone Ribbon Protocol instance
# for one project.
#
# Usage:
#   scripts/ribbon-new-project [--force] --projects DIR [--ribbon-home DIR] \
#       <project-name> <project-repo-path>
#   scripts/ribbon-new-project --update --projects DIR [--ribbon-home DIR] \
#       <project-name> [project-repo-path]
#
# Install creates <projects-dir>/<project-name>/ holding the working files
# Ribbon needs (docs/tasks, docs/llm-context, seeded docs/README.md, a
# project-repo pointer), seeds it from the template repository, writes a
# marked standalone block into the project's AGENTS.local.md (personal to
# this machine — add it to .gitignore), and adds a one-line pointer to
# AGENTS.md so agents find it. When the project is a git repository it also
# installs a managed post-checkout hook that links the untracked local files
# into each new worktree. Only the final artifacts (docs/adrs,
# docs/diagrams) are ever written into the project repository.
#
# --update refreshes template and schema files and the seed version in an
# existing instance. Project agent instructions are only appended when
# missing; live plans, cards and reports are never touched.

set -euo pipefail

readonly START_MARK='<!-- ribbon:standalone:start -->'
readonly END_MARK='<!-- ribbon:standalone:end -->'

# State set by parse_args and consumed by the pipeline below.
FORCE=0
UPDATE=0
PROJECTS_DIR=''
RIBBON_HOME=''
PROJECT_NAME=''
PROJECT_REPO=''
INSTANCE=''
HERDR_NOTE=''
HERDR_COPY_NEEDED=0
IMPORT_NOTE=''
IMPORT_RULES=()
ASSUME_YES=0
NEEDS_REBUILD=0
WORKTREE_NOTE=''
WORKTREE_HOOK=''
LOCAL_BLOCK=''
AGENTS_POINTER_NEEDED=0
SELECTED_RULES=()
EXISTING_PROJECT_DOCS_AND_RULES=()
GNU_REALPATH=''

#######################################
# Validate every --import-rules file before any mutating step, so a typo
# fails fast instead of halfway through an install.
# Globals:
#   HOME, IMPORT_RULES
#######################################
validate_import_rules() {
  [[ "${#IMPORT_RULES[@]}" -gt 0 ]] || return 0
  local f
  for f in "${IMPORT_RULES[@]}"; do
    [[ "${f}" != */* ]] || die "--import-rules takes file names, not paths: ${f}"
    [[ -f "${HOME}/.claude/rules/${f}" ]] \
      || die "--import-rules file not found: ${HOME}/.claude/rules/${f}"
  done
}

#######################################
# Print an error message to STDERR and exit.
# Arguments:
#   Message text.
# Outputs:
#   Writes to STDERR.
#######################################
die() {
  printf 'ribbon-new-project: %s\n' "$*" >&2
  exit 1
}

#######################################
# Print usage to STDOUT.
# Outputs:
#   Writes to STDOUT.
#######################################
usage() {
  cat <<'EOF'
Usage:
  scripts/ribbon-new-project [--force] [--yes] --projects DIR \
      [--ribbon-home DIR] [--import-rules F]... <project-name> <project-repo-path>
  scripts/ribbon-new-project --update [--yes] --projects DIR \
      [--ribbon-home DIR] [--import-rules F]... <project-name> [project-repo-path]

Unpacks a standalone Ribbon instance for one project (default mode), or
refreshes an existing instance (--update): template files and seed version.
Existing agent instructions, live plans, cards and reports are not rewritten.

Options:
  --projects DIR     Where per-project instances live. Required; the script
                     never creates it — a mistyped path fails with a message.
  --ribbon-home DIR  The template checkout. Default: the repository that
                     contains this script (~/ribbon-protocol when cloned
                     there).
  --force            Rebuild an existing instance from scratch; its working
                     files are discarded. Refused together with --update.
  --update           Refresh an existing instance instead of unpacking;
                     seeds rules/ into a project that predates them and
                     never resurrects deleted themes.
  --import-rules F   Copy F from ~/.claude/rules into the project's rules/.
                     One file name per occurrence; repeat the flag for more.
                     Unknown names and paths containing / fail the run before
                     anything is written. Default in a terminal: a
                     multi-select picker offers the files. Non-interactive
                     runs skip with a note and never hang.
  --yes              Skip the terminal confirmation prompt.
  -h, --help         Show this help and exit.

Examples:
  # create where instances live (the script never creates it), then unpack
  mkdir -p ~/ribbon-projects
  scripts/ribbon-new-project --projects ~/ribbon-projects my-app ~/dev/my-app

  # a new "ribbon N" appeared: refresh templates and version
  scripts/ribbon-new-project --update my-app --projects ~/ribbon-projects

  # rebuild from scratch (discards the instance's working files)
  scripts/ribbon-new-project --force --projects ~/ribbon-projects my-app ~/dev/my-app

  # import your own conventions without the interactive picker
  scripts/ribbon-new-project --projects ~/ribbon-projects my-app ~/dev/my-app \
      --import-rules xunit-patterns.md --import-rules clojure-preferences.md
EOF
}

#######################################
# Parse the command line into the state globals.
# Globals:
#   FORCE, UPDATE, PROJECTS_DIR, RIBBON_HOME, PROJECT_NAME, PROJECT_REPO
# Arguments:
#   The raw command line.
#######################################
parse_args() {
  local ribbon_home_override=''
  local -a positional=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --projects) shift; PROJECTS_DIR="${1:-}"; shift ;;
      --ribbon-home) shift; ribbon_home_override="${1:-}"; shift ;;
      --force) FORCE=1; shift ;;
      --update) UPDATE=1; shift ;;
      --yes) ASSUME_YES=1; shift ;;
      --import-rules)
        shift
        [[ $# -gt 0 && -n "$1" && "$1" != --* ]] \
          || die "--import-rules takes exactly one file name (repeat the flag for more)"
        IMPORT_RULES+=("$1")
        shift
        ;;
      -h|--help) usage; exit 0 ;;
      *) positional+=("$1"); shift ;;
    esac
  done
  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  RIBBON_HOME="${ribbon_home_override:-$(cd "${script_dir}/.." && pwd)}"
  PROJECT_NAME="${positional[0]:-}"
  PROJECT_REPO="${positional[1]:-}"
  [[ "${#positional[@]}" -le 2 ]] \
    || die "unexpected extra arguments: ${positional[*]:2}"
}

#######################################
# Validate the state globals that do not touch the filesystem.
# Globals:
#   PROJECTS_DIR, FORCE, UPDATE, PROJECT_NAME
#######################################
validate_flags() {
  [[ -n "${PROJECTS_DIR}" ]] \
    || die "--projects DIR is required (no environment default)"
  if (( FORCE == 1 && UPDATE == 1 )); then
    die "--force and --update do not combine"
  fi
  [[ -n "${PROJECT_NAME}" ]] || { usage; die "missing <project-name>"; }
  [[ "${PROJECT_NAME}" =~ ^[a-z0-9][a-z0-9-]*$ ]] \
    || die "invalid project name '${PROJECT_NAME}' (lowercase letters, digits and dashes only)"
}

#######################################
# Validate that the projects directory exists and allows writing and
# traversing with the current user's permissions.
# Globals:
#   PROJECTS_DIR
#######################################
validate_projects_dir() {
  [[ -d "${PROJECTS_DIR}" ]] \
    || die "--projects dir does not exist: ${PROJECTS_DIR}"$'\n'"create it yourself and re-run, e.g.: mkdir -p '${PROJECTS_DIR}'"
  [[ -w "${PROJECTS_DIR}" && -x "${PROJECTS_DIR}" ]] \
    || die "--projects dir is not writable with your permissions: ${PROJECTS_DIR}"
}

path_present() {
  [[ -e "$1" || -L "$1" ]]
}

validate_project_rules_directory() {
  local rules="${PROJECT_REPO}/rules"
  if [[ -L "${rules}" ]] || { [[ -e "${rules}" ]] && [[ ! -d "${rules}" ]]; }; then
    die "unsafe project directory: ${rules}"
  fi
}

validate_instance_write_directories() {
  local directory
  local -a directories=("${INSTANCE}")
  if (( UPDATE == 1 )); then
    directories+=("${INSTANCE}/docs" "${INSTANCE}/docs/tasks"
      "${INSTANCE}/docs/llm-context" "${INSTANCE}/docs/llm-context/history")
  fi
  for directory in "${directories[@]}"; do
    if [[ -L "${directory}" ]] || { [[ -e "${directory}" ]] && [[ ! -d "${directory}" ]]; }; then
      die "unsafe instance directory: ${directory}"
    fi
  done
}

collect_existing_project_docs_and_rules() {
  local name path listing
  local -a roots=()
  for name in docs rules; do
    path="${PROJECT_REPO}/${name}"
    if [[ -L "${path}" && -d "${path}" ]]; then
      die "unsafe project directory link: ${path}"
    fi
    if [[ -d "${path}" && ! -L "${path}" ]]; then
      roots+=("${path}")
    elif path_present "${path}"; then
      EXISTING_PROJECT_DOCS_AND_RULES+=("${path}")
    fi
  done
  (( ${#roots[@]} > 0 )) || return 0
  listing="$(mktemp)"
  if ! find "${roots[@]}" \( -type f -o -type l \) -print0 > "${listing}"; then
    rm -f "${listing}"
    die "cannot inspect existing project docs and rules"
  fi
  while IFS= read -r -d '' path; do
    EXISTING_PROJECT_DOCS_AND_RULES+=("${path}")
  done < "${listing}"
  rm -f "${listing}"
  for path in "${EXISTING_PROJECT_DOCS_AND_RULES[@]}"; do
    if [[ -L "${path}" && -d "${path}" ]]; then
      die "unsafe project directory link: ${path}"
    fi
  done
}

#######################################
# Find GNU realpath, whose -m resolves a path that does not exist yet: the
# system's realpath on Linux, Homebrew coreutils' grealpath on macOS, whose
# own realpath has no -m (and none at all before macOS 13).
# Globals:
#   GNU_REALPATH (set)
#######################################
find_gnu_realpath() {
  local candidate
  for candidate in realpath grealpath; do
    if "${candidate}" -m -- / >/dev/null 2>&1; then
      GNU_REALPATH="${candidate}"
      return 0
    fi
  done
  die "needs GNU realpath to resolve paths that do not exist yet; on macOS: brew install coreutils"
}

#######################################
# Print the canonical form of a path: every link followed, `.` and `..`
# folded, and components that do not exist yet kept as written.
# Globals:
#   GNU_REALPATH
# Arguments:
#   A path.
# Outputs:
#   The canonical path on STDOUT.
#######################################
canonical_path() {
  "${GNU_REALPATH}" -m -- "$1"
}

# Walk the link without dropping missing components canceled by `..`.
missing_link_component_matches_write() {
  local pending="$1" destination="$2" parent='' component entry target hops=0
  while [[ -n "${pending}" ]]; do
    component="${pending%%/*}"
    if [[ "${pending}" == */* ]]; then pending="${pending#*/}"; else pending=''; fi
    case "${component}" in
      ''|.) continue ;;
      ..) parent="${parent%/*}"; continue ;;
    esac
    entry="${parent}/${component}"
    if [[ -L "${entry}" ]]; then
      if (( ++hops > 40 )); then return 1; fi
      target="$(readlink -n -- "${entry}" && printf /)" || die "cannot read project link: ${entry}"
      if [[ "${target}" == /* ]]; then parent=''; fi
      pending="${target}${pending}"
    else
      if [[ ! -e "${entry}" && ( "${destination}" == "${entry}" || "${destination}" == "${entry}/"* ) ]]; then
        return 0
      fi
      parent="${entry}"
    fi
  done
  return 1
}

validate_existing_project_paths() {
  local destination="$1" path resolved_destination='' target
  for path in "${EXISTING_PROJECT_DOCS_AND_RULES[@]}"; do
    if [[ ! "${destination}" -ef "${path}" ]]; then
      [[ -L "${path}" ]] || continue
      if [[ -z "${resolved_destination}" ]]; then
        resolved_destination="$(canonical_path "${destination}")"
      fi
      target="$(canonical_path "${path}")"
      if [[ "${resolved_destination}" != "${target}" && "${resolved_destination}" != "${target%/}/"* ]] \
        && { [[ -e "${path}" ]] || ! missing_link_component_matches_write "${path}" "${resolved_destination}"; }; then
        continue
      fi
    fi
    die "${destination} would change existing project path: ${path#"${PROJECT_REPO}"/}"
  done
}

#######################################
# Rebuild the instance from scratch, but only after validation and
# confirmation — a declined or invalid run must never delete data.
# Globals:
#   NEEDS_REBUILD, INSTANCE
#######################################
rebuild_instance() {
  if (( NEEDS_REBUILD == 1 )); then
    rm -rf "${INSTANCE}"
  fi
}

#######################################
# Creating or rebuilding the instance must not change what project
# instruction links resolve to.
#######################################
path_uses_instance() {
  local path="$1" enters
  enters="$(python3 - "${INSTANCE}" "${path}" <<'PY'
from collections import deque
import os
from pathlib import Path
import sys

instance, path = map(Path, sys.argv[1:])
# The directory entry passed to rm matters, even if that entry is a symlink.
root = instance.parent.resolve() / instance.name
parent = Path("/")
pending = deque(path.absolute().parts[1:])
links = 0
while pending:
    component = pending.popleft()
    if component == "..":
        parent = parent.parent
        continue
    entry = parent / component
    if entry == root or root in entry.parents:
        print("yes")
        break
    if not entry.is_symlink():
        parent = entry
        continue
    links += 1
    if links > 40:
        sys.exit("too many symlink hops")
    target = Path(os.readlink(entry))
    parts = target.parts
    if target.is_absolute():
        parent = Path("/")
        parts = parts[1:]
    pending.extendleft(reversed(parts))
else:
    print("no")
PY
)" || die "cannot check where ${path} points"
  [[ "${enters}" == yes ]]
}

validate_instance_seed_instruction_links() {
  (( UPDATE == 0 )) || return 0
  local path
  for path in "${PROJECT_REPO}"/{AGENTS.md,AGENTS.local.md,CLAUDE.md,CLAUDE.local.md} "${EXISTING_PROJECT_DOCS_AND_RULES[@]}"; do
    [[ -L "${path}" ]] || continue
    if path_uses_instance "${path}"; then
      die "${path#"${PROJECT_REPO}"/} points inside the instance; refusing to seed or rebuild ${INSTANCE}"
    fi
  done
}

#######################################
# Compare planned destinations by identity, or by resolved path for a
# dangling symlink that a new file would populate.
#######################################
validate_refresh_destination() {
  local destination="$1" name instruction resolved_destination resolved_instruction
  validate_existing_project_paths "${destination}"
  for name in AGENTS.md AGENTS.local.md CLAUDE.md CLAUDE.local.md; do
    instruction="${PROJECT_REPO}/${name}"
    if [[ "${destination}" -ef "${instruction}" ]]; then
      die "${destination} would overwrite ${name}; refusing to continue"
    fi
    # A link to a not-yet-existing destination has no inode to compare.
    if [[ -L "${instruction}" && ! -e "${instruction}" ]]; then
      resolved_destination="$(canonical_path "${destination}")"
      resolved_instruction="$(canonical_path "${instruction}")"
      if [[ "${resolved_instruction}" == "${resolved_destination}" ]]; then
        die "${destination} would overwrite ${name}; refusing to continue"
      fi
    fi
  done
}

validate_instance_refresh_destination() {
  local destination="$1"
  if [[ -L "${destination}" ]] || { [[ -e "${destination}" ]] && [[ ! -f "${destination}" ]]; }; then
    die "unsafe instance file: ${destination}"
  fi
  validate_refresh_destination "${destination}"
}

validate_update_instruction_aliases() {
  (( UPDATE == 1 )) || return 0
  local directory
  for directory in "${INSTANCE}/docs" "${INSTANCE}/docs/tasks" \
      "${INSTANCE}/docs/llm-context" "${INSTANCE}/docs/llm-context/history"; do
    [[ -d "${directory}" ]] || validate_refresh_destination "${directory}"
  done
  validate_instance_refresh_destination "${INSTANCE}/docs/README.md"
  validate_instance_refresh_destination "${INSTANCE}/project-repo"
  visit_instance_template_refreshes validate_instance_refresh_destination
}

#######################################
# Validate the existing standalone block before any rebuild. Render the
# append only when the block is absent; never reserialize the existing file.
#######################################
prepare_local_block() {
  local local_md="${PROJECT_REPO}/AGENTS.local.md"
  if [[ -e "${local_md}" || -L "${local_md}" ]]; then
    [[ -f "${local_md}" ]] || die "not a regular file: ${local_md}"
  fi
  LOCAL_BLOCK="$(python3 - "${RIBBON_HOME}/AGENTS.standalone.md" "${local_md}" \
    "${RIBBON_HOME}" "${PROJECTS_DIR}" "${INSTANCE}" "${PROJECT_NAME}" "${PROJECT_REPO}" \
    "${START_MARK}" "${END_MARK}" <<'PY'
import os
from pathlib import Path
import sys

template, agents, ribbon_home, projects_dir, instance, name, repo, start, end = sys.argv[1:]
start, end = start.encode(), end.encode()
belt_start, belt_end = b"<!-- ribbon:belt:start -->", b"<!-- ribbon:belt:end -->"

def refuse(reason):
    sys.exit(f"ribbon-new-project: {reason}")

def valid_belt(body, allow_legacy=False):
    marks = body.count(belt_start), body.count(belt_end)
    return (allow_legacy and marks == (0, 0)) or (
        marks == (1, 1)
        and b"\n" in body[body.index(belt_start):body.index(belt_end)]
    )

try:
    content = Path(agents).read_bytes()
except FileNotFoundError:
    content = b""
except OSError as error:
    refuse(str(error))

if start in content or end in content:
    _, _, block_and_tail = content.partition(start)
    body, end_after_start, _ = block_and_tail.partition(end)
    if (content.count(start), content.count(end)) != (1, 1) \
            or not end_after_start or not valid_belt(body, allow_legacy=True):
        refuse("AGENTS.local.md has unclosed, duplicated or out-of-order Ribbon markers; fix it before re-running")
    sys.exit(0)

try:
    block = Path(template).read_bytes()
except OSError as error:
    refuse(str(error))
if not valid_belt(block):
    refuse(f"the belt marks in the template {template} are missing, duplicated or out of order")
for placeholder, value in [
    (b"{{RIBBON_HOME}}", ribbon_home),
    (b"{{RIBBON_PROJECTS}}", projects_dir),
    (b"{{INSTANCE}}", instance),
    (b"{{PROJECT_NAME}}", name),
    (b"{{PROJECT_REPO}}", repo),
]:
    block = block.replace(placeholder, os.fsencode(value))

separator = (b"\n" if content.endswith(b"\n") else b"\n\n") if content else b""
sys.stdout.buffer.write(separator + start + b"\n" + block.rstrip() + b"\n" + end)
PY
)"
}

#######################################
# Refuse an append through an AGENTS alias of an existing Claude file.
# A Claude symlink to a regular AGENTS file is the supported direction.
#######################################
validate_agents_destination() {
  local name="$1" destination="${PROJECT_REPO}/$1" claude
  validate_existing_project_paths "${destination}"
  for claude in CLAUDE.md CLAUDE.local.md; do
    [[ "${destination}" -ef "${PROJECT_REPO}/${claude}" ]] || continue
    if [[ ! -L "${destination}" && -L "${PROJECT_REPO}/${claude}" ]]; then
      continue
    fi
    die "${name} aliases ${claude}; refusing to write it"
  done
}

prepare_instruction_files() {
  prepare_local_block
  if [[ -n "${LOCAL_BLOCK}" ]]; then
    validate_agents_destination AGENTS.local.md
  fi
  if ! grep -q 'AGENTS\.local\.md' "${PROJECT_REPO}/AGENTS.md"; then
    validate_agents_destination AGENTS.md
    AGENTS_POINTER_NEEDED=1
  fi
}

#######################################
# Validate that the template repository has everything an instance needs.
# Globals:
#   RIBBON_HOME
#######################################
validate_template() {
  [[ -f "${RIBBON_HOME}/AGENTS.standalone.md" ]] \
    || die "template not found: ${RIBBON_HOME}/AGENTS.standalone.md (point --ribbon-home at the template repo)"
  [[ -d "${RIBBON_HOME}/docs/tasks" && -d "${RIBBON_HOME}/docs/llm-context" ]] \
    || die "template docs not found under ${RIBBON_HOME}/docs"
  [[ -d "${RIBBON_HOME}/rules" ]] \
    || die "template rules not found under ${RIBBON_HOME}/rules"
  [[ -f "${RIBBON_HOME}/scripts/standalone-post-checkout" ]] \
    || die "template not found: ${RIBBON_HOME}/scripts/standalone-post-checkout (point --ribbon-home at the template repo)"
}

#######################################
# Resolve the project repository path for this run. In --update mode with no
# path given, the instance's project-repo pointer is used.
# Globals:
#   UPDATE, INSTANCE, PROJECT_REPO (set), PROJECTS_DIR, PROJECT_NAME
#######################################
resolve_repo() {
  INSTANCE="${PROJECTS_DIR}/${PROJECT_NAME}"
  if (( UPDATE == 1 )); then
    [[ -d "${INSTANCE}" ]] || die "no instance to update: ${INSTANCE}"
    [[ -w "${INSTANCE}" && -x "${INSTANCE}" ]] \
      || die "instance is not writable with your permissions: ${INSTANCE}"
    if [[ -z "${PROJECT_REPO}" ]]; then
      [[ -f "${INSTANCE}/project-repo" ]] \
        || die "no repo path given and ${INSTANCE}/project-repo is missing"
      PROJECT_REPO="$(cat "${INSTANCE}/project-repo")"
    fi
  else
    [[ -n "${PROJECT_REPO}" ]] || die "missing <project-repo-path>"
    if [[ -e "${INSTANCE}" ]]; then
      (( FORCE == 1 )) \
        || die "instance already exists: ${INSTANCE} (re-run with --force to rebuild, or --update to refresh templates)"
      NEEDS_REBUILD=1
    fi
  fi
  [[ -d "${PROJECT_REPO}" ]] || die "project repo not found: ${PROJECT_REPO}"
  [[ -w "${PROJECT_REPO}" && -x "${PROJECT_REPO}" ]] \
    || die "project repo is not writable with your permissions: ${PROJECT_REPO}"
  [[ -f "${PROJECT_REPO}/AGENTS.md" ]] \
    || die "no AGENTS.md in ${PROJECT_REPO}; create one before unpacking"
  [[ -r "${PROJECT_REPO}/AGENTS.md" ]] \
    || die "AGENTS.md is not readable with your permissions: ${PROJECT_REPO}/AGENTS.md"
  [[ -w "${PROJECT_REPO}/AGENTS.md" ]] \
    || die "AGENTS.md is not writable with your permissions: ${PROJECT_REPO}/AGENTS.md"
  if [[ -f "${PROJECT_REPO}/AGENTS.local.md" ]]; then
    [[ -w "${PROJECT_REPO}/AGENTS.local.md" ]] \
      || die "AGENTS.local.md is not writable with your permissions: ${PROJECT_REPO}/AGENTS.local.md"
  fi
  PROJECT_REPO="$(canonical_path "${PROJECT_REPO}")"
  local instance_resolved ribbon_resolved home_resolved
  instance_resolved="$(canonical_path "${INSTANCE}")"
  ribbon_resolved="$(canonical_path "${RIBBON_HOME}")"
  if [[ "${PROJECT_REPO}" == "${instance_resolved}" || "${PROJECT_REPO}" == "${instance_resolved}"/* \
      || "${instance_resolved}" == "${PROJECT_REPO}"/* ]]; then
    die "project repo and instance path overlap: ${PROJECT_REPO} vs ${INSTANCE}"
  fi
  if [[ "${instance_resolved}" == "${ribbon_resolved}" \
      || "${instance_resolved}" == "${ribbon_resolved}"/* \
      || "${ribbon_resolved}" == "${instance_resolved}"/* ]]; then
    die "refusing to use an instance path that overlaps the template repository: ${INSTANCE}"
  fi
  home_resolved="$(canonical_path "${HOME}")"
  [[ "${instance_resolved}" != "${home_resolved}" ]] \
    || die "refusing to use your home directory as the instance: ${INSTANCE}"
}

#######################################
# Refuse the classic misinstalls — the user's home directory and the template
# repository itself — and, in a terminal, ask for confirmation before any
# write. Non-interactive runs proceed so agents never hang.
# Globals:
#   PROJECT_REPO, RIBBON_HOME, HOME, ASSUME_YES
#######################################
confirm_target() {
  local home_resolved ribbon_resolved
  home_resolved="$(canonical_path "${HOME}")"
  ribbon_resolved="$(canonical_path "${RIBBON_HOME}")"
  [[ "${PROJECT_REPO}" != "${home_resolved}" ]] \
    || die "refusing to install into your home directory: ${PROJECT_REPO}"
  [[ "${PROJECT_REPO}" != "${ribbon_resolved}" ]] \
    || die "refusing to install into the template repository itself: ${PROJECT_REPO}"
  if [[ -t 0 && "${ASSUME_YES}" -eq 0 ]]; then
    local answer
    printf 'About to write Ribbon files into %s. Proceed? [y/N] ' "${PROJECT_REPO}" >&2
    read -r answer || answer=''
    if [[ "${answer}" != "y" && "${answer}" != "Y" ]]; then
      die "aborted"
    fi
  fi
}

#######################################
# Seed or refresh the instance's docs tree. A full install copies everything;
# --update copies only template and schema files, preserving live work.
# Globals:
#   UPDATE, RIBBON_HOME, INSTANCE
#######################################
visit_instance_template_refreshes() {
  local visit="$1" template
  for template in "${RIBBON_HOME}/docs/tasks"/README.md "${RIBBON_HOME}/docs/tasks"/_template.*; do
    [[ -e "${template}" ]] || continue
    "${visit}" "${INSTANCE}/docs/tasks/${template##*/}" "${template}"
  done
  for template in "${RIBBON_HOME}/docs/llm-context"/README.md "${RIBBON_HOME}/docs/llm-context"/_*.md; do
    [[ -e "${template}" ]] || continue
    "${visit}" "${INSTANCE}/docs/llm-context/${template##*/}" "${template}"
  done
}

copy_refreshed_file() {
  cp "$2" "${1%/*}/"
}

unpack_docs() {
  mkdir -p "${INSTANCE}/docs/tasks" "${INSTANCE}/docs/llm-context/history"
  if (( UPDATE == 0 )); then
    cp -R "${RIBBON_HOME}/docs/tasks/." "${INSTANCE}/docs/tasks/"
    cp -R "${RIBBON_HOME}/docs/llm-context/." "${INSTANCE}/docs/llm-context/"
    return
  fi
  visit_instance_template_refreshes copy_refreshed_file
}

#######################################
# Seed missing project themes without replacing any existing entry.
# --update does not restore deliberately removed themes in an established
# rules directory.
# Globals:
#   UPDATE, RIBBON_HOME, PROJECT_REPO
#######################################
visit_project_rule_copies() {
  local visit="$1" template destination
  if (( UPDATE == 1 )) && path_present "${PROJECT_REPO}/rules/README.md"; then
    return 0
  fi
  for template in "${RIBBON_HOME}/rules"/*.md; do
    destination="${PROJECT_REPO}/rules/${template##*/}"
    [[ -e "${template}" ]] || continue
    path_present "${destination}" && continue
    "${visit}" "${destination}" "${template}"
  done
}

seed_rules() {
  mkdir -p "${PROJECT_REPO}/rules"
  visit_project_rule_copies copy_refreshed_file
}

#######################################
# Write the instance's docs/README.md with the current template version.
# Globals:
#   RIBBON_HOME, INSTANCE, PROJECT_NAME, PROJECT_REPO
#######################################
write_instance_readme() {
  local version
  version="$(head -1 "${RIBBON_HOME}/VERSION")"
  cat > "${INSTANCE}/docs/README.md" <<EOF
${version}

Standalone Ribbon Protocol instance for ${PROJECT_NAME}.
Linked project repo: ${PROJECT_REPO}
Seeded from: ${RIBBON_HOME} — the protocol text (AGENTS.md) and the field guide are read from there, unchanged.
Final artifacts are written into the project repo: ${PROJECT_REPO}/docs/adrs and ${PROJECT_REPO}/docs/diagrams.
EOF
}

#######################################
# Write the one-line project-repo pointer.
# Globals:
#   INSTANCE, PROJECT_REPO
#######################################
write_pointer() {
  printf '%s\n' "${PROJECT_REPO}" > "${INSTANCE}/project-repo"
}

#######################################
# Append the standalone block if preflight found it missing.
#######################################
write_local_block() {
  if [[ -n "${LOCAL_BLOCK}" ]]; then
    printf '%s\n' "${LOCAL_BLOCK}" >> "${PROJECT_REPO}/AGENTS.local.md"
  fi
}

#######################################
# Add a one-line pointer to AGENTS.local.md in the project AGENTS.md, so
# agents that read only AGENTS.md find the standalone instructions. Does
# nothing when AGENTS.md already references AGENTS.local.md.
# Globals:
#   PROJECT_REPO
#######################################
ensure_pointer() {
  if (( AGENTS_POINTER_NEEDED == 1 )); then
    printf '\n%s\n' \
      "Ribbon Protocol (standalone): this machine's working files live outside this repository; read AGENTS.local.md for where each file lives." \
      >> "${PROJECT_REPO}/AGENTS.md"
  fi
}

#######################################
# Warn about existing Claude files without a direct AGENTS import or link.
#######################################
warn_unlinked_claude_files() {
  local suffix agents claude
  for suffix in .md .local.md; do
    agents="AGENTS${suffix}"
    claude="CLAUDE${suffix}"
    [[ -f "${PROJECT_REPO}/${agents}" && -f "${PROJECT_REPO}/${claude}" ]] || continue
    if [[ -L "${PROJECT_REPO}/${claude}" && "${PROJECT_REPO}/${claude}" -ef "${PROJECT_REPO}/${agents}" ]] \
      || grep -Eq "^@(\./)?${agents//./\\.}[[:space:]]*$" "${PROJECT_REPO}/${claude}" 2>/dev/null; then
      continue
    fi
    printf 'warning: %s does not point to %s; left unchanged\n' "${claude}" "${agents}" >&2
  done
}

#######################################
# Offer the user's machine-global rules (~/.claude/rules) as project themes so
# every engineer gets them. With --import-rules, copies exactly those files.
# In a terminal, shows a multi-select prompt. Otherwise prints a note and
# imports nothing. Existing project themes are never overwritten.
# Globals:
#   HOME, PROJECT_REPO, IMPORT_RULES, IMPORT_NOTE (set)
#######################################
prepare_user_rule_imports() {
  local rules_dir="${HOME}/.claude/rules"
  local -a candidates=()
  local f
  if [[ -d "${rules_dir}" ]]; then
    for f in "${rules_dir}"/*.md; do
      [[ -f "${f}" ]] && candidates+=("$(basename "${f}")")
    done
  fi
  IMPORT_NOTE=''

  if [[ "${#IMPORT_RULES[@]}" -gt 0 ]]; then
    SELECTED_RULES=("${IMPORT_RULES[@]}")
  elif [[ "${#candidates[@]}" -eq 0 ]]; then
    return 0
  elif [[ -t 0 ]]; then
    pick_rules "${candidates[@]}"
    SELECTED_RULES=("${PICKED[@]}")
  else
    printf 'note: %d rule file(s) in %s not imported (not interactive); re-run in a terminal or pass --import-rules\n' \
      "${#candidates[@]}" "${rules_dir}" >&2
    return 0
  fi

  for f in "${SELECTED_RULES[@]}"; do
    [[ -f "${rules_dir}/${f}" ]] || die "--import-rules file not found: ${rules_dir}/${f}"
    path_present "${PROJECT_REPO}/rules/${f}" || validate_refresh_destination "${PROJECT_REPO}/rules/${f}"
  done
}

import_user_rules() {
  [[ "${#SELECTED_RULES[@]}" -gt 0 ]] || return 0
  local rules_dir="${HOME}/.claude/rules" f imported=0 kept=0
  for f in "${SELECTED_RULES[@]}"; do
    if path_present "${PROJECT_REPO}/rules/${f}"; then
      kept=$((kept + 1))
      continue
    fi
    cp "${rules_dir}/${f}" "${PROJECT_REPO}/rules/${f}"
    imported=$((imported + 1))
  done
  IMPORT_NOTE="imported ${imported} user rule file(s) from ${rules_dir}"
  if (( kept > 0 )); then
    IMPORT_NOTE+=" (${kept} already present, kept as-is)"
  fi
}

#######################################
# Interactive multi-select over the candidate rule files. Sets PICKED.
# Arguments:
#   Candidate file names.
# Globals:
#   PICKED (set)
# Outputs:
#   Prompt and menu to STDERR.
#######################################
pick_rules() {
  local -a picked=() options=("$@")
  local input tok opt p mark
  while true; do
    printf '\nImport coding rules from ~/.claude/rules so every engineer gets them?\n' >&2
    local i=1
    for opt in "${options[@]}"; do
      mark=' '
      for p in "${picked[@]}"; do
        [[ "${p}" == "${opt}" ]] && mark='x'
      done
      printf '  [%s] %d) %s\n' "${mark}" "${i}" "${opt}" >&2
      i=$((i + 1))
    done
    printf 'Toggle numbers, [a]ll, [n]one, [d]one: ' >&2
    read -r input || input='d'
    case "${input}" in
      a) picked=("${options[@]}") ;;
      n) picked=() ;;
      d) break ;;
      *[!0-9\ ]*) printf 'Answer with numbers, a, n or d.\n' >&2 ;;
      *)
        local -a toks=()
        read -ra toks <<< "${input}"
        for tok in "${toks[@]}"; do
          if [[ ! "${tok}" =~ ^[0-9]+$ ]] || (( ${#tok} > 9 )); then
            printf 'Not a rule number: %s\n' "${tok}" >&2
            continue
          fi
          local num=$((10#$tok))
          if (( num < 1 || num > ${#options[@]} )); then
            printf 'No rule number %s.\n' "${tok}" >&2
            continue
          fi
          opt="${options[$((num - 1))]}"
          local -a next=()
          local found=0
          for p in "${picked[@]}"; do
            if [[ "${p}" == "${opt}" ]]; then
              found=1
            else
              next+=("${p}")
            fi
          done
          if (( found == 0 )); then
            next+=("${opt}")
          fi
          picked=("${next[@]}")
        done
        ;;
    esac
  done
  PICKED=("${picked[@]}")
}

#######################################
# Validate the overlay before a rebuild can remove its target. A regular
# file or working external symlink is kept; an absent file is seeded.
#######################################
prepare_herdr_destination() {
  local overlay="${PROJECT_REPO}/herdr-config.md"
  HERDR_NOTE='herdr-config.md already present, left unchanged'
  if [[ -e "${overlay}" || -L "${overlay}" ]]; then
    [[ -f "${overlay}" ]] || die "herdr-config.md is not a regular file or working symlink"
    if (( NEEDS_REBUILD == 1 )) && [[ -L "${overlay}" ]] && path_uses_instance "${overlay}"; then
      die "herdr-config.md points inside the instance; refusing to rebuild ${INSTANCE}"
    fi
    return 0
  fi
  [[ -f "${RIBBON_HOME}/herdr-config.md" && -r "${RIBBON_HOME}/herdr-config.md" ]] \
    || die "overlay template is missing or unreadable: ${RIBBON_HOME}/herdr-config.md"
  validate_refresh_destination "${overlay}"
  HERDR_COPY_NEEDED=1
}

wire_herdr() {
  if (( HERDR_COPY_NEEDED == 1 )); then
    cp "${RIBBON_HOME}/herdr-config.md" "${PROJECT_REPO}/herdr-config.md"
    HERDR_NOTE='herdr-config.md copied beside AGENTS.md'
  fi
}

#######################################
# Pick the post-checkout destination without writing anything. Foreign
# hooks and custom hook paths are left alone.
#######################################
prepare_worktree_hook() {
  WORKTREE_NOTE='post-checkout hook installed — new worktrees get links to the local files'
  local worktrees
  if ! worktrees="$(git -C "${PROJECT_REPO}" worktree list --porcelain 2>/dev/null)"; then
    WORKTREE_NOTE='no git repository — post-checkout hook not installed'
    return 0
  fi
  local main_checkout
  main_checkout="$(printf '%s\n' "${worktrees}" | sed -n '1s/^worktree //p')"
  if [[ "${main_checkout}" != "${PROJECT_REPO}" ]]; then
    WORKTREE_NOTE="not the repository's main worktree — post-checkout hook not installed"
    return 0
  fi
  local hooks_dir common_dir
  if ! hooks_dir="$(git -C "${PROJECT_REPO}" rev-parse --path-format=absolute --git-path hooks)" \
     || ! common_dir="$(git -C "${PROJECT_REPO}" rev-parse --path-format=absolute --git-common-dir)"; then
    WORKTREE_NOTE='git hooks location cannot be resolved — post-checkout hook not installed'
    return 0
  fi
  if [[ "${hooks_dir}" != "${common_dir}/hooks" ]]; then
    WORKTREE_NOTE='core.hooksPath points elsewhere — left as is, post-checkout hook not installed'
    return 0
  fi
  local hook="${hooks_dir}/post-checkout"
  if [[ -e "${hook}" || -L "${hook}" ]]; then
    local mark=''
    mark="$(sed -n '2p' "${hook}" 2>/dev/null || true)"
    if [[ -L "${hook}" || "${mark}" != '# ribbon:standalone:post-checkout' ]]; then
      WORKTREE_NOTE='existing post-checkout hook left unchanged — no ribbon mark'
      return 0
    fi
    WORKTREE_NOTE='post-checkout hook refreshed from the template'
  fi
  validate_refresh_destination "${hook}"
  WORKTREE_HOOK="${hook}"
}

wire_worktree_links() {
  [[ -n "${WORKTREE_HOOK}" ]] || return 0
  local hooks_dir="${WORKTREE_HOOK%/*}"
  if [[ ! -d "${hooks_dir}" ]] && ! mkdir -p "${hooks_dir}"; then
    WORKTREE_NOTE='hooks directory missing and cannot be created — post-checkout hook not installed'
    return 0
  fi
  if [[ ! -w "${hooks_dir}" ]]; then
    WORKTREE_NOTE='hooks directory not writable — post-checkout hook not installed'
    return 0
  fi
  if ! cp "${RIBBON_HOME}/scripts/standalone-post-checkout" "${WORKTREE_HOOK}" 2>/dev/null \
      || ! chmod 0755 "${WORKTREE_HOOK}" 2>/dev/null; then
    WORKTREE_NOTE='post-checkout hook could not be written — left as is'
  fi
}

#######################################
# Print a summary of what happened.
# Globals:
#   UPDATE, INSTANCE, PROJECT_NAME, PROJECT_REPO, LOCAL_BLOCK,
#   AGENTS_POINTER_NEEDED, HERDR_NOTE, WORKTREE_NOTE
#######################################
print_summary() {
  local mode='Unpacked'
  local local_note='existing standalone block left unchanged'
  local pointer_note='existing reference left unchanged'
  (( UPDATE == 1 )) && mode='Updated'
  [[ -n "${LOCAL_BLOCK}" ]] && local_note='standalone block appended'
  (( AGENTS_POINTER_NEEDED == 1 )) && pointer_note='one-line pointer appended (see AGENTS.local.md)'
  local import_line=''
  if [[ -n "${IMPORT_NOTE}" ]]; then
    import_line="  user rules:      ${IMPORT_NOTE}
"
  fi
  cat <<EOF
${mode} Ribbon Protocol instance for ${PROJECT_NAME}:

  instance:        ${INSTANCE}
  working files:   ${INSTANCE}/docs/tasks, ${INSTANCE}/docs/llm-context
  project repo:    ${PROJECT_REPO}
  artifacts go to: ${PROJECT_REPO}/docs/adrs, ${PROJECT_REPO}/docs/diagrams
  AGENTS.local.md: ${local_note}
  AGENTS.md:       ${pointer_note}
  rules:           existing project themes left unchanged; missing themes added when seeding
${import_line}  gitignore:       add AGENTS.local.md — it is personal to this machine
  herdr:           ${HERDR_NOTE}
  worktrees:       ${WORKTREE_NOTE}

Next: read the protocol at ${RIBBON_HOME}/AGENTS.md — it governs unchanged.
EOF
}

#######################################
# Entry point: validate, resolve, unpack, wire, report.
# Arguments:
#   The raw command line.
#######################################
main() {
  parse_args "$@"
  validate_flags
  find_gnu_realpath
  validate_import_rules
  validate_projects_dir
  validate_template
  resolve_repo
  validate_project_rules_directory
  validate_instance_write_directories
  collect_existing_project_docs_and_rules
  validate_instance_seed_instruction_links
  prepare_instruction_files
  validate_update_instruction_aliases
  if ! path_present "${PROJECT_REPO}/rules"; then
    validate_refresh_destination "${PROJECT_REPO}/rules"
  fi
  visit_project_rule_copies validate_refresh_destination
  prepare_herdr_destination
  prepare_worktree_hook
  confirm_target
  prepare_user_rule_imports
  rebuild_instance
  unpack_docs
  write_instance_readme
  write_pointer
  write_local_block
  ensure_pointer
  seed_rules
  import_user_rules
  wire_herdr
  wire_worktree_links
  print_summary
  warn_unlinked_claude_files
}

main "$@"
