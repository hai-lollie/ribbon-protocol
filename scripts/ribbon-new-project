#!/usr/bin/env bash
# ribbon-new-project — unpack or update a standalone Ribbon Protocol instance
# for one project.
#
# Usage:
#   scripts/ribbon-new-project [--force] --projects DIR [--ribbon-home DIR] \
#       <project-name> <project-repo-path>
#   scripts/ribbon-new-project --update --projects DIR [--ribbon-home DIR] \
#       <project-name> [project-repo-path]
#
# Install creates <projects-dir>/<project-name>/ holding the working files
# Ribbon needs (docs/tasks, docs/llm-context, seeded docs/README.md, a
# project-repo pointer), seeds it from the template repository, writes a
# marked standalone block into the project's AGENTS.local.md (personal to
# this machine — add it to .gitignore), and adds a one-line pointer to
# AGENTS.md so agents find it. When the project is a git repository it also
# installs a managed post-checkout hook that links the untracked local files
# into each new worktree. Only the final artifacts (docs/adrs,
# docs/diagrams) are ever written into the project repository.
#
# --update renders the standalone block of AGENTS.local.md again, keeping
# only the roster and the gate between their marks, rewrites the seat files
# under <instance>/.ribbon/protocol/, and refreshes template and schema
# files and the seed version in an existing instance. Live plans, cards and
# reports are never touched.

# macOS ships bash 3.2 as /bin/bash. Before 4.4, `set -u` treats an empty
# array as unbound, and this script expands empty arrays on purpose.
if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4) )); then
  printf 'ribbon-new-project: needs bash 4.4 or newer, not %s; on macOS: brew install bash\n' \
    "${BASH_VERSION}" >&2
  exit 1
fi

set -euo pipefail

readonly START_MARK='<!-- ribbon:standalone:start -->'
readonly END_MARK='<!-- ribbon:standalone:end -->'
readonly POINTER_LINE='Ribbon Protocol (standalone): this machine'"'"'s working files live outside this repository; read AGENTS.local.md for where each file lives.'

# State set by parse_args and consumed by the pipeline below.
FORCE=0
UPDATE=0
UNINSTALL=0
REMOVE_RIBBON=0
PROJECTS_DIR=''
RIBBON_HOME=''
PROJECT_NAME=''
PROJECT_REPO=''
INSTANCE=''
IMPORT_NOTE=''
IMPORT_RULES=()
ASSUME_YES=0
NEEDS_REBUILD=0
WORKTREE_NOTE=''
WORKTREE_HOOK=''
BLOCK_MODE=''
LOCAL_BLOCK_TARGET=''
OLD_BLOCK_FILE=''
BELT_ROWS_FILE=''
BLOCK_RENDERING_FILE=''
SEAT_LIST_FILE=''
SEAT_RENDER_DIR=''
RENDER_ERROR_FILE=''
RENDER_WORK_DIR=''
SEAT_SWEEP_FILE=''
PROTOCOL_SET_ARGS=()
AGENTS_POINTER_NEEDED=0
SELECTED_RULES=()
EXISTING_PROJECT_DOCS_AND_RULES=()
GNU_REALPATH=''

#######################################
# Remove the render work dir when the run ends.
# Globals:
#   RENDER_WORK_DIR
#######################################
cleanup_work_dir() {
  [[ -z "${RENDER_WORK_DIR}" ]] || rm -rf "${RENDER_WORK_DIR}"
}
trap cleanup_work_dir EXIT

#######################################
# Validate every --import-rules file before any mutating step, so a typo
# fails fast instead of halfway through an install.
# Globals:
#   HOME, IMPORT_RULES
#######################################
validate_import_rules() {
  [[ "${#IMPORT_RULES[@]}" -gt 0 ]] || return 0
  local f
  for f in "${IMPORT_RULES[@]}"; do
    [[ "${f}" != */* ]] || die "--import-rules takes file names, not paths: ${f}"
    [[ -f "${HOME}/.claude/rules/${f}" ]] \
      || die "--import-rules file not found: ${HOME}/.claude/rules/${f}"
  done
}

#######################################
# Print an error message to STDERR and exit.
# Arguments:
#   Message text.
# Outputs:
#   Writes to STDERR.
#######################################
die() {
  printf 'ribbon-new-project: %s\n' "$*" >&2
  exit 1
}

#######################################
# Print usage to STDOUT.
# Outputs:
#   Writes to STDOUT.
#######################################
usage() {
  cat <<'EOF'
Usage:
  scripts/ribbon-new-project [--force] [--yes] --projects DIR \
      [--ribbon-home DIR] [--import-rules F]... <project-name> <project-repo-path>
  scripts/ribbon-new-project --update [--yes] --projects DIR \
      [--ribbon-home DIR] [--import-rules F]... <project-name> [project-repo-path]
  scripts/ribbon-new-project --uninstall [--remove-ribbon] [--yes] --projects DIR \
      <project-name> [project-repo-path]

Unpacks a standalone Ribbon instance for one project (default mode), or
refreshes an existing instance (--update): template files and seed version, and the
block and the seat files rendered again, keeping only the roster and the gate. Live
plans, cards and reports are not rewritten. --uninstall removes the block, the
pointer line and Ribbon's own hook from the project; it keeps the instance.

Options:
  --projects DIR     Where per-project instances live. Required; the script
                     never creates it — a mistyped path fails with a message.
  --ribbon-home DIR  The template checkout. Default: the repository that
                     contains this script (~/ribbon-protocol when cloned
                     there).
  --force            Rebuild an existing instance from scratch; its working
                     files are discarded. Refused together with --update.
  --update           Refresh an existing instance instead of unpacking;
                     seeds rules/ into a project that predates them and
                     never resurrects deleted themes.
  --import-rules F   Copy F from ~/.claude/rules into the project's rules/.
                     One file name per occurrence; repeat the flag for more.
                     Unknown names and paths containing / fail the run before
                     anything is written. Default in a terminal: a
                     multi-select picker offers the files. Non-interactive
                     runs skip with a note and never hang.
  --uninstall        Preview what an uninstall would remove; no writes by default.
  --remove-ribbon    Apply the uninstall plan after confirmation; requires --uninstall.
  --yes              Skip the confirmation; required for a removal without a terminal.
  -h, --help         Show this help and exit.

Examples:
  # create where instances live (the script never creates it), then unpack
  mkdir -p ~/ribbon-projects
  scripts/ribbon-new-project --projects ~/ribbon-projects my-app ~/dev/my-app

  # a new "ribbon N" appeared: refresh templates and version
  scripts/ribbon-new-project --update my-app --projects ~/ribbon-projects

  # rebuild from scratch (discards the instance's working files)
  scripts/ribbon-new-project --force --projects ~/ribbon-projects my-app ~/dev/my-app

  # import your own conventions without the interactive picker
  scripts/ribbon-new-project --projects ~/ribbon-projects my-app ~/dev/my-app \
      --import-rules xunit-patterns.md --import-rules clojure-preferences.md
EOF
}

#######################################
# Parse the command line into the state globals.
# Globals:
#   FORCE, UPDATE, PROJECTS_DIR, RIBBON_HOME, PROJECT_NAME, PROJECT_REPO
# Arguments:
#   The raw command line.
#######################################
parse_args() {
  local ribbon_home_override=''
  local -a positional=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --projects) shift; PROJECTS_DIR="${1:-}"; shift ;;
      --ribbon-home) shift; ribbon_home_override="${1:-}"; shift ;;
      --force) FORCE=1; shift ;;
      --update) UPDATE=1; shift ;;
      --uninstall) UNINSTALL=1; shift ;;
      --remove-ribbon) REMOVE_RIBBON=1; shift ;;
      --yes) ASSUME_YES=1; shift ;;
      --import-rules)
        shift
        [[ $# -gt 0 && -n "$1" && "$1" != --* ]] \
          || die "--import-rules takes exactly one file name (repeat the flag for more)"
        IMPORT_RULES+=("$1")
        shift
        ;;
      -h|--help) usage; exit 0 ;;
      *) positional+=("$1"); shift ;;
    esac
  done
  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  RIBBON_HOME="${ribbon_home_override:-$(cd "${script_dir}/.." && pwd)}"
  PROJECT_NAME="${positional[0]:-}"
  PROJECT_REPO="${positional[1]:-}"
  [[ "${#positional[@]}" -le 2 ]] \
    || die "unexpected extra arguments: ${positional[*]:2}"
}

#######################################
# Validate the state globals that do not touch the filesystem.
# Globals:
#   PROJECTS_DIR, FORCE, UPDATE, PROJECT_NAME
#######################################
validate_flags() {
  [[ -n "${PROJECTS_DIR}" ]] \
    || die "--projects DIR is required (no environment default)"
  validate_path_characters 'the projects directory' "${PROJECTS_DIR}"
  if (( FORCE == 1 && UPDATE == 1 )); then
    die "--force and --update do not combine"
  fi
  if (( REMOVE_RIBBON == 1 && UNINSTALL == 0 )); then
    die "--remove-ribbon requires --uninstall"
  fi
  if (( UNINSTALL == 1 )); then
    (( UPDATE == 0 )) || die "--update cannot be used with --uninstall"
    (( FORCE == 0 )) || die "--force cannot be used with --uninstall"
    [[ "${#IMPORT_RULES[@]}" -eq 0 ]] || die "--import-rules cannot be used with --uninstall"
  fi
  [[ -n "${PROJECT_NAME}" ]] || { usage; die "missing <project-name>"; }
  [[ "${PROJECT_NAME}" =~ ^[a-z0-9][a-z0-9-]*$ ]] \
    || die "invalid project name '${PROJECT_NAME}' (lowercase letters, digits and dashes only)"
}

#######################################
# Refuse a path whose canonical form holds a character below U+0020 or
# U+007F. The canonical form is computed and checked inside python, so
# no command substitution can trim a byte before the check.
# Arguments:
#   What the path is, the path.
#######################################
validate_canonical_path() {
  python3 - "$1" "$2" <<'PY'
import os
import sys

what, path = sys.argv[1:3]
resolved = os.path.realpath(path)
if any(ord(char) < 0x20 or ord(char) == 0x7F or char == "`" for char in resolved):
    escaped = "".join(
        "\\x%02x" % ord(char) if ord(char) < 0x20 or ord(char) == 0x7F else char
        for char in resolved)
    sys.exit(f"ribbon-new-project: unsupported character in {what}: {escaped}")
PY
}

#######################################
# Validate that the projects directory exists and allows writing and
# traversing with the current user's permissions, and make it absolute,
# so every path the block names resolves from the project.
# Globals:
#   PROJECTS_DIR (set)
#######################################
validate_projects_dir() {
  [[ -d "${PROJECTS_DIR}" ]] \
    || die "--projects dir does not exist: ${PROJECTS_DIR}"$'\n'"create it yourself and re-run, e.g.: mkdir -p '${PROJECTS_DIR}'"
  [[ -w "${PROJECTS_DIR}" && -x "${PROJECTS_DIR}" ]] \
    || die "--projects dir is not writable with your permissions: ${PROJECTS_DIR}"
  validate_canonical_path 'the projects directory' "${PROJECTS_DIR}"
  PROJECTS_DIR="$(canonical_path "${PROJECTS_DIR}")"
}

path_present() {
  [[ -e "$1" || -L "$1" ]]
}

#######################################
# Refuse a path that holds a character below U+0020, U+007F or a
# backtick: the Markdown and pointer formats cannot carry it, and a
# canonicalization could trim it into another pathname.
# Arguments:
#   What the path is ('the projects directory', 'the project repo path'),
#   the path.
#######################################
validate_path_characters() {
  python3 - "$1" "$2" <<'PY'
import sys

what, path = sys.argv[1:3]
if any(ord(char) < 0x20 or ord(char) == 0x7F or char == "`" for char in path):
    escaped = "".join(
        "\\x%02x" % ord(char) if ord(char) < 0x20 or ord(char) == 0x7F else char
        for char in path)
    sys.exit(f"ribbon-new-project: unsupported character in {what}: {escaped}")
PY
}

validate_project_rules_directory() {
  local rules="${PROJECT_REPO}/rules"
  if [[ -L "${rules}" ]] || { [[ -e "${rules}" ]] && [[ ! -d "${rules}" ]]; }; then
    die "unsafe project directory: ${rules}"
  fi
}

validate_instance_write_directories() {
  local directory
  local -a directories=("${INSTANCE}")
  if (( UPDATE == 1 )); then
    directories+=("${INSTANCE}/docs" "${INSTANCE}/docs/tasks"
      "${INSTANCE}/docs/llm-context" "${INSTANCE}/docs/llm-context/history")
  fi
  for directory in "${directories[@]}"; do
    if [[ -L "${directory}" ]] || { [[ -e "${directory}" ]] && [[ ! -d "${directory}" ]]; }; then
      die "unsafe instance directory: ${directory}"
    fi
  done
}

collect_existing_project_docs_and_rules() {
  local name path listing
  local -a roots=()
  for name in docs rules; do
    path="${PROJECT_REPO}/${name}"
    if [[ -L "${path}" && -d "${path}" ]]; then
      die "unsafe project directory link: ${path}"
    fi
    if [[ -d "${path}" && ! -L "${path}" ]]; then
      roots+=("${path}")
    elif path_present "${path}"; then
      EXISTING_PROJECT_DOCS_AND_RULES+=("${path}")
    fi
  done
  (( ${#roots[@]} > 0 )) || return 0
  listing="$(mktemp)"
  if ! find "${roots[@]}" \( -type f -o -type l \) -print0 > "${listing}"; then
    rm -f "${listing}"
    die "cannot inspect existing project docs and rules"
  fi
  while IFS= read -r -d '' path; do
    EXISTING_PROJECT_DOCS_AND_RULES+=("${path}")
  done < "${listing}"
  rm -f "${listing}"
  for path in "${EXISTING_PROJECT_DOCS_AND_RULES[@]}"; do
    if [[ -L "${path}" && -d "${path}" ]]; then
      die "unsafe project directory link: ${path}"
    fi
  done
}

#######################################
# Find GNU realpath, whose -m resolves a path that does not exist yet: the
# system's realpath on Linux, Homebrew coreutils' grealpath on macOS, whose
# own realpath has no -m (and none at all before macOS 13).
# Globals:
#   GNU_REALPATH (set)
#######################################
find_gnu_realpath() {
  local candidate
  for candidate in realpath grealpath; do
    if "${candidate}" -m -- / >/dev/null 2>&1; then
      GNU_REALPATH="${candidate}"
      return 0
    fi
  done
  die "needs GNU realpath to resolve paths that do not exist yet; on macOS: brew install coreutils"
}

#######################################
# Print the canonical form of a path: every link followed, `.` and `..`
# folded, and components that do not exist yet kept as written.
# Globals:
#   GNU_REALPATH
# Arguments:
#   A path.
# Outputs:
#   The canonical path on STDOUT.
#######################################
canonical_path() {
  "${GNU_REALPATH}" -m -- "$1"
}

# Walk the link without dropping missing components canceled by `..`.
missing_link_component_matches_write() {
  local pending="$1" destination="$2" parent='' component entry target hops=0
  while [[ -n "${pending}" ]]; do
    component="${pending%%/*}"
    if [[ "${pending}" == */* ]]; then pending="${pending#*/}"; else pending=''; fi
    case "${component}" in
      ''|.) continue ;;
      ..) parent="${parent%/*}"; continue ;;
    esac
    entry="${parent}/${component}"
    if [[ -L "${entry}" ]]; then
      if (( ++hops > 40 )); then return 1; fi
      target="$(readlink -n -- "${entry}" && printf /)" || die "cannot read project link: ${entry}"
      if [[ "${target}" == /* ]]; then parent=''; fi
      pending="${target}${pending}"
    else
      if [[ ! -e "${entry}" && ( "${destination}" == "${entry}" || "${destination}" == "${entry}/"* ) ]]; then
        return 0
      fi
      parent="${entry}"
    fi
  done
  return 1
}

validate_existing_project_paths() {
  local destination="$1" path resolved_destination='' target
  for path in "${EXISTING_PROJECT_DOCS_AND_RULES[@]}"; do
    if [[ ! "${destination}" -ef "${path}" ]]; then
      [[ -L "${path}" ]] || continue
      if [[ -z "${resolved_destination}" ]]; then
        resolved_destination="$(canonical_path "${destination}")"
      fi
      target="$(canonical_path "${path}")"
      if [[ "${resolved_destination}" != "${target}" && "${resolved_destination}" != "${target%/}/"* ]] \
        && { [[ -e "${path}" ]] || ! missing_link_component_matches_write "${path}" "${resolved_destination}"; }; then
        continue
      fi
    fi
    die "${destination} would change existing project path: ${path#"${PROJECT_REPO}"/}"
  done
}

#######################################
# Rebuild the instance from scratch, but only after validation and
# confirmation — a declined or invalid run must never delete data.
# Globals:
#   NEEDS_REBUILD, INSTANCE
#######################################
rebuild_instance() {
  if (( NEEDS_REBUILD == 1 )); then
    rm -rf "${INSTANCE}"
  fi
}

#######################################
# Add one destination to validate_write_destinations' planned list, as a
# visit_instance_template_refreshes visitor (bash dynamic scoping:
# planned is the caller's local).
# Arguments:
#   The destination, the template (unused).
#######################################
plan_write_destination() {
  planned+=("$1")
}

#######################################
# Before the first write, every destination of the run can be written:
# the file write_block actually replaces (LOCAL_BLOCK_TARGET once
# validate_instruction_link_safety has resolved a worktree's link,
# otherwise the project's AGENTS.local.md), the pointer when it is added,
# every seat file, the instance's docs/README.md and project-repo, on
# --update every refreshed template file, the instance's
# docs/llm-context/history when unpack_docs would create it, and each
# missing rule seed: the directory of each new file and each rewritten
# file is writable and searchable, and each rewritten file is writable.
# Globals:
#   PROJECT_REPO, PROJECTS_DIR, INSTANCE, RIBBON_HOME, SEAT_LIST_FILE,
#   AGENTS_POINTER_NEEDED, SELECTED_RULES, LOCAL_BLOCK_TARGET, UPDATE
#######################################
validate_write_destinations() {
  local path directory rel template
  local -a planned=("${LOCAL_BLOCK_TARGET:-${PROJECT_REPO}/AGENTS.local.md}")
  (( AGENTS_POINTER_NEEDED == 1 )) && planned+=("${PROJECT_REPO}/AGENTS.md")
  local installed
  while IFS=$'\t' read -r rel installed; do
    planned+=("${INSTANCE}/.ribbon/protocol/${installed}")
  done < "${SEAT_LIST_FILE}"
  planned+=("${INSTANCE}/docs/README.md" "${INSTANCE}/project-repo")
  if (( UPDATE == 1 )); then
    visit_instance_template_refreshes plan_write_destination
  fi
  [[ -d "${INSTANCE}/docs/llm-context/history" ]] \
    || planned+=("${INSTANCE}/docs/llm-context/history")
  for template in "${RIBBON_HOME}/rules"/*.md; do
    [[ -e "${template}" ]] || continue
    path_present "${PROJECT_REPO}/rules/${template##*/}" && continue
    planned+=("${PROJECT_REPO}/rules/${template##*/}")
  done
  for rel in "${SELECTED_RULES[@]}"; do
    path_present "${PROJECT_REPO}/rules/${rel}" && continue
    planned+=("${PROJECT_REPO}/rules/${rel}")
  done
  for path in "${planned[@]}"; do
    directory="${path%/*}"
    while [[ ! -d "${directory}" ]]; do
      directory="${directory%/*}"
    done
    [[ -w "${directory}" && -x "${directory}" ]] || die "not writable: ${directory}"
    if path_present "${path}"; then
      [[ -w "${path}" ]] || die "not writable: ${path}"
    fi
  done
}

#######################################
# Creating or rebuilding the instance must not change what project
# instruction links resolve to.
#######################################
path_uses_instance() {
  local path="$1" enters
  enters="$(python3 - "${INSTANCE}" "${path}" <<'PY'
from collections import deque
import os
from pathlib import Path
import sys

instance, path = map(Path, sys.argv[1:])
# The directory entry passed to rm matters, even if that entry is a symlink.
root = instance.parent.resolve() / instance.name
parent = Path("/")
pending = deque(path.absolute().parts[1:])
links = 0
while pending:
    component = pending.popleft()
    if component == "..":
        parent = parent.parent
        continue
    entry = parent / component
    if entry == root or root in entry.parents:
        print("yes")
        break
    if not entry.is_symlink():
        parent = entry
        continue
    links += 1
    if links > 40:
        sys.exit("too many symlink hops")
    target = Path(os.readlink(entry))
    parts = target.parts
    if target.is_absolute():
        parent = Path("/")
        parts = parts[1:]
    pending.extendleft(reversed(parts))
else:
    print("no")
PY
)" || die "cannot check where ${path} points"
  [[ "${enters}" == yes ]]
}

validate_instance_seed_instruction_links() {
  (( UPDATE == 0 )) || return 0
  local path
  for path in "${PROJECT_REPO}"/{AGENTS.md,AGENTS.local.md,CLAUDE.md,CLAUDE.local.md} "${EXISTING_PROJECT_DOCS_AND_RULES[@]}"; do
    [[ -L "${path}" ]] || continue
    if path_uses_instance "${path}"; then
      die "${path#"${PROJECT_REPO}"/} points inside the instance; refusing to seed or rebuild ${INSTANCE}"
    fi
  done
}

#######################################
# Compare planned destinations by identity, or by resolved path for a
# dangling symlink that a new file would populate.
#######################################
validate_refresh_destination() {
  local destination="$1" name instruction resolved_destination resolved_instruction
  validate_existing_project_paths "${destination}"
  for name in AGENTS.md AGENTS.local.md CLAUDE.md CLAUDE.local.md; do
    instruction="${PROJECT_REPO}/${name}"
    if [[ "${destination}" -ef "${instruction}" ]]; then
      die "${destination} would overwrite ${name}; refusing to continue"
    fi
    # A link to a not-yet-existing destination has no inode to compare.
    if [[ -L "${instruction}" && ! -e "${instruction}" ]]; then
      resolved_destination="$(canonical_path "${destination}")"
      resolved_instruction="$(canonical_path "${instruction}")"
      if [[ "${resolved_instruction}" == "${resolved_destination}" ]]; then
        die "${destination} would overwrite ${name}; refusing to continue"
      fi
    fi
  done
}

validate_instance_refresh_destination() {
  local destination="$1"
  if [[ -L "${destination}" ]] || { [[ -e "${destination}" ]] && [[ ! -f "${destination}" ]]; }; then
    die "unsafe instance file: ${destination}"
  fi
  validate_refresh_destination "${destination}"
  if [[ -f "${destination}" ]] \
    && [[ -n "$(find "${destination}" -maxdepth 0 -links +1 -print -quit)" ]]; then
    die "unsafe instance file: ${destination}"
  fi
}

validate_update_instruction_aliases() {
  (( UPDATE == 1 )) || return 0
  local directory
  for directory in "${INSTANCE}/docs" "${INSTANCE}/docs/tasks" \
      "${INSTANCE}/docs/llm-context" "${INSTANCE}/docs/llm-context/history"; do
    [[ -d "${directory}" ]] || validate_refresh_destination "${directory}"
  done
  validate_instance_refresh_destination "${INSTANCE}/docs/README.md"
  validate_instance_refresh_destination "${INSTANCE}/project-repo"
  visit_instance_template_refreshes validate_instance_refresh_destination
  validate_seat_files
}

#######################################
# Refuse a project that holds a full install, by its block mark or by its
# receipt, before any write.
# Globals:
#   PROJECT_REPO
#######################################
refuse_full_install() {
  if grep -qE '^<!-- ribbon:full-install:start -->'$'\r''?$' "${PROJECT_REPO}/AGENTS.md" \
      || [[ -e "${PROJECT_REPO}/docs/.ribbon-full-install" ]]; then
    die "${PROJECT_REPO} has a full install; uninstall it, then install"
  fi
}

#######################################
# Validate the existing standalone block before any rebuild and classify
# it: no block (append), a ribbon 2 block with a ribbon:gate region
# (replace, keeping the roster and the gate), or an older block (refuse).
# The old block and the older block's belt table rows go to work files.
# Globals:
#   PROJECT_REPO, RENDER_WORK_DIR, BLOCK_MODE (set), OLD_BLOCK_FILE,
#   BELT_ROWS_FILE
#######################################
prepare_local_block() {
  local local_md="${PROJECT_REPO}/AGENTS.local.md"
  if [[ -e "${local_md}" || -L "${local_md}" ]]; then
    [[ -f "${local_md}" ]] || die "not a regular file: ${local_md}"
  fi
  BLOCK_MODE=append
  local state
  state="$(python3 - "${local_md}" "${OLD_BLOCK_FILE}" "${BELT_ROWS_FILE}" <<'PY'
import sys

local_md, old_block_file, belt_rows_file = sys.argv[1:4]
start = b"<!-- ribbon:standalone:start -->"
end = b"<!-- ribbon:standalone:end -->"
belt_start = b"<!-- ribbon:belt:start -->"
belt_end = b"<!-- ribbon:belt:end -->"
gate_start = b"<!-- ribbon:gate:start -->"
gate_end = b"<!-- ribbon:gate:end -->"

def refuse(reason):
    sys.exit(f"ribbon-new-project: {reason}")

def mark_lines(data, mark):
    """The indices of the lines that are exactly mark, ending in LF, in
    CR LF, or at the end of the file; a mark's text inside a line is no
    mark, and a trailing CR counts only before an LF."""
    lines = data.split(b"\n")
    found = []
    for index, line in enumerate(lines):
        if line == mark or (index < len(lines) - 1 and line == mark + b"\r"):
            found.append(index)
    return found, lines

try:
    with open(local_md, "rb") as stream:
        content = stream.read()
except FileNotFoundError:
    content = b""
except OSError as error:
    refuse(str(error))

starts, lines = mark_lines(content, start)
ends, _ = mark_lines(content, end)
if not starts and not ends:
    print("none")
    sys.exit(0)
if len(starts) != 1 or len(ends) != 1 or starts[0] >= ends[0]:
    refuse("AGENTS.local.md has unclosed, duplicated or out-of-order Ribbon markers; fix it before re-running")

body = b"\n".join(lines[starts[0] + 1:ends[0]])
marks = body.count(belt_start), body.count(belt_end)
if marks != (0, 0) and not (
        marks == (1, 1)
        and b"\n" in body[body.index(belt_start):body.index(belt_end)]):
    refuse("AGENTS.local.md has unclosed, duplicated or out-of-order Ribbon markers; fix it before re-running")

def has_gate_region(text):
    start_at = None
    for index, raw in enumerate(text.split(b"\n")):
        line = raw[:-1] if raw.endswith(b"\r") else raw
        if line == gate_start and start_at is None:
            start_at = index
        elif line == gate_end and start_at is not None:
            return True
    return False

if not has_gate_region(body):
    rows = []
    in_table = False
    for line in body.split(b"\n"):
        if line.startswith(b"| Role | Agent | Model"):
            in_table = True
        if not in_table:
            continue
        if not line.startswith(b"|"):
            break
        rows.append(line)
    with open(belt_rows_file, "wb") as stream:
        for row in rows:
            stream.write(row + b"\n")
    print("older")
    sys.exit(0)

block = b"\n".join(lines[starts[0]:ends[0] + 1]) + b"\n"
with open(old_block_file, "wb") as stream:
    stream.write(block)
print("replace")
PY
)"
  if [[ "${state}" == older ]]; then
    cat "${BELT_ROWS_FILE}"
    die "AGENTS.local.md holds an older standalone block; uninstall it (ribbon-new-project --uninstall), then install"
  fi
  if [[ "${state}" == replace ]]; then
    BLOCK_MODE=replace
  fi
}

#######################################
# Run the template's renderer once; a failure stops the run before any
# write, with the renderer's stderr line in the message.
# Arguments:
#   Output file, then the renderer's arguments after the --set values.
# Globals:
#   RIBBON_HOME, PROTOCOL_SET_ARGS, RENDER_ERROR_FILE
#######################################
run_renderer() {
  local output="$1"
  shift
  if ! "${RIBBON_HOME}/scripts/ribbon-render-protocol" \
      --protocol "${RIBBON_HOME}/protocol" "${PROTOCOL_SET_ARGS[@]}" "$@" \
      > "${output}" 2> "${RENDER_ERROR_FILE}"; then
    die "cannot render the protocol: $(cat "${RENDER_ERROR_FILE}")"
  fi
}

#######################################
# Render the block and every seat file before any write: the block with
# --keep-from the old block when one is replaced, the seat list, then each
# seat file into the render work dir.
# Globals:
#   RIBBON_HOME, RIBBON_PROJECTS, INSTANCE, PROJECT_NAME, PROJECT_REPO,
#   PROTOCOL_SET_ARGS (set), BLOCK_MODE, OLD_BLOCK_FILE,
#   BLOCK_RENDERING_FILE, SEAT_LIST_FILE, SEAT_RENDER_DIR
#######################################
render_the_protocol() {
  PROTOCOL_SET_ARGS=(
    --set "RIBBON_HOME=${RIBBON_HOME}"
    --set "RIBBON_PROJECTS=${PROJECTS_DIR}"
    --set "INSTANCE=${INSTANCE}"
    --set "PROJECT_NAME=${PROJECT_NAME}"
    --set "PROJECT_REPO=${PROJECT_REPO}"
    --set "PROTOCOL_DIR=${INSTANCE}/.ribbon/protocol"
  )
  local -a keep=()
  if [[ "${BLOCK_MODE}" == replace ]]; then
    keep=(--keep-from "${OLD_BLOCK_FILE}")
  fi
  run_renderer "${BLOCK_RENDERING_FILE}" "${keep[@]}" standalone-structure.md
  run_renderer "${SEAT_LIST_FILE}" --seat-files standalone-structure.md
  local path installed
  while IFS=$'\t' read -r path installed; do
    if [[ "${installed}" == */* ]]; then
      mkdir -p "${SEAT_RENDER_DIR}/${installed%/*}"
    fi
    run_renderer "${SEAT_RENDER_DIR}/${installed}" "${path}"
  done < "${SEAT_LIST_FILE}"
}

#######################################
# Every '<instance>/.ribbon/protocol/<x>' path that the rendered block
# names between backticks must be a seat file of the run.
# Globals:
#   INSTANCE, BLOCK_RENDERING_FILE, SEAT_LIST_FILE
#######################################
validate_block_seat_pointers() {
  python3 - "${BLOCK_RENDERING_FILE}" "${SEAT_LIST_FILE}" \
    "${INSTANCE}/.ribbon/protocol/" <<'PY'
import re
import sys

block_file, seat_list, prefix = sys.argv[1:4]
installed = set()
for line in open(seat_list, encoding="utf-8"):
    installed.add(line.rstrip("\n").split("\t")[1])
text = open(block_file, encoding="utf-8").read()
for match in re.finditer(r"`([^`]*)`", text):
    name = match.group(1)
    if not name.startswith(prefix):
        continue
    seat = name[len(prefix):]
    if seat and seat not in installed:
        sys.exit("ribbon-new-project: the block names a seat file that the "
                 "template does not have: %s" % seat)
PY
}

#######################################
# A seat file is written only when every directory of its path below the
# instance is a real directory (not a link) and the leaf, when it exists,
# is a regular file with one hard link.
# Globals:
#   INSTANCE, SEAT_LIST_FILE
#######################################
validate_seat_files() {
  python3 - "${INSTANCE}" "${SEAT_LIST_FILE}" <<'PY'
import os
import stat
import sys

instance, seat_list = sys.argv[1:3]
for line in open(seat_list, encoding="utf-8"):
    installed = line.rstrip("\n").split("\t")[1]
    parts = installed.split("/")
    current = instance
    for component in [".ribbon", "protocol"] + parts[:-1]:
        current = os.path.join(current, component)
        if os.path.islink(current) or (
                os.path.exists(current) and not os.path.isdir(current)):
            sys.exit(f"ribbon-new-project: unsafe seat file: {current}")
    target = os.path.join(current, parts[-1])
    if os.path.lexists(target):
        info = os.lstat(target)
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            sys.exit(f"ribbon-new-project: unsafe seat file: {target}")
PY
}

#######################################
# Enumerate the seat tree for the stray sweep into a work file, checking
# find's status, before any write. On install and --force the tree is
# new, so the inventory stays empty.
# Globals:
#   UPDATE, INSTANCE, SEAT_SWEEP_FILE
#######################################
prepare_seat_sweep() {
  (( UPDATE == 1 )) || return 0
  if [[ -d "${INSTANCE}/.ribbon/protocol" ]]; then
    if ! find "${INSTANCE}/.ribbon/protocol" \( -type f -o -type l \) -print0 \
        > "${SEAT_SWEEP_FILE}"; then
      die "cannot list ${INSTANCE}/.ribbon/protocol; nothing changed"
    fi
  fi
}

#######################################
# Refuse an append through an AGENTS alias of an existing Claude file.
# A Claude symlink to a regular AGENTS file is the supported direction.
#######################################
validate_agents_destination() {
  local name="$1" destination="${PROJECT_REPO}/$1" claude
  validate_existing_project_paths "${destination}"
  for claude in CLAUDE.md CLAUDE.local.md; do
    [[ "${destination}" -ef "${PROJECT_REPO}/${claude}" ]] || continue
    if [[ ! -L "${destination}" && -L "${PROJECT_REPO}/${claude}" ]]; then
      continue
    fi
    die "${name} aliases ${claude}; refusing to write it"
  done
}

#######################################
# For each of AGENTS.local.md and AGENTS.md that the run will write (the
# block appended or replaced; the pointer appended), and only for those:
# the file may be a link only to a file of the same name (a worktree's
# link to the main checkout's file); one that aliases the overlay, the
# other AGENTS file or a Claude file, or that has more than one hard
# link, is refused before any write. Runs after the existing alias and
# refresh-destination checks, so their messages fire first where they
# apply.
# Globals:
#   PROJECT_REPO, AGENTS_POINTER_NEEDED
#######################################
#######################################
# For each of AGENTS.local.md and AGENTS.md that the run will write (the
# block appended or replaced; the pointer appended), and only for those:
# the whole link chain is followed; every link in it names a file of the
# same basename, and the final target is a regular file with one hard
# link, of that name, and not one of the other instruction files;
# otherwise G6's refusal. The resolved target of AGENTS.local.md becomes
# LOCAL_BLOCK_TARGET, so the write goes to the final target and a
# worktree's link stays a link. Runs after the existing alias and
# refresh-destination checks, so their messages fire first where they
# apply.
# Globals:
#   PROJECT_REPO, AGENTS_POINTER_NEEDED, LOCAL_BLOCK_TARGET (set)
#######################################
validate_instruction_link_safety() {
  local name
  for name in AGENTS.local.md AGENTS.md; do
    if [[ "${name}" == AGENTS.md ]] && (( AGENTS_POINTER_NEEDED == 0 )); then
      continue
    fi
    if [[ "${name}" == AGENTS.local.md ]]; then
      LOCAL_BLOCK_TARGET="$(resolve_instruction_chain "${name}")"
    else
      resolve_instruction_chain "${name}" > /dev/null
    fi
  done
}

#######################################
# Follow one instruction file's link chain and print its final target.
# Every link in the chain must name a file of the same basename; the
# final target must be a regular file with one hard link. A Claude file
# that links to the AGENTS file (the README's wiring) changes neither
# and stays supported; a hard link of the AGENTS file fails the one-hard
# -link check.
# Arguments:
#   The file name (AGENTS.local.md or AGENTS.md).
# Globals:
#   PROJECT_REPO
#######################################
resolve_instruction_chain() {
  python3 - "${PROJECT_REPO}" "$1" <<'PY'
import os
import stat
import sys

root, name = sys.argv[1:3]

def refuse():
    sys.exit(f"ribbon-new-project: {name} is a link to another file or has "
             "other names; refusing to write it")

current = os.path.join(root, name)
seen = set()
while os.path.islink(current):
    target = os.readlink(current)
    if os.path.basename(target) != name:
        refuse()
    if not os.path.isabs(target):
        target = os.path.join(os.path.dirname(current), target)
    current = os.path.normpath(target)
    if current in seen:
        refuse()
    seen.add(current)
if os.path.lexists(current):
    info = os.lstat(current)
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
        refuse()
sys.stdout.write(current + "\n")
PY
}

prepare_instruction_files() {
  prepare_local_block
  if [[ "${BLOCK_MODE}" == append ]]; then
    validate_agents_destination AGENTS.local.md
  fi
  if ! grep -q 'AGENTS\.local\.md' "${PROJECT_REPO}/AGENTS.md"; then
    validate_agents_destination AGENTS.md
    AGENTS_POINTER_NEEDED=1
  fi
}

#######################################
# Validate that the template repository has everything an instance needs,
# and read everything the run needs afterwards: the seed version and every
# template file it will copy, before any write.
# Globals:
#   RIBBON_HOME, RENDER_WORK_DIR
#######################################
validate_template() {
  [[ -f "${RIBBON_HOME}/protocol/standalone-structure.md" ]] \
    || die "template not found: ${RIBBON_HOME}/protocol/standalone-structure.md (point --ribbon-home at the template repo)"
  [[ -x "${RIBBON_HOME}/scripts/ribbon-render-protocol" ]] \
    || die "template not found: ${RIBBON_HOME}/scripts/ribbon-render-protocol (point --ribbon-home at the template repo)"
  [[ -d "${RIBBON_HOME}/docs/tasks" && -d "${RIBBON_HOME}/docs/llm-context" ]] \
    || die "template docs not found under ${RIBBON_HOME}/docs"
  [[ -d "${RIBBON_HOME}/rules" ]] \
    || die "template rules not found under ${RIBBON_HOME}/rules"
  [[ -f "${RIBBON_HOME}/scripts/standalone-post-checkout" ]] \
    || die "template not found: ${RIBBON_HOME}/scripts/standalone-post-checkout (point --ribbon-home at the template repo)"
  validate_seed_version
  validate_template_files
}

#######################################
# Read the seed version: one line 'ribbon N'.
# Globals:
#   RIBBON_HOME
#######################################
validate_seed_version() {
  local version_file="${RIBBON_HOME}/VERSION" line
  [[ -f "${version_file}" && -r "${version_file}" ]] \
    || die "template file is missing or unreadable: ${version_file}"
  line="$(head -1 "${version_file}")"
  if [[ ! "${line}" =~ ^ribbon\ [0-9]+$ ]] \
    || ! cmp -s "${version_file}" <(printf '%s\n' "${line}"); then
    die "invalid Ribbon seed version: ${line}"
  fi
}

#######################################
# Every template file the run will copy is a readable regular file.
# Globals:
#   RIBBON_HOME, RENDER_WORK_DIR
#######################################
validate_template_files() {
  local listing="${RENDER_WORK_DIR}/template-files" file
  if ! find "${RIBBON_HOME}/docs/tasks" "${RIBBON_HOME}/docs/llm-context" \
      "${RIBBON_HOME}/rules" \( -type f -o -type l \) -print0 > "${listing}"; then
    die "cannot inspect the template files under ${RIBBON_HOME}"
  fi
  while IFS= read -r -d '' file; do
    [[ -f "${file}" && -r "${file}" ]] \
      || die "template file is missing or unreadable: ${file}"
  done < "${listing}"
}

#######################################
# Resolve the project repository path for this run. In --update mode with no
# path given, the instance's project-repo pointer is used.
# Globals:
#   UPDATE, INSTANCE, PROJECT_REPO (set), PROJECTS_DIR, PROJECT_NAME
#######################################
resolve_repo() {
  INSTANCE="${PROJECTS_DIR}/${PROJECT_NAME}"
  if (( UPDATE == 1 )); then
    [[ -d "${INSTANCE}" ]] || die "no instance to update: ${INSTANCE}"
    [[ -w "${INSTANCE}" && -x "${INSTANCE}" ]] \
      || die "instance is not writable with your permissions: ${INSTANCE}"
    if [[ -z "${PROJECT_REPO}" ]]; then
      [[ -f "${INSTANCE}/project-repo" ]] \
        || die "no repo path given and ${INSTANCE}/project-repo is missing"
      PROJECT_REPO="$(cat "${INSTANCE}/project-repo")"
    fi
  else
    [[ -n "${PROJECT_REPO}" ]] || die "missing <project-repo-path>"
    if [[ -e "${INSTANCE}" ]]; then
      (( FORCE == 1 )) \
        || die "instance already exists: ${INSTANCE} (re-run with --force to rebuild, or --update to refresh templates)"
      NEEDS_REBUILD=1
    fi
  fi
  [[ -d "${PROJECT_REPO}" ]] || die "project repo not found: ${PROJECT_REPO}"
  [[ -w "${PROJECT_REPO}" && -x "${PROJECT_REPO}" ]] \
    || die "project repo is not writable with your permissions: ${PROJECT_REPO}"
  [[ -f "${PROJECT_REPO}/AGENTS.md" ]] \
    || die "no AGENTS.md in ${PROJECT_REPO}; create one before unpacking"
  [[ -r "${PROJECT_REPO}/AGENTS.md" ]] \
    || die "AGENTS.md is not readable with your permissions: ${PROJECT_REPO}/AGENTS.md"
  [[ -w "${PROJECT_REPO}/AGENTS.md" ]] \
    || die "AGENTS.md is not writable with your permissions: ${PROJECT_REPO}/AGENTS.md"
  if [[ -f "${PROJECT_REPO}/AGENTS.local.md" ]]; then
    [[ -w "${PROJECT_REPO}/AGENTS.local.md" ]] \
      || die "AGENTS.local.md is not writable with your permissions: ${PROJECT_REPO}/AGENTS.local.md"
  fi
  validate_path_characters 'the project repo path' "${PROJECT_REPO}"
  validate_canonical_path 'the project repo path' "${PROJECT_REPO}"
  PROJECT_REPO="$(canonical_path "${PROJECT_REPO}")"
  local instance_resolved ribbon_resolved home_resolved
  instance_resolved="$(canonical_path "${INSTANCE}")"
  ribbon_resolved="$(canonical_path "${RIBBON_HOME}")"
  if [[ "${PROJECT_REPO}" == "${instance_resolved}" || "${PROJECT_REPO}" == "${instance_resolved}"/* \
      || "${instance_resolved}" == "${PROJECT_REPO}"/* ]]; then
    die "project repo and instance path overlap: ${PROJECT_REPO} vs ${INSTANCE}"
  fi
  if [[ "${instance_resolved}" == "${ribbon_resolved}" \
      || "${instance_resolved}" == "${ribbon_resolved}"/* \
      || "${ribbon_resolved}" == "${instance_resolved}"/* ]]; then
    die "refusing to use an instance path that overlaps the template repository: ${INSTANCE}"
  fi
  home_resolved="$(canonical_path "${HOME}")"
  [[ "${instance_resolved}" != "${home_resolved}" ]] \
    || die "refusing to use your home directory as the instance: ${INSTANCE}"
}

#######################################
# Refuse the classic misinstalls — the user's home directory and the template
# repository itself — and, in a terminal, ask for confirmation before any
# write. Non-interactive runs proceed so agents never hang.
# Globals:
#   PROJECT_REPO, RIBBON_HOME, HOME, ASSUME_YES
#######################################
confirm_target() {
  local home_resolved ribbon_resolved
  home_resolved="$(canonical_path "${HOME}")"
  ribbon_resolved="$(canonical_path "${RIBBON_HOME}")"
  [[ "${PROJECT_REPO}" != "${home_resolved}" ]] \
    || die "refusing to install into your home directory: ${PROJECT_REPO}"
  [[ "${PROJECT_REPO}" != "${ribbon_resolved}" ]] \
    || die "refusing to install into the template repository itself: ${PROJECT_REPO}"
  if [[ -t 0 && "${ASSUME_YES}" -eq 0 ]]; then
    local answer
    printf 'About to write Ribbon files into %s. Proceed? [y/N] ' "${PROJECT_REPO}" >&2
    read -r answer || answer=''
    if [[ "${answer}" != "y" && "${answer}" != "Y" ]]; then
      die "aborted"
    fi
  fi
}

#######################################
# Seed or refresh the instance's docs tree. A full install copies everything;
# --update copies only template and schema files, preserving live work.
# Globals:
#   UPDATE, RIBBON_HOME, INSTANCE
#######################################
visit_instance_template_refreshes() {
  local visit="$1" template
  for template in "${RIBBON_HOME}/docs/tasks"/README.md "${RIBBON_HOME}/docs/tasks"/_template.*; do
    [[ -e "${template}" ]] || continue
    "${visit}" "${INSTANCE}/docs/tasks/${template##*/}" "${template}"
  done
  for template in "${RIBBON_HOME}/docs/llm-context"/README.md "${RIBBON_HOME}/docs/llm-context"/_*.md; do
    [[ -e "${template}" ]] || continue
    "${visit}" "${INSTANCE}/docs/llm-context/${template##*/}" "${template}"
  done
}

copy_refreshed_file() {
  cp "$2" "${1%/*}/"
}

unpack_docs() {
  mkdir -p "${INSTANCE}/docs/tasks" "${INSTANCE}/docs/llm-context/history"
  if (( UPDATE == 0 )); then
    cp -R "${RIBBON_HOME}/docs/tasks/." "${INSTANCE}/docs/tasks/"
    cp -R "${RIBBON_HOME}/docs/llm-context/." "${INSTANCE}/docs/llm-context/"
    return
  fi
  visit_instance_template_refreshes copy_refreshed_file
}

#######################################
# Seed missing project themes without replacing any existing entry.
# --update does not restore deliberately removed themes in an established
# rules directory.
# Globals:
#   UPDATE, RIBBON_HOME, PROJECT_REPO
#######################################
visit_project_rule_copies() {
  local visit="$1" template destination
  if (( UPDATE == 1 )) && path_present "${PROJECT_REPO}/rules/README.md"; then
    return 0
  fi
  for template in "${RIBBON_HOME}/rules"/*.md; do
    destination="${PROJECT_REPO}/rules/${template##*/}"
    [[ -e "${template}" ]] || continue
    path_present "${destination}" && continue
    "${visit}" "${destination}" "${template}"
  done
}

seed_rules() {
  mkdir -p "${PROJECT_REPO}/rules"
  visit_project_rule_copies copy_refreshed_file
}

#######################################
# Write stdin to a target through an exclusively created temporary file
# (os.open with O_CREAT|O_EXCL, a random name) in the same directory and
# os.replace, never through the existing inode. The new file keeps the
# mode of the file it replaces, or 0644 for a new one.
# Arguments:
#   The target path.
#######################################
write_through_temp() {
  python3 -c "$(cat <<'PY'
import os
import secrets
import stat
import sys

target = sys.argv[1]
data = sys.stdin.buffer.read()
try:
    mode = stat.S_IMODE(os.stat(target).st_mode)
except FileNotFoundError:
    mode = 0o644
directory = os.path.dirname(target) or "."
temporary = os.path.join(directory, ".ribbon-write-" + secrets.token_hex(12))
fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
try:
    with os.fdopen(fd, "wb") as stream:
        stream.write(data)
        os.fchmod(stream.fileno(), mode)
    os.replace(temporary, target)
    temporary = None
finally:
    if temporary is not None:
        os.unlink(temporary)
PY
)" "$1"
}

#######################################
# Write the instance's docs/README.md with the current template version.
# Globals:
#   RIBBON_HOME, INSTANCE, PROJECT_NAME, PROJECT_REPO
#######################################
write_instance_readme() {
  local version
  version="$(head -1 "${RIBBON_HOME}/VERSION")"
  write_through_temp "${INSTANCE}/docs/README.md" <<EOF
${version}

Standalone Ribbon Protocol instance for ${PROJECT_NAME}.
Linked project repo: ${PROJECT_REPO}
Seeded from: ${RIBBON_HOME} — the field guide is read from there; each seat's files are rendered under ${INSTANCE}/.ribbon/protocol/.
Final artifacts are written into the project repo: ${PROJECT_REPO}/docs/adrs and ${PROJECT_REPO}/docs/diagrams.
EOF
}

#######################################
# Write the one-line project-repo pointer.
# Globals:
#   INSTANCE, PROJECT_REPO
#######################################
write_pointer() {
  printf '%s\n' "${PROJECT_REPO}" | write_through_temp "${INSTANCE}/project-repo"
}

#######################################
# Write the standalone block: appended when preflight found none, or the
# old block's span replaced by the rendering, through a temporary file in
# the project directory and os.replace, keeping the file's mode. The bytes
# outside the block do not change.
# Globals:
#   PROJECT_REPO, BLOCK_MODE, BLOCK_RENDERING_FILE
#######################################
write_block() {
  python3 - "${LOCAL_BLOCK_TARGET}" "${BLOCK_RENDERING_FILE}" \
    "${BLOCK_MODE}" "${START_MARK}" "${END_MARK}" <<'PY'
import os
import stat
import sys
import tempfile

local_md, rendering_file, mode, start, end = sys.argv[1:6]
start = start.encode()
end = end.encode()

with open(rendering_file, "rb") as stream:
    rendering = stream.read()

try:
    with open(local_md, "rb") as stream:
        content = stream.read()
    file_mode = stat.S_IMODE(os.stat(local_md).st_mode)
except FileNotFoundError:
    content = b""
    file_mode = None

block = start + b"\n" + rendering.rstrip() + b"\n" + end + b"\n"

if mode == "append":
    separator = (b"\n" if content.endswith(b"\n") else b"\n\n") if content else b""
    with open(local_md, "ab") as stream:
        stream.write(separator + block)
    sys.exit(0)

def mark_lines(data, mark):
    lines = data.split(b"\n")
    found = []
    for index, line in enumerate(lines):
        if line == mark or (index < len(lines) - 1 and line == mark + b"\r"):
            found.append(index)
    return found, lines

starts, lines = mark_lines(content, start)
ends, _ = mark_lines(content, end)
offsets = []
position = 0
for line in lines:
    offsets.append(position)
    position += len(line) + 1
begin = offsets[starts[0]]
finish = offsets[ends[0]] + len(end)
if content[finish:finish + 1] == b"\r" and content[finish + 1:finish + 2] == b"\n":
    finish += 2
elif content[finish:finish + 1] == b"\n":
    finish += 1
new_content = content[:begin] + block + content[finish:]

fd, temporary = tempfile.mkstemp(dir=os.path.dirname(local_md) or ".")
try:
    with os.fdopen(fd, "wb") as stream:
        stream.write(new_content)
    if file_mode is not None:
        os.chmod(temporary, file_mode)
    os.replace(temporary, local_md)
except BaseException:
    os.unlink(temporary)
    raise
PY
}

#######################################
# Write each rendered seat file under <instance>/.ribbon/protocol/ and
# remove a file there that the template no longer names (the instance is
# the installer's).
# Globals:
#   INSTANCE, SEAT_LIST_FILE, SEAT_RENDER_DIR
#######################################
write_seat_files() {
  local protocol_dir="${INSTANCE}/.ribbon/protocol" path installed
  mkdir -p "${protocol_dir}"
  while IFS=$'\t' read -r path installed; do
    if [[ "${installed}" == */* ]]; then
      mkdir -p "${protocol_dir}/${installed%/*}"
    fi
    write_through_temp "${protocol_dir}/${installed}" \
      < "${SEAT_RENDER_DIR}/${installed}"
  done < "${SEAT_LIST_FILE}"
  while IFS= read -r -d '' path; do
    installed="${path#"${protocol_dir}"/}"
    if ! cut -f2 "${SEAT_LIST_FILE}" | grep -Fqx "${installed}"; then
      rm -f "${path}"
    fi
  done < "${SEAT_SWEEP_FILE}"
}

#######################################
# Add a one-line pointer to AGENTS.local.md in the project AGENTS.md, so
# agents that read only AGENTS.md find the standalone instructions. Does
# nothing when AGENTS.md already references AGENTS.local.md.
# Globals:
#   PROJECT_REPO
#######################################
ensure_pointer() {
  if (( AGENTS_POINTER_NEEDED == 1 )); then
    printf '\n%s\n' "${POINTER_LINE}" \
      >> "${PROJECT_REPO}/AGENTS.md"
  fi
}

#######################################
# Warn about existing Claude files without a direct AGENTS import or link.
#######################################
warn_unlinked_claude_files() {
  local suffix agents claude
  for suffix in .md .local.md; do
    agents="AGENTS${suffix}"
    claude="CLAUDE${suffix}"
    [[ -f "${PROJECT_REPO}/${agents}" && -f "${PROJECT_REPO}/${claude}" ]] || continue
    if [[ -L "${PROJECT_REPO}/${claude}" && "${PROJECT_REPO}/${claude}" -ef "${PROJECT_REPO}/${agents}" ]] \
      || grep -Eq "^@(\./)?${agents//./\\.}[[:space:]]*$" "${PROJECT_REPO}/${claude}" 2>/dev/null; then
      continue
    fi
    printf 'warning: %s does not point to %s; left unchanged\n' "${claude}" "${agents}" >&2
  done
}

#######################################
# Offer the user's machine-global rules (~/.claude/rules) as project themes so
# every engineer gets them. With --import-rules, copies exactly those files.
# In a terminal, shows a multi-select prompt. Otherwise prints a note and
# imports nothing. Existing project themes are never overwritten.
# Globals:
#   HOME, PROJECT_REPO, IMPORT_RULES, IMPORT_NOTE (set)
#######################################
prepare_user_rule_imports() {
  local rules_dir="${HOME}/.claude/rules"
  local -a candidates=()
  local f
  if [[ -d "${rules_dir}" ]]; then
    for f in "${rules_dir}"/*.md; do
      [[ -f "${f}" ]] && candidates+=("$(basename "${f}")")
    done
  fi
  IMPORT_NOTE=''

  if [[ "${#IMPORT_RULES[@]}" -gt 0 ]]; then
    SELECTED_RULES=("${IMPORT_RULES[@]}")
  elif [[ "${#candidates[@]}" -eq 0 ]]; then
    return 0
  elif [[ -t 0 ]]; then
    pick_rules "${candidates[@]}"
    SELECTED_RULES=("${PICKED[@]}")
  else
    printf 'note: %d rule file(s) in %s not imported (not interactive); re-run in a terminal or pass --import-rules\n' \
      "${#candidates[@]}" "${rules_dir}" >&2
    return 0
  fi

  for f in "${SELECTED_RULES[@]}"; do
    [[ -f "${rules_dir}/${f}" ]] || die "--import-rules file not found: ${rules_dir}/${f}"
    path_present "${PROJECT_REPO}/rules/${f}" || validate_refresh_destination "${PROJECT_REPO}/rules/${f}"
  done
}

import_user_rules() {
  [[ "${#SELECTED_RULES[@]}" -gt 0 ]] || return 0
  local rules_dir="${HOME}/.claude/rules" f imported=0 kept=0
  for f in "${SELECTED_RULES[@]}"; do
    if path_present "${PROJECT_REPO}/rules/${f}"; then
      kept=$((kept + 1))
      continue
    fi
    cp "${rules_dir}/${f}" "${PROJECT_REPO}/rules/${f}"
    imported=$((imported + 1))
  done
  IMPORT_NOTE="imported ${imported} user rule file(s) from ${rules_dir}"
  if (( kept > 0 )); then
    IMPORT_NOTE+=" (${kept} already present, kept as-is)"
  fi
}

#######################################
# Interactive multi-select over the candidate rule files. Sets PICKED.
# Arguments:
#   Candidate file names.
# Globals:
#   PICKED (set)
# Outputs:
#   Prompt and menu to STDERR.
#######################################
pick_rules() {
  local -a picked=() options=("$@")
  local input tok opt p mark
  while true; do
    printf '\nImport coding rules from ~/.claude/rules so every engineer gets them?\n' >&2
    local i=1
    for opt in "${options[@]}"; do
      mark=' '
      for p in "${picked[@]}"; do
        [[ "${p}" == "${opt}" ]] && mark='x'
      done
      printf '  [%s] %d) %s\n' "${mark}" "${i}" "${opt}" >&2
      i=$((i + 1))
    done
    printf 'Toggle numbers, [a]ll, [n]one, [d]one: ' >&2
    read -r input || input='d'
    case "${input}" in
      a) picked=("${options[@]}") ;;
      n) picked=() ;;
      d) break ;;
      *[!0-9\ ]*) printf 'Answer with numbers, a, n or d.\n' >&2 ;;
      *)
        local -a toks=()
        read -ra toks <<< "${input}"
        for tok in "${toks[@]}"; do
          if [[ ! "${tok}" =~ ^[0-9]+$ ]] || (( ${#tok} > 9 )); then
            printf 'Not a rule number: %s\n' "${tok}" >&2
            continue
          fi
          local num=$((10#$tok))
          if (( num < 1 || num > ${#options[@]} )); then
            printf 'No rule number %s.\n' "${tok}" >&2
            continue
          fi
          opt="${options[$((num - 1))]}"
          local -a next=()
          local found=0
          for p in "${picked[@]}"; do
            if [[ "${p}" == "${opt}" ]]; then
              found=1
            else
              next+=("${p}")
            fi
          done
          if (( found == 0 )); then
            next+=("${opt}")
          fi
          picked=("${next[@]}")
        done
        ;;
    esac
  done
  PICKED=("${picked[@]}")
}

#######################################
# Pick the post-checkout destination without writing anything. Foreign
# hooks and custom hook paths are left alone.
#######################################
prepare_worktree_hook() {
  WORKTREE_NOTE='post-checkout hook installed — new worktrees get links to the local files'
  local worktrees
  if ! worktrees="$(git -C "${PROJECT_REPO}" worktree list --porcelain 2>/dev/null)"; then
    WORKTREE_NOTE='no git repository — post-checkout hook not installed'
    return 0
  fi
  local main_checkout
  main_checkout="$(printf '%s\n' "${worktrees}" | sed -n '1s/^worktree //p')"
  if [[ "${main_checkout}" != "${PROJECT_REPO}" ]]; then
    WORKTREE_NOTE="not the repository's main worktree — post-checkout hook not installed"
    return 0
  fi
  local hooks_dir common_dir
  if ! hooks_dir="$(git -C "${PROJECT_REPO}" rev-parse --path-format=absolute --git-path hooks)" \
     || ! common_dir="$(git -C "${PROJECT_REPO}" rev-parse --path-format=absolute --git-common-dir)"; then
    WORKTREE_NOTE='git hooks location cannot be resolved — post-checkout hook not installed'
    return 0
  fi
  if [[ "${hooks_dir}" != "${common_dir}/hooks" ]]; then
    WORKTREE_NOTE='core.hooksPath points elsewhere — left as is, post-checkout hook not installed'
    return 0
  fi
  local hook="${hooks_dir}/post-checkout"
  if [[ -e "${hook}" || -L "${hook}" ]]; then
    local mark=''
    mark="$(sed -n '2p' "${hook}" 2>/dev/null || true)"
    if [[ -L "${hook}" || "${mark}" != '# ribbon:standalone:post-checkout' ]]; then
      WORKTREE_NOTE='existing post-checkout hook left unchanged — no ribbon mark'
      return 0
    fi
    WORKTREE_NOTE='post-checkout hook refreshed from the template'
  fi
  validate_refresh_destination "${hook}"
  WORKTREE_HOOK="${hook}"
}

wire_worktree_links() {
  [[ -n "${WORKTREE_HOOK}" ]] || return 0
  local hooks_dir="${WORKTREE_HOOK%/*}"
  if [[ ! -d "${hooks_dir}" ]] && ! mkdir -p "${hooks_dir}"; then
    WORKTREE_NOTE='hooks directory missing and cannot be created — post-checkout hook not installed'
    return 0
  fi
  if [[ ! -w "${hooks_dir}" ]]; then
    WORKTREE_NOTE='hooks directory not writable — post-checkout hook not installed'
    return 0
  fi
  if ! cp "${RIBBON_HOME}/scripts/standalone-post-checkout" "${WORKTREE_HOOK}" 2>/dev/null \
      || ! chmod 0755 "${WORKTREE_HOOK}" 2>/dev/null; then
    WORKTREE_NOTE='post-checkout hook could not be written — left as is'
  fi
}

#######################################
# Resolve the project repo for --uninstall: the instance's project-repo
# pointer when the instance exists (a given path must name the same
# directory), the given path otherwise. The recorded pointer and the
# given path pass validate_canonical_path before any command substitution
# canonicalizes them, so the identity comparison and the assignment lose
# no byte: a path whose real name ends in an LF is refused, never trimmed
# into another directory.
# Globals:
#   PROJECTS_DIR, PROJECT_NAME, PROJECT_REPO (set), INSTANCE (set)
#######################################
resolve_uninstall_repo() {
  INSTANCE="${PROJECTS_DIR}/${PROJECT_NAME}"
  if [[ -d "${INSTANCE}" ]]; then
    local pointer="${INSTANCE}/project-repo" recorded
    if [[ ! -f "${pointer}" || -L "${pointer}" ]]; then
      die "the instance has no usable project-repo pointer; nothing removed"
    fi
    recorded="$(cat "${pointer}")"
    if [[ -z "${recorded}" || "${recorded}" == *$'\n'* ]]; then
      die "the instance has no usable project-repo pointer; nothing removed"
    fi
    validate_path_characters 'the project repo path' "${recorded}"
    validate_canonical_path 'the project repo path' "${recorded}"
    if [[ -n "${PROJECT_REPO}" ]]; then
      validate_path_characters 'the project repo path' "${PROJECT_REPO}"
      validate_canonical_path 'the project repo path' "${PROJECT_REPO}"
      [[ "$(canonical_path "${PROJECT_REPO}")" == "$(canonical_path "${recorded}")" ]] \
        || die "the instance links ${recorded}, not ${PROJECT_REPO}"
    fi
    PROJECT_REPO="${recorded}"
  fi
  [[ -n "${PROJECT_REPO}" ]] \
    || die "no instance for ${PROJECT_NAME}; give the project repo path"
  [[ -d "${PROJECT_REPO}" ]] || die "project repo not found: ${PROJECT_REPO}"
  validate_path_characters 'the project repo path' "${PROJECT_REPO}"
  validate_canonical_path 'the project repo path' "${PROJECT_REPO}"
  PROJECT_REPO="$(canonical_path "${PROJECT_REPO}")"
}

#######################################
# Print the post-checkout hook of the project's git repository, found as
# prepare_worktree_hook finds it; print nothing when there is none to
# consider (no git, not the main worktree, custom hooks path).
# Globals:
#   PROJECT_REPO
#######################################
find_uninstall_hook() {
  local worktrees main_checkout hooks_dir common_dir
  worktrees="$(git -C "${PROJECT_REPO}" worktree list --porcelain 2>/dev/null)" || return 0
  main_checkout="$(printf '%s\n' "${worktrees}" | sed -n '1s/^worktree //p')"
  [[ "${main_checkout}" == "${PROJECT_REPO}" ]] || return 0
  hooks_dir="$(git -C "${PROJECT_REPO}" rev-parse --path-format=absolute --git-path hooks 2>/dev/null)" \
    || return 0
  common_dir="$(git -C "${PROJECT_REPO}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
    || return 0
  [[ "${hooks_dir}" == "${common_dir}/hooks" ]] || return 0
  printf '%s\n' "${hooks_dir}/post-checkout"
}

#######################################
# Preview or remove a standalone install: the block of AGENTS.local.md,
# the pointer line of AGENTS.md and Ribbon's own hook, of either layout.
# The instance and herdr-config.md are never removed. The plan is printed
# first; every item is re-verified before the first write; a rewrite goes
# through a temporary file and os.replace; no link is followed.
# Globals:
#   PROJECT_REPO, INSTANCE, RIBBON_HOME, START_MARK, END_MARK,
#   POINTER_LINE, REMOVE_RIBBON, ASSUME_YES
#######################################
uninstall_standalone() {
  [[ -f "${RIBBON_HOME}/scripts/standalone-post-checkout" ]] \
    || die "template not found: ${RIBBON_HOME}/scripts/standalone-post-checkout (point --ribbon-home at the template repo)"
  local hook_path=''
  hook_path="$(find_uninstall_hook)"
  python3 -c "$(cat <<'PY'
from contextlib import contextmanager
import errno
import os
from pathlib import PurePosixPath
import secrets
import stat
import sys

root, instance, hook_path, hook_template, start, end, pointer = sys.argv[1:8]
apply, yes = sys.argv[8] == "1", sys.argv[9] == "1"
start = start.encode()
end = end.encode()
pointer = pointer.encode()
with open(hook_template, "rb") as stream:
    ribbon2_hook = stream.read()
ribbon1_hook = ribbon2_hook.replace(
    b"AGENTS.local.md ", b"AGENTS.local.md herdr-config.md ", 1)

def refuse(message):
    raise SystemExit(f"ribbon-new-project: {message}")

root_fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)

@contextmanager
def bound_parent(name):
    fd = os.dup(root_fd)
    parts = PurePosixPath(name).parts
    try:
        for component in parts[:-1]:
            child = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                            dir_fd=fd)
            os.close(fd)
            fd = child
        yield fd, parts[-1]
    finally:
        os.close(fd)

def snapshot(name):
    """(stat, bytes) of a regular file; (None, b"") when absent;
    (None, None) when it is not a regular file. No link is followed."""
    try:
        with bound_parent(name) as (fd, leaf):
            before = os.stat(leaf, dir_fd=fd, follow_symlinks=False)
            if not stat.S_ISREG(before.st_mode):
                return None, None
            with os.fdopen(os.open(leaf, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=fd),
                           "rb") as stream:
                current = os.fstat(stream.fileno())
                if (current.st_dev, current.st_ino) != (before.st_dev, before.st_ino):
                    raise OSError(f"path changed during uninstall: {name}")
                return before, stream.read()
    except FileNotFoundError:
        return None, b""
    except OSError as error:
        if error.errno in (errno.ELOOP, errno.ENOTDIR):
            return None, None
        raise

def same_file(first, second):
    return (first.st_dev, first.st_ino) == (second.st_dev, second.st_ino)

def replace_file(fd, leaf, replacement, mode):
    temporary = ".ribbon-uninstall-" + secrets.token_hex(12)
    temp_fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600,
                      dir_fd=fd)
    try:
        with os.fdopen(temp_fd, "wb") as stream:
            stream.write(replacement)
            os.fchmod(stream.fileno(), stat.S_IMODE(mode))
        os.replace(temporary, leaf, src_dir_fd=fd, dst_dir_fd=fd)
        temporary = None
    finally:
        if temporary is not None:
            os.unlink(temporary, dir_fd=fd)

def mark_lines(data, mark):
    """The indices of the lines that are exactly mark, ending in LF, in
    CR LF, or at the end of the file; a mark's text inside a line is no
    mark, and a trailing CR counts only before an LF."""
    lines = data.split(b"\n")
    found = []
    for index, line in enumerate(lines):
        if line == mark or (index < len(lines) - 1 and line == mark + b"\r"):
            found.append(index)
    return found, lines

def block_removal(content):
    """AGENTS.local.md without the standalone block (and the blank line
    before it), or None when the file has no block."""
    starts, lines = mark_lines(content, start)
    ends, _ = mark_lines(content, end)
    if not starts and not ends:
        return None
    if len(starts) != 1 or len(ends) != 1 or starts[0] >= ends[0]:
        refuse("AGENTS.local.md has unclosed, duplicated or out-of-order "
               "Ribbon markers; nothing removed")
    offsets = []
    position = 0
    for line in lines:
        offsets.append(position)
        position += len(line) + 1
    line_start = offsets[starts[0]]
    line_end = offsets[ends[0]] + len(end)
    if content[line_end:line_end + 1] == b"\r" and content[line_end + 1:line_end + 2] == b"\n":
        line_end += 2
    elif content[line_end:line_end + 1] == b"\n":
        line_end += 1
    if line_start > 0:
        prev_end = line_start - 1
        prev_start = content.rfind(b"\n", 0, prev_end) + 1
        if content[prev_start:prev_end] in (b"", b"\r"):
            line_start = prev_start
    return content[:line_start] + content[line_end:]

def pointer_removal(content):
    """AGENTS.md without each pointer line (and the blank line before it),
    or None when there is no pointer line. The pointer line and the blank
    line before it are recognized with LF or CR LF endings."""
    out = []
    removed = False
    for line in content.splitlines(keepends=True):
        body = line
        if body.endswith(b"\n"):
            body = body[:-1]
            if body.endswith(b"\r"):
                body = body[:-1]
        if body == pointer:
            removed = True
            if out and out[-1] in (b"\n", b"\r\n"):
                out.pop()
            continue
        out.append(line)
    return b"".join(out) if removed else None

def uninstall():
    plan = []
    left = []

    local_stat, local_content = snapshot("AGENTS.local.md")
    if local_stat is None and local_content is None:
        refuse("not a regular file: AGENTS.local.md; nothing removed")
    if local_stat is not None:
        remaining = block_removal(local_content)
        if remaining is not None:
            if remaining.strip() == b"":
                plan.append(("AGENTS.local.md", "AGENTS.local.md",
                             local_stat, local_content, None))
            else:
                plan.append(("AGENTS.local.md (Ribbon block only)",
                             "AGENTS.local.md", local_stat, local_content,
                             remaining))

    agents_stat, agents_content = snapshot("AGENTS.md")
    if agents_stat is None and agents_content is None:
        refuse("not a regular file: AGENTS.md; nothing removed")
    if agents_stat is not None:
        remaining = pointer_removal(agents_content)
        if remaining is not None:
            plan.append(("AGENTS.md (Ribbon pointer line only)", "AGENTS.md",
                         agents_stat, agents_content, remaining))

    if os.path.lexists(os.path.join(root, "herdr-config.md")):
        left.append("herdr-config.md (Ribbon cannot prove it wrote it)")

    if hook_path:
        relative = os.path.relpath(hook_path, root)
        hook_stat, hook_content = (None, None)
        if not relative.startswith(".."):
            hook_stat, hook_content = snapshot(relative)
        hook_lines = (hook_content or b"").split(b"\n")
        second_line = hook_lines[1] if len(hook_lines) > 1 else b""
        if (hook_stat is not None
                and second_line == b"# ribbon:standalone:post-checkout"
                and hook_content in (ribbon2_hook, ribbon1_hook)):
            plan.append((hook_path, relative, hook_stat, hook_content, None))
        elif os.path.lexists(hook_path):
            left.append(f"{hook_path} (not Ribbon's hook)")

    print("Would remove Ribbon-owned blocks, lines and files:")
    for label, _, _, _, _ in plan:
        print(f"  {label}")
    print("Left in place:")
    print(f"  {instance} (the instance: its plans, cards and reports)")
    for label in left:
        print(f"  {label}")

    if not apply:
        print("Dry run only; use --uninstall --remove-ribbon to apply.")
        return
    if not yes:
        if not sys.stdin.isatty():
            refuse("non-interactive removal requires --yes; nothing removed")
        print("Remove these Ribbon blocks and files? [y/N] ", end="",
              file=sys.stderr, flush=True)
        if input().strip().lower() not in ("y", "yes"):
            print("Uninstall declined; nothing removed.")
            return

    for label, name, original, content, replacement in plan:
        path = os.path.join(root, name)
        if not os.access(os.path.dirname(path) or root, os.W_OK | os.X_OK) or (
                replacement is not None and not os.access(path, os.W_OK)):
            refuse(f"permission denied: {label}; nothing removed")
    for label, name, original, content, _ in plan:
        now, current = snapshot(name)
        if now is None or not same_file(original, now) or current != content:
            refuse(f"path changed since preview: {label}; nothing removed")
    for label, name, original, content, replacement in plan:
        with bound_parent(name) as (fd, leaf):
            now, current = snapshot(name)
            if now is None or not same_file(original, now) or current != content:
                refuse(f"path changed since preview: {label}; nothing removed")
            if replacement is None:
                os.unlink(leaf, dir_fd=fd)
            else:
                replace_file(fd, leaf, replacement, now.st_mode)
    print(f"Standalone removal complete. The instance stays: {instance}.")

try:
    try:
        uninstall()
    finally:
        os.close(root_fd)
except (OSError, EOFError) as error:
    refuse(f"uninstall stopped: {error}")
PY
)" "${PROJECT_REPO}" "${INSTANCE}" "${hook_path}" \
  "${RIBBON_HOME}/scripts/standalone-post-checkout" \
  "${START_MARK}" "${END_MARK}" "${POINTER_LINE}" \
  "${REMOVE_RIBBON}" "${ASSUME_YES}"
}

#######################################
# Print a summary of what happened.
# Globals:
#   UPDATE, INSTANCE, PROJECT_NAME, PROJECT_REPO, BLOCK_MODE,
#   AGENTS_POINTER_NEEDED, WORKTREE_NOTE
#######################################
print_summary() {
  local mode='Unpacked'
  local local_note='existing standalone block replaced, roster and gate kept'
  local pointer_note='existing reference left unchanged'
  (( UPDATE == 1 )) && mode='Updated'
  [[ "${BLOCK_MODE}" == append ]] && local_note='standalone block appended'
  (( AGENTS_POINTER_NEEDED == 1 )) && pointer_note='one-line pointer appended (see AGENTS.local.md)'
  local import_line=''
  if [[ -n "${IMPORT_NOTE}" ]]; then
    import_line="  user rules:      ${IMPORT_NOTE}
"
  fi
  cat <<EOF
${mode} Ribbon Protocol instance for ${PROJECT_NAME}:

  instance:        ${INSTANCE}
  working files:   ${INSTANCE}/docs/tasks, ${INSTANCE}/docs/llm-context
  project repo:    ${PROJECT_REPO}
  artifacts go to: ${PROJECT_REPO}/docs/adrs, ${PROJECT_REPO}/docs/diagrams
  AGENTS.local.md: ${local_note}
  AGENTS.md:       ${pointer_note}
  rules:           existing project themes left unchanged; missing themes added when seeding
${import_line}  gitignore:       add AGENTS.local.md — it is personal to this machine
  herdr:           the overlay is the architect's seat file, handlers/herdr.md
  worktrees:       ${WORKTREE_NOTE}

Next: fill the roster and the gate in AGENTS.local.md, between their ribbon:belt and ribbon:gate marks.
EOF
}

#######################################
# Entry point: validate, resolve, unpack, wire, report.
# Arguments:
#   The raw command line.
#######################################
main() {
  parse_args "$@"
  validate_flags
  find_gnu_realpath
  validate_canonical_path 'the template repository' "${RIBBON_HOME}"
  RIBBON_HOME="$(canonical_path "${RIBBON_HOME}")"
  validate_import_rules
  validate_projects_dir
  RENDER_WORK_DIR="$(mktemp -d)"
  OLD_BLOCK_FILE="${RENDER_WORK_DIR}/old-block"
  BELT_ROWS_FILE="${RENDER_WORK_DIR}/belt-rows"
  BLOCK_RENDERING_FILE="${RENDER_WORK_DIR}/block-rendering"
  SEAT_LIST_FILE="${RENDER_WORK_DIR}/seat-list"
  SEAT_RENDER_DIR="${RENDER_WORK_DIR}/seats"
  RENDER_ERROR_FILE="${RENDER_WORK_DIR}/renderer-stderr"
  SEAT_SWEEP_FILE="${RENDER_WORK_DIR}/seat-sweep"
  mkdir -p "${SEAT_RENDER_DIR}"
  : > "${SEAT_SWEEP_FILE}"
  if (( UNINSTALL == 1 )); then
    resolve_uninstall_repo
    uninstall_standalone
    return
  fi
  validate_template
  resolve_repo
  refuse_full_install
  validate_project_rules_directory
  validate_instance_write_directories
  collect_existing_project_docs_and_rules
  validate_instance_seed_instruction_links
  prepare_instruction_files
  render_the_protocol
  validate_block_seat_pointers
  validate_update_instruction_aliases
  prepare_seat_sweep
  if ! path_present "${PROJECT_REPO}/rules"; then
    validate_refresh_destination "${PROJECT_REPO}/rules"
  fi
  visit_project_rule_copies validate_refresh_destination
  validate_instruction_link_safety
  prepare_worktree_hook
  confirm_target
  prepare_user_rule_imports
  validate_write_destinations
  rebuild_instance
  unpack_docs
  write_instance_readme
  write_pointer
  write_block
  write_seat_files
  ensure_pointer
  seed_rules
  import_user_rules
  wire_worktree_links
  print_summary
  warn_unlinked_claude_files
}

main "$@"
