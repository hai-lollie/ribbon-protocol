#!/usr/bin/env bash
# ribbon-seed-project — the full install: seed a project repository with the
# Ribbon Protocol, committed for every collaborator and agent.
#
# Usage: scripts/ribbon-seed-project [--ribbon-home DIR] [--yes]
#     [--import-rules F]... <project-repo-path>
#
# Seeds missing project docs and rules, writes a separate full-install
# record, renders the protocol's block of a full install into the project's
# AGENTS.md (or creates one), and writes each seat's own file under
# .ribbon/protocol/. Leaves Claude instruction files untouched and commits
# as "Seed the Ribbon Protocol, ribbon N".
#
# An already-seeded project that predates rules/ gets a rules-only amendment
# instead of a refusal. With --import-rules F (repeatable), copies F from
# ~/.claude/rules into the project's rules/ so every engineer gets the user's
# conventions; in a terminal the script offers a multi-select picker.
#
# --ribbon-home DIR points at the template checkout; it defaults to the
# repository containing this script, so a clone at ~/ribbon-protocol needs
# no flags.

# macOS ships bash 3.2 as /bin/bash. Before 4.4, `set -u` treats an empty
# array as unbound, and this script expands empty arrays on purpose.
if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4) )); then
  printf 'ribbon-seed-project: needs bash 4.4 or newer, not %s; on macOS: brew install bash\n' \
    "${BASH_VERSION}" >&2
  exit 1
fi

set -euo pipefail

readonly START_MARK='<!-- ribbon:full-install:start -->'
readonly END_MARK='<!-- ribbon:full-install:end -->'
readonly SEED_RECORD='docs/.ribbon-full-install'
readonly INSTALL_RECEIPT='docs/.ribbon-full-install-receipt'
readonly SEED_STAMP_PATTERN='Seeded from the Ribbon Protocol, ribbon [0-9]+\.'

# State set by parse_args and consumed by the pipeline below.
RIBBON_HOME=''
PROJECT_REPO=''
COMMIT_NOTE=''
IMPORT_NOTE=''
IMPORT_RULES=()
AMEND=0
ASSUME_YES=0
UNINSTALL=0
REMOVE_RIBBON=0
UPDATE=0
UPDATE_CHANGED=0
UPDATED_SEATS=0
REMOVED_SEAT_COUNT=0
OLD_BLOCK_FILE=''
BLOCK_KEEP_FROM=''
RECORDED_DOCS=()
RECORDED_SEATS=()
REMOVED_SEAT_PATHS=()
UPDATE_BLOCK_KIND=''
UPDATED_PATHS=()
WRITTEN_PATHS=()
OWNED_INSTALL_FILES=()
AGENTS_BLOCK_KIND=''
AGENTS_BLOCK_DIGEST=''
DOC_SEEDS=()
SELECTED_RULES=()
PLANNED_RULE_PATHS=()
SEAT_PATHS=()
SEAT_FILES=()
SEAT_RENDERS=()
RENDER_DIR=''
BLOCK_FILE=''
SEAT_LIST_FILE=''
SEED_VERSION=''
EXISTING_PROJECT_DOCS_AND_RULES=()
GNU_REALPATH=''

#######################################
# Print an error message to STDERR and exit.
# Arguments:
#   Message text.
# Outputs:
#   Writes to STDERR.
#######################################
die() {
  printf 'ribbon-seed-project: %s\n' "$*" >&2
  exit 1
}

#######################################
# Print usage to STDOUT.
# Outputs:
#   Writes to STDOUT.
#######################################
usage() {
  cat <<'EOF'
Usage:
  scripts/ribbon-seed-project [--ribbon-home DIR] [--yes] [--import-rules F]... \
      <project-repo-path>
  scripts/ribbon-seed-project --update [--ribbon-home DIR] [--yes] <project-repo-path>
  scripts/ribbon-seed-project --uninstall [--remove-ribbon] [--yes] <project-repo-path>

The full install: seeds a project repository with the Ribbon Protocol and
commits it for every collaborator. A project seeded before rules/ existed
gets a rules-only amendment instead of a refusal.

Options:
  --ribbon-home DIR  The template checkout. Default: the repository that
                     contains this script (~/ribbon-protocol when cloned
                     there).
  --import-rules F   Copy F from ~/.claude/rules into the project's rules/.
                     One file name per occurrence; repeat the flag for more.
                     Unknown names and paths containing / fail the run before
                     anything is written. Default in a terminal: a
                     multi-select picker offers the files. Non-interactive
                     runs skip with a note and never hang.
  --update           Render the block and the seat files again; keep the roster and the gate.
  --uninstall        Preview removal of a recorded full install; no writes by default.
  --remove-ribbon    Apply the uninstall plan after confirmation; requires --uninstall.
  --yes              Skip confirmation; required for non-interactive removal.
  -h, --help         Show this help and exit.

Examples:
  # seed the project in the current directory (run from the project root)
  scripts/ribbon-seed-project .

  # seed a project somewhere else
  scripts/ribbon-seed-project ~/dev/my-app

  # seed and import your own conventions without the picker
  scripts/ribbon-seed-project ~/dev/my-app \
      --import-rules xunit-patterns.md --import-rules clojure-preferences.md
EOF
}

#######################################
# Validate every --import-rules file before any mutating step, so a typo
# fails fast instead of halfway through an install.
# Globals:
#   HOME, IMPORT_RULES
#######################################
validate_import_rules() {
  [[ "${#IMPORT_RULES[@]}" -gt 0 ]] || return 0
  local f
  for f in "${IMPORT_RULES[@]}"; do
    [[ "${f}" != */* ]] || die "--import-rules takes file names, not paths: ${f}"
    [[ -f "${HOME}/.claude/rules/${f}" ]] \
      || die "--import-rules file not found: ${HOME}/.claude/rules/${f}"
  done
}

#######################################
# Parse the command line into the state globals.
# Globals:
#   RIBBON_HOME, PROJECT_REPO
# Arguments:
#   The raw command line.
#######################################
parse_args() {
  local ribbon_home_override=''
  local -a positional=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --ribbon-home) shift; ribbon_home_override="${1:-}"; shift ;;
      --yes) ASSUME_YES=1; shift ;;
      --uninstall) UNINSTALL=1; shift ;;
      --update) UPDATE=1; shift ;;
      --remove-ribbon) REMOVE_RIBBON=1; shift ;;
      --import-rules)
        shift
        [[ $# -gt 0 && -n "$1" && "$1" != --* ]] \
          || die "--import-rules takes exactly one file name (repeat the flag for more)"
        IMPORT_RULES+=("$1")
        shift
        ;;
      -h|--help) usage; exit 0 ;;
      *) positional+=("$1"); shift ;;
    esac
  done
  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  RIBBON_HOME="${ribbon_home_override:-$(cd "${script_dir}/.." && pwd)}"
  PROJECT_REPO="${positional[0]:-}"
  [[ "${#positional[@]}" -le 1 ]] \
    || die "unexpected extra arguments: ${positional[*]:1}"
}

path_present() {
  [[ -e "$1" || -L "$1" ]]
}

#######################################
# Refuse a project repo path that holds a character below U+0020 or
# U+007F: a canonicalization could trim it into another pathname.
# Arguments:
#   What the path is, the path.
#######################################
validate_path_characters() {
  python3 - "$1" "$2" <<'PY'
import sys

what, path = sys.argv[1:3]
if any(ord(char) < 0x20 or ord(char) == 0x7F for char in path):
    escaped = "".join(
        "\\x%02x" % ord(char) if ord(char) < 0x20 or ord(char) == 0x7F else char
        for char in path)
    sys.exit(f"ribbon-seed-project: unsupported character in {what}: {escaped}")
PY
}

file_digest() {
  local checksum
  checksum="$(sha256sum)" || return 1
  printf '%s\n' "${checksum%% *}"
}

record_owned_doc() {
  local rel="$1" name="${1##*/}"
  case "${rel}" in
    docs/README.md|docs/field-guide.md|docs/tasks/README.md|docs/llm-context/README.md)
      OWNED_INSTALL_FILES+=("${rel}") ;;
    *)
      if [[ "${rel%/*}" == docs/tasks && "${name}" == _template.* ]] \
        || [[ "${rel%/*}" == docs/llm-context && "${name}" == _*.md ]]; then
        OWNED_INSTALL_FILES+=("${rel}")
      fi ;;
  esac
}

# A planned write may use only real project directories, never a link or
# another entry where a directory is needed.
validate_project_directory() {
  local directory="${PROJECT_REPO}/$1"
  while [[ "${directory}" != "${PROJECT_REPO}" ]]; do
    if [[ -L "${directory}" ]] || { [[ -e "${directory}" ]] && [[ ! -d "${directory}" ]]; }; then
      die "unsafe project directory: ${directory}"
    fi
    directory="${directory%/*}"
  done
}

collect_existing_project_docs_and_rules() {
  local name path listing
  local -a roots=()
  for name in docs rules; do
    path="${PROJECT_REPO}/${name}"
    [[ ! -d "${path}" ]] || roots+=("${path}")
  done
  (( ${#roots[@]} > 0 )) || return 0
  listing="$(mktemp)"
  if ! find "${roots[@]}" \( -type f -o -type l \) -print0 > "${listing}"; then
    rm -f "${listing}"
    die "cannot inspect existing project docs and rules"
  fi
  while IFS= read -r -d '' path; do
    EXISTING_PROJECT_DOCS_AND_RULES+=("${path}")
  done < "${listing}"
  rm -f "${listing}"
  for path in "${EXISTING_PROJECT_DOCS_AND_RULES[@]}"; do
    if [[ -L "${path}" && -d "${path}" ]]; then
      die "unsafe project directory link: ${path}"
    fi
  done
}

#######################################
# Find GNU realpath, whose -m resolves a path that does not exist yet: the
# system's realpath on Linux, Homebrew coreutils' grealpath on macOS, whose
# own realpath has no -m (and none at all before macOS 13).
# Globals:
#   GNU_REALPATH (set)
#######################################
find_gnu_realpath() {
  local candidate
  for candidate in realpath grealpath; do
    if "${candidate}" -m -- / >/dev/null 2>&1; then
      GNU_REALPATH="${candidate}"
      return 0
    fi
  done
  die "needs GNU realpath to resolve paths that do not exist yet; on macOS: brew install coreutils"
}

#######################################
# Print the canonical form of a path: every link followed, `.` and `..`
# folded, and components that do not exist yet kept as written.
# Globals:
#   GNU_REALPATH
# Arguments:
#   A path.
# Outputs:
#   The canonical path on STDOUT.
#######################################
canonical_path() {
  "${GNU_REALPATH}" -m -- "$1"
}

# Walk the link without dropping missing components canceled by `..`.
missing_link_component_matches_write() {
  local pending="$1" destination="$2" parent='' component entry target hops=0
  while [[ -n "${pending}" ]]; do
    component="${pending%%/*}"
    if [[ "${pending}" == */* ]]; then pending="${pending#*/}"; else pending=''; fi
    case "${component}" in
      ''|.) continue ;;
      ..) parent="${parent%/*}"; continue ;;
    esac
    entry="${parent}/${component}"
    if [[ -L "${entry}" ]]; then
      if (( ++hops > 40 )); then return 1; fi
      target="$(readlink -n -- "${entry}" && printf /)" || die "cannot read project link: ${entry}"
      if [[ "${target}" == /* ]]; then parent=''; fi
      pending="${target}${pending}"
    else
      if [[ ! -e "${entry}" && ( "${destination}" == "${entry}" || "${destination}" == "${entry}/"* ) ]]; then
        return 0
      fi
      parent="${entry}"
    fi
  done
  return 1
}

validate_existing_project_paths() {
  local destination="$1" path resolved_destination='' target
  for path in "${EXISTING_PROJECT_DOCS_AND_RULES[@]}"; do
    if [[ ! "${destination}" -ef "${path}" ]]; then
      [[ -L "${path}" ]] || continue
      if [[ -z "${resolved_destination}" ]]; then
        resolved_destination="$(canonical_path "${destination}")"
      fi
      target="$(canonical_path "${path}")"
      if [[ "${resolved_destination}" != "${target}" && "${resolved_destination}" != "${target%/}/"* ]] \
        && { [[ -e "${path}" ]] || ! missing_link_component_matches_write "${path}" "${resolved_destination}"; }; then
        continue
      fi
    fi
    die "${destination} would change existing project path: ${path#"${PROJECT_REPO}"/}"
  done
}

#######################################
# Validate inputs and resolve the project repository path.
# Globals:
#   RIBBON_HOME, PROJECT_REPO (set)
#######################################
resolve_repo() {
  [[ -n "${PROJECT_REPO}" ]] || { usage; die "missing <project-repo-path>"; }
  [[ -d "${RIBBON_HOME}/docs" && -d "${RIBBON_HOME}/rules" \
    && -f "${RIBBON_HOME}/protocol/project-structure.md" \
    && -x "${RIBBON_HOME}/scripts/ribbon-render-protocol" ]] \
    || die "template not found under ${RIBBON_HOME} (point --ribbon-home at the template repo)"
  [[ -d "${PROJECT_REPO}" ]] || die "project repo not found: ${PROJECT_REPO}"
  [[ -w "${PROJECT_REPO}" && -x "${PROJECT_REPO}" ]] \
    || die "project repo is not writable with your permissions: ${PROJECT_REPO}"
  validate_path_characters 'the project repo path' "${PROJECT_REPO}"
  PROJECT_REPO="$(canonical_path "${PROJECT_REPO}")"
  validate_project_directory docs
  validate_project_directory rules

  local record="${PROJECT_REPO}/${SEED_RECORD}" readme="${PROJECT_REPO}/docs/README.md"
  if path_present "${record}"; then
    if [[ -f "${record}" && ! -L "${record}" ]] && grep -qxE "${SEED_STAMP_PATTERN}" "${record}"; then
      die "${PROJECT_REPO} is already full-installed (merge template changes by hand)"
    fi
    die "reserved seed record already exists: ${record}; left untouched"
  fi

  AMEND=0
  if [[ -f "${readme}" && ! -L "${readme}" ]] \
    && head -1 "${readme}" | grep -qxE "${SEED_STAMP_PATTERN}"; then
    if path_present "${PROJECT_REPO}/rules/README.md"; then
      die "${PROJECT_REPO} is already full-installed (merge template changes by hand)"
    fi
    AMEND=1
  fi
}

#######################################
# Refuse the classic misinstalls — the user's home directory and the template
# repository itself — and, in a terminal, ask for confirmation before any
# write. Non-interactive runs proceed so agents never hang.
# Globals:
#   PROJECT_REPO, RIBBON_HOME, HOME, ASSUME_YES
#######################################
confirm_target() {
  local home_resolved ribbon_resolved
  home_resolved="$(canonical_path "${HOME}")"
  ribbon_resolved="$(canonical_path "${RIBBON_HOME}")"
  [[ "${PROJECT_REPO}" != "${home_resolved}" ]] \
    || die "refusing to seed your home directory: ${PROJECT_REPO}"
  [[ "${PROJECT_REPO}" != "${ribbon_resolved}" ]] \
    || die "refusing to seed the template repository itself: ${PROJECT_REPO}"
  if [[ -t 0 && "${ASSUME_YES}" -eq 0 ]]; then
    local answer
    printf 'About to write Ribbon files into %s. Proceed? [y/N] ' "${PROJECT_REPO}" >&2
    read -r answer || answer=''
    if [[ "${answer}" != "y" && "${answer}" != "Y" ]]; then
      die "aborted"
    fi
  fi
}

#######################################
# Plan only missing template paths; an occupied entry belongs to the project.
# Globals:
#   RIBBON_HOME, PROJECT_REPO
#######################################
prepare_doc_seeds() {
  local raw_list f rel
  local -a missing=()
  raw_list="$(mktemp)"
  if ! find "${RIBBON_HOME}/docs" -type f -print0 2>/dev/null | sort -z > "${raw_list}"; then
    rm -f "${raw_list}"
    die "cannot enumerate ${RIBBON_HOME}/docs (check permissions); nothing was copied or committed"
  fi
  while IFS= read -r -d '' f; do
    rel="${f#"${RIBBON_HOME}"/}"
    [[ "${rel}" != "${SEED_RECORD}" && "${rel}" != "${INSTALL_RECEIPT}" ]] || continue
    DOC_SEEDS+=("${rel}")
  done < "${raw_list}"
  rm -f "${raw_list}"
  for rel in "${DOC_SEEDS[@]}"; do
    validate_project_directory "${rel%/*}"
    path_present "${PROJECT_REPO}/${rel}" && continue
    validate_instruction_destination "${rel}"
    missing+=("${rel}")
  done
  DOC_SEEDS=("${missing[@]}")
}

seed_docs() {
  local rel destination
  for rel in "${DOC_SEEDS[@]}"; do
    destination="${PROJECT_REPO}/${rel}"
    mkdir -p "${destination%/*}"
    if [[ "${rel}" == docs/README.md ]]; then
      (set -o noclobber; sed "1s|<ribbon-version>|${SEED_VERSION}|" "${RIBBON_HOME}/${rel}" > "${destination}")
    else
      cp "${RIBBON_HOME}/${rel}" "${destination}"
    fi
    WRITTEN_PATHS+=("${rel}")
    record_owned_doc "${rel}"
  done
}

write_seed_record() {
  mkdir -p "${PROJECT_REPO}/docs"
  (set -o noclobber; printf 'Seeded from the Ribbon Protocol, %s.\n' "${SEED_VERSION}" > "${PROJECT_REPO}/${SEED_RECORD}")
  WRITTEN_PATHS+=("${SEED_RECORD}")
}

prepare_seed_record() {
  local rel
  for rel in "${SEED_RECORD}" "${INSTALL_RECEIPT}"; do
    if path_present "${PROJECT_REPO}/${rel}"; then
      die "reserved install metadata already exists: ${rel}"
    fi
    validate_instruction_destination "${rel}"
    if git -C "${PROJECT_REPO}" check-ignore -q -- "${rel}" 2>/dev/null; then
      die "seed record is ignored by Git: ${rel}; allow it before installing"
    fi
  done
}

write_install_receipt() {
  local rel digest
  (
    set -o noclobber
    {
      printf 'ribbon-full-install-receipt-v2\0'
      for rel in "${OWNED_INSTALL_FILES[@]}"; do
        digest="$(file_digest < "${PROJECT_REPO}/${rel}")"
        printf 'file\0%s\0%s\0' "${rel}" "${digest}"
      done
      for rel in "${SEAT_FILES[@]}"; do
        digest="$(file_digest < "${PROJECT_REPO}/${rel}")"
        printf 'file\0%s\0%s\0' "${rel}" "${digest}"
      done
      printf '%s\0AGENTS.md\0%s\0' "${AGENTS_BLOCK_KIND}" "${AGENTS_BLOCK_DIGEST}"
      digest="$(file_digest < "${PROJECT_REPO}/${SEED_RECORD}")"
      printf 'file\0%s\0%s\0' "${SEED_RECORD}" "${digest}"
    } > "${PROJECT_REPO}/${INSTALL_RECEIPT}"
  )
  WRITTEN_PATHS+=("${INSTALL_RECEIPT}")
}

uninstall_full_install() {
  [[ -n "${PROJECT_REPO}" && -d "${PROJECT_REPO}" ]] || die "uninstall requires an existing project directory"
  local home_resolved ribbon_resolved
  validate_path_characters 'the project repo path' "${PROJECT_REPO}"
  PROJECT_REPO="$(canonical_path "${PROJECT_REPO}")"
  home_resolved="$(canonical_path "${HOME}")"
  ribbon_resolved="$(canonical_path "${RIBBON_HOME}")"
  [[ "${PROJECT_REPO}" != / && "${PROJECT_REPO}" != "${home_resolved}" \
    && "${PROJECT_REPO}" != "${ribbon_resolved}" ]] \
    || die "refusing to uninstall from the filesystem root, home, or template repository"
  python3 -c "$(cat <<'PY'
from contextlib import contextmanager
import errno
import hashlib
import os
from pathlib import Path, PurePosixPath
import re
import secrets
import stat
import sys

root = Path(sys.argv[1])
receipt, marker, start, end = sys.argv[2:6]
apply, yes = (flag == "1" for flag in sys.argv[6:8])
start = start.encode()
end = end.encode()

def refuse(message):
    raise SystemExit(f"ribbon-seed-project: {message}")

def permitted(name, version):
    path = PurePosixPath(name)
    if path.as_posix() != name or path.is_absolute() or ".." in path.parts:
        return False
    if name in {"AGENTS.md", "herdr-config.md", marker, "docs/README.md",
                "docs/field-guide.md", "docs/tasks/README.md", "docs/llm-context/README.md"}:
        return True
    if (str(path.parent) == "docs/tasks" and path.name.startswith("_template.")) or (
            str(path.parent) == "docs/llm-context" and path.name.startswith("_")
            and path.suffix == ".md"):
        return True
    return (version >= 2 and len(path.parts) >= 3
            and path.parts[0] == ".ribbon" and path.parts[1] == "protocol"
            and name.endswith(".md"))

@contextmanager
def bound_parent(name):
    fd = os.dup(root_fd)
    parts = PurePosixPath(name).parts
    try:
        for component in parts[:-1]:
            child = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = child
        yield fd, parts[-1]
    finally:
        os.close(fd)

def snapshot_at(fd, leaf, name):
    before = os.stat(leaf, dir_fd=fd, follow_symlinks=False)
    if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1:
        return None, None
    with os.fdopen(os.open(leaf, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=fd), "rb") as stream:
        current = os.fstat(stream.fileno())
        if not same_inode(current, before) or current.st_nlink != 1:
            raise OSError(f"path changed during uninstall: {name}")
        return before, stream.read()

def snapshot(name):
    try:
        with bound_parent(name) as (fd, leaf):
            return snapshot_at(fd, leaf, name)
    except FileNotFoundError:
        return None, b""
    except PermissionError as error:
        raise PermissionError(error.errno, error.strerror, name) from error
    except OSError as error:
        if error.errno in (errno.ELOOP, errno.ENOTDIR):
            return None, None
        raise

def same_inode(first, second):
    return (first.st_dev, first.st_ino) == (second.st_dev, second.st_ino)

def replace_block(fd, leaf, replacement, mode):
    temporary = ".ribbon-agents-" + secrets.token_hex(12)
    temp_fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600, dir_fd=fd)
    try:
        with os.fdopen(temp_fd, "wb") as stream:
            stream.write(replacement)
            os.fchmod(stream.fileno(), stat.S_IMODE(mode))
        os.replace(temporary, leaf, src_dir_fd=fd, dst_dir_fd=fd)
        temporary = None
    finally:
        if temporary is not None:
            os.unlink(temporary, dir_fd=fd)

def display(name):
    return name if name.isprintable() else repr(name)

def normalized_block(data):
    """Remove the body of each belt and gate region, keeping both mark lines."""
    belt_start = b"<!-- ribbon:belt:start -->"
    belt_end = b"<!-- ribbon:belt:end -->"
    gate_start = b"<!-- ribbon:gate:start -->"
    gate_end = b"<!-- ribbon:gate:end -->"
    result = []
    region_end = None
    lines = data.split(b"\n")
    for index, body in enumerate(lines):
        line = body if index == len(lines) - 1 else body + b"\n"
        comparison = body[:-1] if body.endswith(b"\r") else body
        if region_end is not None:
            if comparison == region_end:
                result.append(line)
                region_end = None
            continue
        if comparison == belt_start:
            result.append(line)
            region_end = belt_end
        elif comparison == gate_start:
            result.append(line)
            region_end = gate_end
        else:
            result.append(line)
    return b"".join(result)

def unchanged_block(data):
    lines = data.split(b"\n")
    offsets = []
    position = 0
    for line in lines:
        offsets.append(position)
        position += len(line) + 1
    starts = [index for index, line in enumerate(lines)
              if line == start or line == start + b"\r"]
    ends = [index for index, line in enumerate(lines)
            if line == end or line == end + b"\r"]
    if len(starts) != 1 or len(ends) != 1 or starts[0] >= ends[0]:
        return None, None
    lo = offsets[starts[0]]
    if lo > 0 and data[lo - 1:lo] == b"\n":
        lo -= 1
    hi = offsets[ends[0]] + len(end)
    if data[hi:hi + 1] == b"\r" and data[hi + 1:hi + 2] == b"\n":
        hi += 2
    elif data[hi:hi + 1] == b"\n":
        hi += 1
    return data[lo:hi], data[:lo] + data[hi:]

def report_changed(changed):
    if changed:
        print("Review changed files manually; these were left in place:")
        for name in changed:
            print(f"  {display(name)}")

def remove_empty_directories(removed):
    """Remove the now-empty directories on a removed seat file's path, deepest first."""
    directories = set()
    for name in removed:
        parts = PurePosixPath(name).parts
        if len(parts) < 3 or parts[0] != ".ribbon" or parts[1] != "protocol":
            continue
        for depth in range(len(parts) - 1, 0, -1):
            directories.add(PurePosixPath(*parts[:depth]).as_posix())
    ordered = sorted(directories,
                     key=lambda path: (-len(PurePosixPath(path).parts), path))
    for name in ordered:
        try:
            with bound_parent(name) as (fd, leaf):
                info = os.stat(leaf, dir_fd=fd, follow_symlinks=False)
                if not stat.S_ISDIR(info.st_mode):
                    continue
                os.rmdir(leaf, dir_fd=fd)
        except FileNotFoundError:
            continue
        except OSError as error:
            if error.errno in (errno.ENOTEMPTY, errno.EEXIST):
                continue
            raise OSError(error.errno, error.strerror, name) from error

def uninstall():
    receipt_stat, proof = snapshot(receipt)
    if receipt_stat is None:
        refuse("no safe full-install ownership receipt; nothing removed")
    fields = proof.split(b"\0")
    if fields[0] == b"ribbon-full-install-receipt-v1":
        version = 1
    elif fields[0] == b"ribbon-full-install-receipt-v2":
        version = 2
    else:
        refuse("invalid full-install ownership receipt; nothing removed")
    if fields[-1] != b"" or len(fields[1:-1]) % 3:
        refuse("invalid full-install ownership receipt; nothing removed")
    kinds = (b"file", b"block") if version == 1 else (b"file", b"block", b"created-block")
    plan, changed, seen, seats = [], [], set(), []
    for idx in range(1, len(fields) - 1, 3):
        kind, raw_path, digest = fields[idx:idx + 3]
        name = os.fsdecode(raw_path)
        if (name in seen or not permitted(name, version) or kind not in kinds
                or (kind in (b"block", b"created-block") and name != "AGENTS.md")
                or not re.fullmatch(b"[0-9a-f]{64}", digest)):
            refuse("invalid ownership entry in full-install receipt; nothing removed")
        seen.add(name)
        if kind == b"file" and name.startswith(".ribbon/protocol/"):
            seats.append(name)
        info, content = snapshot(name)
        if info is None:
            if content is None:
                changed.append(name)
            continue
        owned, remaining = unchanged_block(content) if kind != b"file" else (content, None)
        if owned is None:
            changed.append(name)
        else:
            candidate = normalized_block(owned) if version == 2 else owned
            if hashlib.sha256(candidate).hexdigest().encode() != digest:
                changed.append(name)
            else:
                if kind == b"created-block" and remaining is not None and not remaining.strip():
                    remaining = None
                plan.append((name, info, content, remaining))
    if marker not in seen:
        refuse("incomplete full-install ownership receipt; nothing removed")
    preview = plan + [(receipt, receipt_stat, proof, None)]
    print("Would remove Ribbon-owned paths or blocks:")
    for name, _, _, replacement in preview:
        print(f"  {display(name)}" + (" (Ribbon block only)" if replacement is not None else ""))
    if not apply:
        print("Dry run only; use --uninstall --remove-ribbon to apply.")
    elif not yes:
        if not sys.stdin.isatty():
            refuse("non-interactive removal requires --yes; nothing removed")
        sys.stdout.flush()
        print("Remove these Ribbon files and blocks? [y/N] ", end="", file=sys.stderr, flush=True)
        if input().strip().lower() not in ("y", "yes"):
            print("Uninstall declined; nothing removed.")
            return
    if apply:
        for name, _, _, replacement in preview:
            path = root / name
            if not os.access(path.parent, os.W_OK | os.X_OK) or (
                    replacement is not None and not os.access(path, os.W_OK)):
                report_changed(changed)
                refuse(f"permission denied: {name}; nothing removed")
        for name, original, content, _ in plan:
            now, current = snapshot(name)
            if now is None or not same_inode(original, now) or current != content:
                refuse(f"path changed since preview: {name}; nothing removed")
        completed = []

        def stopped(name, error):
            if completed:
                print("Completed before uninstall stopped:", file=sys.stderr)
                for path in completed:
                    print(f"  {display(path)}", file=sys.stderr)
            report_changed(changed)
            refuse(f"uninstall stopped at {display(name)}: {error}")

        for name, original, content, replacement in plan:
            try:
                with bound_parent(name) as (fd, leaf):
                    now, current = snapshot_at(fd, leaf, name)
                    if now is None or not same_inode(original, now) or current != content:
                        raise OSError("path changed since preview")
                    if replacement is None:
                        os.unlink(leaf, dir_fd=fd)
                    else:
                        replace_block(fd, leaf, replacement, now.st_mode)
                completed.append(name)
            except OSError as error:
                stopped(name, error)
        try:
            remove_empty_directories(seats)
        except OSError as error:
            stopped(error.filename or ".ribbon/protocol", error)
        try:
            with bound_parent(receipt) as (fd, leaf):
                now, current = snapshot_at(fd, leaf, receipt)
                if now is None or not same_inode(receipt_stat, now) or current != proof:
                    raise OSError("path changed since preview")
                os.unlink(leaf, dir_fd=fd)
            completed.append(receipt)
        except OSError as error:
            stopped(receipt, error)
        print("Full-install removal complete. No Git changes were staged.")
    report_changed(changed)

try:
    root_fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        uninstall()
    finally:
        os.close(root_fd)
except (OSError, EOFError) as error:
    refuse(f"uninstall stopped: {error}")
PY
)" "${PROJECT_REPO}" "${INSTALL_RECEIPT}" "${SEED_RECORD}" "${START_MARK}" "${END_MARK}" \
    "${REMOVE_RIBBON}" "${ASSUME_YES}"
}

#######################################
# Copy the template's rules/ themes into the project repository, merging
# into an existing rules/ directory and never overwriting project themes.
# Globals:
#   RIBBON_HOME, PROJECT_REPO, WRITTEN_PATHS (appended)
#######################################
visit_rule_seeds() {
  local visit="$1" f rel
  for f in "${RIBBON_HOME}/rules"/*.md; do
    [[ -e "${f}" ]] || continue
    rel="rules/${f##*/}"
    path_present "${PROJECT_REPO}/${rel}" && continue
    "${visit}" "${rel}"
  done
}

copy_rule_seed() {
  cp "${RIBBON_HOME}/$1" "${PROJECT_REPO}/$1"
  WRITTEN_PATHS+=("$1")
}

seed_rules() {
  mkdir -p "${PROJECT_REPO}/rules"
  visit_rule_seeds copy_rule_seed
}

#######################################
# Refuse any seed that would write through an instruction alias, including
# a dangling link whose target the seed would create. Claude -> AGENTS.md
# is intentional wiring, not a Claude-owned destination.
# Globals:
#   PROJECT_REPO
#######################################
validate_instruction_destination() {
  local name="$1" destination="${PROJECT_REPO}/$1" instruction path resolved_destination resolved_instruction
  if [[ "${name}" == AGENTS.md ]] \
    && [[ -e "${destination}" || -L "${destination}" ]]; then
    [[ -f "${destination}" ]] || die "not a regular file: ${destination}"
  fi
  validate_existing_project_paths "${destination}"
  for instruction in AGENTS.md AGENTS.local.md CLAUDE.md CLAUDE.local.md; do
    [[ "${instruction}" != "${name}" ]] || continue
    path="${PROJECT_REPO}/${instruction}"
    if [[ ! "${destination}" -ef "${path}" ]]; then
      [[ -L "${path}" && ! -e "${path}" ]] || continue
      resolved_destination="$(canonical_path "${destination}")"
      resolved_instruction="$(canonical_path "${path}")"
      [[ "${resolved_destination}" == "${resolved_instruction}" ]] || continue
    fi
    if [[ "${name}" == AGENTS.md && "${instruction}" == CLAUDE* && ! -L "${destination}" && -L "${path}" ]]; then
      continue
    fi
    die "${name} aliases ${instruction}; refusing to write it"
  done
}

#######################################
# Refuse a project whose AGENTS.md already holds a Ribbon block.
# Globals:
#   PROJECT_REPO, START_MARK
#######################################
prepare_agents_md() {
  local agents="${PROJECT_REPO}/AGENTS.md"
  if [[ -f "${agents}" ]]; then
    [[ -r "${agents}" ]] || die "not readable: ${agents}"
    if grep -qE "^${START_MARK}"$'\r''?$' "${agents}"; then
      die "AGENTS.md already holds a Ribbon block; remove it, then install"
    fi
    [[ -w "${agents}" ]] || die "not writable: ${agents}"
  fi
  validate_instruction_destination AGENTS.md
  if path_present "${agents}"; then
    if [[ -L "${agents}" || ! -f "${agents}" ]] \
      || [[ "$(python3 -c 'import os, sys; print(os.stat(sys.argv[1]).st_nlink)' "${agents}")" != "1" ]]; then
      die "AGENTS.md is a link or has other names; refusing to write it"
    fi
  fi
}

#######################################
# Refuse a project that already has a standalone install.
# Globals:
#   PROJECT_REPO
#######################################
has_standalone_install() {
  local local_agents="${PROJECT_REPO}/AGENTS.local.md"
  [[ -f "${local_agents}" ]] \
    && grep -qE '^<!-- ribbon:standalone:start -->'$'\r''?$' "${local_agents}"
}

refuse_standalone_install() {
  if has_standalone_install; then
    die "${PROJECT_REPO} has a standalone install in AGENTS.local.md; uninstall it, then install"
  fi
}

refuse_standalone_update() {
  if has_standalone_install; then
    die "${PROJECT_REPO} has a standalone install in AGENTS.local.md; --update does not switch modes: uninstall it, then install"
  fi
}

#######################################
# Refuse a project that already holds .ribbon, as anything, a link included.
# Globals:
#   PROJECT_REPO
#######################################
refuse_existing_ribbon_path() {
  local reserved="${PROJECT_REPO}/.ribbon"
  if path_present "${reserved}"; then
    die "reserved path exists: ${reserved}; left untouched"
  fi
}

#######################################
# Remove the render directory when the run ends.
# Globals:
#   RENDER_DIR
#######################################
cleanup_render_dir() {
  [[ -n "${RENDER_DIR}" ]] || return 0
  rm -f "${RENDER_DIR}"/* 2>/dev/null || true
  rmdir "${RENDER_DIR}" 2>/dev/null || true
}

#######################################
# Run the template's renderer once; a failure stops the run before any write.
# Globals:
#   RIBBON_HOME
# Arguments:
#   1: the output file, then the renderer's arguments.
#######################################
run_renderer() {
  local output="$1"
  shift
  if ! "${RIBBON_HOME}/scripts/ribbon-render-protocol" \
      --protocol "${RIBBON_HOME}/protocol" \
      --set PROTOCOL_DIR=.ribbon/protocol "$@" > "${output}" 2> "${output}.error"; then
    die "cannot render the protocol: $(cat "${output}.error")"
  fi
}

#######################################
# Create the render directory once, and remove it when the run ends.
# Globals:
#   RENDER_DIR (set)
#######################################
prepare_render_dir() {
  if [[ -z "${RENDER_DIR}" ]]; then
    RENDER_DIR="$(mktemp -d)"
    trap cleanup_render_dir EXIT
  fi
}

#######################################
# Render the block, the seat list and every seat file, before any write.
# Globals:
#   RIBBON_HOME, RENDER_DIR, BLOCK_FILE, SEAT_LIST_FILE, SEAT_PATHS,
#   SEAT_FILES, SEAT_RENDERS (set)
#######################################
render_protocol() {
  prepare_render_dir
  BLOCK_FILE="${RENDER_DIR}/block"
  SEAT_LIST_FILE="${RENDER_DIR}/seats"
  if [[ -n "${BLOCK_KEEP_FROM}" ]]; then
    run_renderer "${BLOCK_FILE}" --keep-from "${BLOCK_KEEP_FROM}" project-structure.md
  else
    run_renderer "${BLOCK_FILE}" project-structure.md
  fi
  run_renderer "${SEAT_LIST_FILE}" --seat-files project-structure.md
  local path installed index=0
  while IFS=$'\t' read -r path installed; do
    [[ -n "${path}" ]] || continue
    SEAT_PATHS+=("${path}")
    SEAT_FILES+=(".ribbon/protocol/${installed}")
    SEAT_RENDERS+=("${RENDER_DIR}/seat-${index}")
    index=$((index + 1))
  done < "${SEAT_LIST_FILE}"
  index=0
  for path in "${SEAT_PATHS[@]}"; do
    run_renderer "${SEAT_RENDERS[$index]}" "${path}"
    index=$((index + 1))
  done
}

#######################################
# Validate every seat destination before any write.
# Globals:
#   PROJECT_REPO, SEAT_FILES
#######################################
prepare_seat_files() {
  local rel
  for rel in "${SEAT_FILES[@]}"; do
    validate_instruction_destination "${rel}"
    if git -C "${PROJECT_REPO}" check-ignore -q -- "${rel}" 2>/dev/null; then
      die "seat file is ignored by Git: ${rel}; allow it before installing"
    fi
  done
}

#######################################
# Refuse a block whose backticked seat paths are not the seats to install.
# Globals:
#   BLOCK_FILE, SEAT_FILES, RENDER_DIR
#######################################
prepare_block_seat_pointers() {
  local pointer candidate found marks="${RENDER_DIR}/seat-pointers"
  grep -o "\`\\.ribbon/protocol/[^\`]*\`" "${BLOCK_FILE}" \
    | sed "s/^\`//; s/\`\$//" | grep -v '^\.ribbon/protocol/$' > "${marks}" || true
  while IFS= read -r pointer; do
    [[ -n "${pointer}" ]] || continue
    found=0
    for candidate in "${SEAT_FILES[@]}"; do
      if [[ "${candidate}" == "${pointer}" ]]; then
        found=1
        break
      fi
    done
    (( found == 1 )) \
      || die "the block names a seat file that the template does not have: ${pointer}"
  done < "${marks}"
}

#######################################
# The rule files the run will write: the missing template themes and the
# imported user rules not already present.
# Globals:
#   RIBBON_HOME, PROJECT_REPO, SELECTED_RULES, PLANNED_RULE_PATHS (set)
#######################################
collect_planned_rule_paths() {
  PLANNED_RULE_PATHS=()
  local f rel
  for f in "${RIBBON_HOME}/rules"/*.md; do
    [[ -e "${f}" ]] || continue
    rel="rules/${f##*/}"
    path_present "${PROJECT_REPO}/${rel}" && continue
    PLANNED_RULE_PATHS+=("${rel}")
  done
  for f in "${SELECTED_RULES[@]}"; do
    path_present "${PROJECT_REPO}/rules/${f}" && continue
    PLANNED_RULE_PATHS+=("rules/${f}")
  done
}

#######################################
# Before any write: no planned path is ignored by Git, and the nearest existing
# ancestor of each, and the file itself when it exists, are writable.
# Arguments:
#   The paths the run will write or remove, relative to the project.
# Globals:
#   PROJECT_REPO
#######################################
prepare_write_paths() {
  local rel path directory
  for rel in "$@"; do
    [[ -n "${rel}" ]] || continue
    path="${PROJECT_REPO}/${rel}"
    if git -C "${PROJECT_REPO}" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
      && git -C "${PROJECT_REPO}" check-ignore -q -- "${rel}" 2>/dev/null; then
      die "${rel} is ignored by Git; allow it before installing"
    fi
    directory="${path%/*}"
    while [[ ! -d "${directory}" ]]; do
      directory="${directory%/*}"
    done
    [[ -w "${directory}" && -x "${directory}" ]] || die "not writable: ${directory}"
    if path_present "${path}"; then
      [[ -w "${path}" ]] || die "not writable: ${path}"
    fi
  done
}

#######################################
# The sha256 of a block without the bodies of its belt and gate regions, so
# each start mark line is followed directly by its end mark line.
# Outputs:
#   The digest on STDOUT.
#######################################
normalized_block_digest() {
  awk '
    {
      body = $0
      sub(/\r$/, "", body)
      if (region != "") {
        if (body == "<!-- ribbon:" region ":end -->") { print; region = "" }
        next
      }
      if (body == "<!-- ribbon:belt:start -->") { print; region = "belt"; next }
      if (body == "<!-- ribbon:gate:start -->") { print; region = "gate"; next }
      print
    }
  ' | file_digest
}

#######################################
# Append the marked protocol to AGENTS.md, or create it when absent.
#######################################
full_instruction_block() {
  printf '\n%s\n' "${START_MARK}"
  cat "${BLOCK_FILE}"
  if [[ -s "${BLOCK_FILE}" ]] && [[ -n "$(tail -c 1 "${BLOCK_FILE}")" ]]; then
    printf '\n'
  fi
  printf '%s\n' "${END_MARK}"
}

#######################################
# Append the block to AGENTS.md, or write it as a new AGENTS.md, and record
# the digest of its normalized bytes.
# Globals:
#   PROJECT_REPO, AGENTS_BLOCK_KIND, AGENTS_BLOCK_DIGEST (set)
#######################################
write_agents_block() {
  AGENTS_BLOCK_DIGEST="$(full_instruction_block | normalized_block_digest)"
  if [[ -f "${PROJECT_REPO}/AGENTS.md" ]]; then
    AGENTS_BLOCK_KIND='block'
    full_instruction_block >> "${PROJECT_REPO}/AGENTS.md"
  else
    AGENTS_BLOCK_KIND='created-block'
    (set -o noclobber; full_instruction_block > "${PROJECT_REPO}/AGENTS.md")
  fi
  WRITTEN_PATHS+=("AGENTS.md")
}

#######################################
# Write each seat file at .ribbon/protocol/<installed path>.
# Globals:
#   PROJECT_REPO, SEAT_FILES, SEAT_RENDERS, WRITTEN_PATHS (appended)
#######################################
write_seat_files() {
  local rel index=0
  for rel in "${SEAT_FILES[@]}"; do
    mkdir -p "${PROJECT_REPO}/${rel%/*}"
    (set -o noclobber; cat "${SEAT_RENDERS[$index]}" > "${PROJECT_REPO}/${rel}")
    WRITTEN_PATHS+=("${rel}")
    index=$((index + 1))
  done
}

#######################################
# Warn about existing Claude files without a direct AGENTS import or link.
# Never create, modify or stage either Claude file.
#######################################
warn_unlinked_claude_files() {
  local suffix agents claude
  for suffix in .md .local.md; do
    agents="AGENTS${suffix}"
    claude="CLAUDE${suffix}"
    [[ -f "${PROJECT_REPO}/${agents}" && -f "${PROJECT_REPO}/${claude}" ]] || continue
    if [[ -L "${PROJECT_REPO}/${claude}" && "${PROJECT_REPO}/${claude}" -ef "${PROJECT_REPO}/${agents}" ]] \
      || grep -Eq "^@(\./)?${agents//./\\.}[[:space:]]*$" "${PROJECT_REPO}/${claude}" 2>/dev/null; then
      continue
    fi
    printf 'warning: %s does not point to %s; left unchanged\n' "${claude}" "${agents}" >&2
  done
}

#######################################
# Commit the seed as one commit when the project is a git repository.
# Globals:
#   PROJECT_REPO, COMMIT_NOTE (set)
#######################################
commit_seed() {
  local version
  version="$(head -1 "${RIBBON_HOME}/VERSION")"
  if git -C "${PROJECT_REPO}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local -a literal_specs=()
    local p
    for p in "${WRITTEN_PATHS[@]}"; do
      literal_specs+=(":(literal)${p}")
    done
    git -C "${PROJECT_REPO}" add -- "${literal_specs[@]}"
    git -C "${PROJECT_REPO}" commit -m "Seed the Ribbon Protocol, ${version}" \
      -- "${literal_specs[@]}"
    COMMIT_NOTE="committed as 'Seed the Ribbon Protocol, ${version}'"
  else
    COMMIT_NOTE='not a git repository, nothing committed'
  fi
}

#######################################
# Print a summary of what happened.
# Globals:
#   PROJECT_REPO, COMMIT_NOTE, START_MARK, END_MARK, RIBBON_HOME
#######################################
print_summary() {
  local version
  version="$(head -1 "${RIBBON_HOME}/VERSION")"
  cat <<EOF
Seeded the Ribbon Protocol (${version}) into ${PROJECT_REPO}:

  docs/           missing homes, schemas, templates and field guide added
  rules/          missing coding conventions added; existing paths kept
  seed record     ${SEED_RECORD}
  uninstall proof ${INSTALL_RECEIPT}
  AGENTS.md       the rules that bind every seat (${START_MARK} .. ${END_MARK})
  .ribbon/        each seat's files under .ribbon/protocol/ (${#SEAT_FILES[@]} files)
  Claude files   left unchanged
  git:            ${COMMIT_NOTE}

Next: fill the belt — open AGENTS.md, replace every TODO(belt) in the roster and
the gate, between their ribbon:belt and ribbon:gate marks.
EOF
}

#######################################
# Offer the user's machine-global rules (~/.claude/rules) as project themes so
# every engineer gets them. With --import-rules, copies exactly those files.
# In a terminal, shows a multi-select prompt. Otherwise prints a note and
# imports nothing. Existing project themes are never overwritten.
# Globals:
#   HOME, PROJECT_REPO, IMPORT_RULES, IMPORT_NOTE (set)
#######################################
prepare_user_rule_imports() {
  local rules_dir="${HOME}/.claude/rules"
  local -a candidates=()
  local f
  if [[ -d "${rules_dir}" ]]; then
    for f in "${rules_dir}"/*.md; do
      [[ -f "${f}" ]] && candidates+=("$(basename "${f}")")
    done
  fi
  IMPORT_NOTE=''

  if [[ "${#IMPORT_RULES[@]}" -gt 0 ]]; then
    SELECTED_RULES=("${IMPORT_RULES[@]}")
  elif [[ "${#candidates[@]}" -eq 0 ]]; then
    return 0
  elif [[ -t 0 ]]; then
    pick_rules "${candidates[@]}"
    SELECTED_RULES=("${PICKED[@]}")
  else
    printf 'note: %d rule file(s) in %s not imported (not interactive); re-run in a terminal or pass --import-rules\n' \
      "${#candidates[@]}" "${rules_dir}" >&2
    return 0
  fi

  for f in "${SELECTED_RULES[@]}"; do
    [[ -f "${rules_dir}/${f}" ]] || die "--import-rules file not found: ${rules_dir}/${f}"
    path_present "${PROJECT_REPO}/rules/${f}" || validate_instruction_destination "rules/${f}"
  done
}

import_user_rules() {
  [[ "${#SELECTED_RULES[@]}" -gt 0 ]] || return 0
  local rules_dir="${HOME}/.claude/rules" f imported=0 kept=0
  for f in "${SELECTED_RULES[@]}"; do
    if path_present "${PROJECT_REPO}/rules/${f}"; then
      kept=$((kept + 1))
      continue
    fi
    cp "${rules_dir}/${f}" "${PROJECT_REPO}/rules/${f}"
    WRITTEN_PATHS+=("rules/${f}")
    imported=$((imported + 1))
  done
  IMPORT_NOTE="imported ${imported} user rule file(s) from ${rules_dir}"
  if (( kept > 0 )); then
    IMPORT_NOTE+=" (${kept} already present, kept as-is)"
  fi
}

#######################################
# Interactive multi-select over the candidate rule files. Sets PICKED.
# Arguments:
#   Candidate file names.
# Globals:
#   PICKED (set)
# Outputs:
#   Prompt and menu to STDERR.
#######################################
pick_rules() {
  local -a picked=() options=("$@")
  local input tok opt p mark
  while true; do
    printf '\nImport coding rules from ~/.claude/rules so every engineer gets them?\n' >&2
    local i=1
    for opt in "${options[@]}"; do
      mark=' '
      for p in "${picked[@]}"; do
        [[ "${p}" == "${opt}" ]] && mark='x'
      done
      printf '  [%s] %d) %s\n' "${mark}" "${i}" "${opt}" >&2
      i=$((i + 1))
    done
    printf 'Toggle numbers, [a]ll, [n]one, [d]one: ' >&2
    read -r input || input='d'
    case "${input}" in
      a) picked=("${options[@]}") ;;
      n) picked=() ;;
      d) break ;;
      *[!0-9\ ]*) printf 'Answer with numbers, a, n or d.\n' >&2 ;;
      *)
        local -a toks=()
        read -ra toks <<< "${input}"
        for tok in "${toks[@]}"; do
          if [[ ! "${tok}" =~ ^[0-9]+$ ]] || (( ${#tok} > 9 )); then
            printf 'Not a rule number: %s\n' "${tok}" >&2
            continue
          fi
          local num=$((10#$tok))
          if (( num < 1 || num > ${#options[@]} )); then
            printf 'No rule number %s.\n' "${tok}" >&2
            continue
          fi
          opt="${options[$((num - 1))]}"
          local -a next=()
          local found=0
          for p in "${picked[@]}"; do
            if [[ "${p}" == "${opt}" ]]; then
              found=1
            else
              next+=("${p}")
            fi
          done
          if (( found == 0 )); then
            next+=("${opt}")
          fi
          picked=("${next[@]}")
        done
        ;;
    esac
  done
  PICKED=("${picked[@]}")
}

#######################################
# Commit a rules-only amendment when the project is a git repository.
# Globals:
#   RIBBON_HOME, PROJECT_REPO, COMMIT_NOTE (set)
#######################################
commit_amend() {
  local version
  version="$(head -1 "${RIBBON_HOME}/VERSION")"
  if git -C "${PROJECT_REPO}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local -a literal_specs=()
    local p
    for p in "${WRITTEN_PATHS[@]}"; do
      literal_specs+=(":(literal)${p}")
    done
    git -C "${PROJECT_REPO}" add -- "${literal_specs[@]}"
    git -C "${PROJECT_REPO}" commit -m "Add Ribbon coding rules, ${version}" \
      -- "${literal_specs[@]}"
    COMMIT_NOTE="committed as 'Add Ribbon coding rules, ${version}'"
  else
    COMMIT_NOTE='not a git repository, nothing committed'
  fi
}

#######################################
# Print the amendment summary.
# Globals:
#   PROJECT_REPO, COMMIT_NOTE, IMPORT_NOTE
#######################################
print_amend_summary() {
  local import_line=''
  if [[ -n "${IMPORT_NOTE}" ]]; then
    import_line="  user rules:      ${IMPORT_NOTE}
"
  fi
  cat <<EOF
Added Ribbon coding rules to the already-seeded project ${PROJECT_REPO}:

  rules/          coding conventions, one theme per file
${import_line}  git:            ${COMMIT_NOTE}

Next: run --update on any standalone instances of this project.
EOF
}

#######################################
# Whether a full-install receipt starts with the v2 signature.
# Arguments:
#   The receipt path.
#######################################
receipt_is_v2() {
  local receipt="$1"
  [[ -f "${receipt}" ]] || return 1
  head -c 31 "${receipt}" | cmp -s - <(printf 'ribbon-full-install-receipt-v2\0')
}

#######################################
# The mode of a --update target: v2, old or none.
# Globals:
#   PROJECT_REPO
# Outputs:
#   One word on STDOUT.
#######################################
update_mode() {
  local receipt="${PROJECT_REPO}/${INSTALL_RECEIPT}"
  local record="${PROJECT_REPO}/${SEED_RECORD}"
  local readme="${PROJECT_REPO}/docs/README.md"
  if receipt_is_v2 "${receipt}"; then
    printf 'v2\n'
  elif path_present "${receipt}" || path_present "${record}" \
    || { [[ -f "${readme}" && ! -L "${readme}" ]] \
      && head -1 "${readme}" | grep -qxE "${SEED_STAMP_PATTERN}"; }; then
    printf 'old\n'
  else
    printf 'none\n'
  fi
}

#######################################
# Print the old block's belt table rows: from the line that starts
# '| Role | Agent | Model' to the last line that starts '|' after it.
# Globals:
#   PROJECT_REPO, START_MARK, END_MARK
#######################################
old_install_belt_rows() {
  awk -v start_mark="${START_MARK}" -v end_mark="${END_MARK}" '
    $0 == start_mark { inside = 1; next }
    $0 == end_mark { inside = 0; next }
    !inside { next }
    {
      n++
      line[n] = $0
      if ($0 ~ /^\| Role \| Agent \| Model/) { header = n }
      else if (header && $0 ~ /^\|/) { last = n }
    }
    END {
      if (header && last >= header) {
        for (i = header; i <= last; i++) print line[i]
      }
    }
  ' "${PROJECT_REPO}/AGENTS.md"
}

#######################################
# Resolve and validate the project repository for --update.
# Globals:
#   RIBBON_HOME, PROJECT_REPO (set)
#######################################
resolve_update_repo() {
  [[ -n "${PROJECT_REPO}" ]] || { usage; die "missing <project-repo-path>"; }
  [[ -d "${RIBBON_HOME}/docs" && -d "${RIBBON_HOME}/rules" \
    && -f "${RIBBON_HOME}/protocol/project-structure.md" \
    && -x "${RIBBON_HOME}/scripts/ribbon-render-protocol" ]] \
    || die "template not found under ${RIBBON_HOME} (point --ribbon-home at the template repo)"
  [[ -d "${PROJECT_REPO}" ]] || die "project repo not found: ${PROJECT_REPO}"
  [[ -w "${PROJECT_REPO}" && -x "${PROJECT_REPO}" ]] \
    || die "project repo is not writable with your permissions: ${PROJECT_REPO}"
  validate_path_characters 'the project repo path' "${PROJECT_REPO}"
  PROJECT_REPO="$(canonical_path "${PROJECT_REPO}")"
  validate_project_directory docs
}

#######################################
# Read the v2 receipt into its docs entries, its seat paths and its block
# entry kind, and validate it.
# Globals:
#   PROJECT_REPO, SEED_RECORD, RECORDED_DOCS, RECORDED_SEATS,
#   UPDATE_BLOCK_KIND, RENDER_DIR (set)
#######################################
read_update_receipt() {
  python3 - "${PROJECT_REPO}/${INSTALL_RECEIPT}" "${SEED_RECORD}" \
    "${RENDER_DIR}/receipt-docs" "${RENDER_DIR}/receipt-seats" \
    "${RENDER_DIR}/receipt-kind" <<'PY'
import re
import sys
from pathlib import PurePosixPath

receipt, record_name, docs_out, seats_out, kind_out = sys.argv[1:]

def refuse(message):
    raise SystemExit("ribbon-seed-project: " + message)

data = open(receipt, "rb").read()
if not data.startswith(b"ribbon-full-install-receipt-v2\0"):
    refuse("invalid full-install ownership receipt; nothing removed")
fields = data.split(b"\0")
if fields[-1] != b"" or len(fields[1:-1]) % 3:
    refuse("invalid full-install ownership receipt; nothing removed")

def permitted(name):
    path = PurePosixPath(name)
    if path.as_posix() != name or path.is_absolute() or ".." in path.parts:
        return False
    if name in {"AGENTS.md", "herdr-config.md", record_name, "docs/README.md",
                "docs/field-guide.md", "docs/tasks/README.md",
                "docs/llm-context/README.md"}:
        return True
    if (str(path.parent) == "docs/tasks" and path.name.startswith("_template.")) or (
            str(path.parent) == "docs/llm-context" and path.name.startswith("_")
            and path.suffix == ".md"):
        return True
    return (len(path.parts) >= 3 and path.parts[0] == ".ribbon"
            and path.parts[1] == "protocol" and name.endswith(".md"))

docs, seats, kinds, seen = [], [], [], set()
record_seen = False
for index in range(1, len(fields) - 1, 3):
    kind, raw_name, digest = fields[index:index + 3]
    name = raw_name.decode("utf-8", "surrogateescape")
    path = PurePosixPath(name)
    seat = (path.as_posix() == name and len(path.parts) >= 3
            and path.parts[0] == ".ribbon" and path.parts[1] == "protocol"
            and ".." not in path.parts and name.endswith(".md"))
    if not permitted(name):
        refuse("invalid full-install ownership receipt; nothing changed")
    if (path.as_posix() != name or path.is_absolute() or ".." in path.parts
            or name in seen or kind not in (b"file", b"block", b"created-block")
            or not re.fullmatch(b"[0-9a-f]{64}", digest)
            or (kind in (b"block", b"created-block") and name != "AGENTS.md")
            or (name.startswith(".ribbon/protocol/") and not seat)
            or (seat and kind != b"file")
            or "\n" in name or "\t" in name):
        refuse("invalid full-install ownership receipt; nothing removed")
    seen.add(name)
    if kind in (b"block", b"created-block"):
        kinds.append(kind.decode())
    elif name == record_name:
        record_seen = True
    elif seat:
        seats.append(name)
    else:
        docs.append((name, digest.decode()))
if len(kinds) != 1 or not record_seen:
    refuse("invalid full-install ownership receipt; nothing removed")
with open(docs_out, "w", encoding="utf-8", newline="") as stream:
    for name, digest in docs:
        stream.write("%s\t%s\n" % (name, digest))
with open(seats_out, "w", encoding="utf-8", newline="") as stream:
    for name in seats:
        stream.write(name + "\n")
with open(kind_out, "w", encoding="utf-8", newline="") as stream:
    stream.write(kinds[0] + "\n")
PY
  local name digest
  while IFS=$'\t' read -r name digest; do
    [[ -n "${name}" ]] || continue
    RECORDED_DOCS+=("${name}"$'\t'"${digest}")
  done < "${RENDER_DIR}/receipt-docs"
  while IFS= read -r name; do
    [[ -n "${name}" ]] || continue
    RECORDED_SEATS+=("${name}")
  done < "${RENDER_DIR}/receipt-seats"
  UPDATE_BLOCK_KIND="$(cat "${RENDER_DIR}/receipt-kind")"
}

#######################################
# Check AGENTS.md's destination before the update writes it.
# Globals:
#   PROJECT_REPO
#######################################
prepare_update_agents_md() {
  local agents="${PROJECT_REPO}/AGENTS.md"
  [[ -f "${agents}" ]] \
    || die "AGENTS.md's Ribbon block is missing, duplicated or out of order; fix it before re-running"
  [[ -r "${agents}" ]] || die "not readable: ${agents}"
  [[ -w "${agents}" ]] || die "not writable: ${agents}"
  validate_instruction_destination AGENTS.md
}

#######################################
# Write the old block, from START_MARK's line through END_MARK's line, to a
# temporary file. A block that is not exactly one start and one end, in that
# order, stops the run.
# Globals:
#   PROJECT_REPO, START_MARK, END_MARK, OLD_BLOCK_FILE
#######################################
extract_agents_block() {
  python3 - "${PROJECT_REPO}/AGENTS.md" "${START_MARK}" "${END_MARK}" \
    "${OLD_BLOCK_FILE}" <<'PY'
import sys

agents, start, end, output = sys.argv[1:]
start_line = start.encode()
end_line = end.encode()

def refuse(message):
    raise SystemExit("ribbon-seed-project: " + message)

data = open(agents, "rb").read()
lines = data.split(b"\n")
offsets = []
position = 0
for line in lines:
    offsets.append(position)
    position += len(line) + 1
starts = [index for index, line in enumerate(lines)
          if line == start_line or line == start_line + b"\r"]
ends = [index for index, line in enumerate(lines)
        if line == end_line or line == end_line + b"\r"]
if len(starts) != 1 or len(ends) != 1 or starts[0] >= ends[0]:
    refuse("AGENTS.md's Ribbon block is missing, duplicated or out of order; fix it before re-running")
begin = offsets[starts[0]]
if begin > 0 and data[begin - 1:begin] == b"\n":
    begin -= 1
finish = offsets[ends[0]] + len(end_line)
if data[finish:finish + 1] == b"\r" and data[finish + 1:finish + 2] == b"\n":
    finish += 2
elif data[finish:finish + 1] == b"\n":
    finish += 1
with open(output, "wb") as stream:
    stream.write(data[begin:finish])
PY
}

#######################################
# Replace AGENTS.md's block with the frame around the new rendering, keeping
# the bytes before and after it; write only when a byte changed.
# Globals:
#   PROJECT_REPO, START_MARK, END_MARK, BLOCK_FILE
# Outputs:
#   'changed' or 'same' on STDOUT.
#######################################
splice_agents_block() {
  python3 - "${PROJECT_REPO}/AGENTS.md" "${START_MARK}" "${END_MARK}" \
    "${BLOCK_FILE}" <<'PY'
import os
import secrets
import stat
import sys

agents, start, end, rendered = sys.argv[1:]
start_line = start.encode()
end_line = end.encode()

def refuse(message):
    raise SystemExit("ribbon-seed-project: " + message)

data = open(agents, "rb").read()
lines = data.split(b"\n")
offsets = []
position = 0
for line in lines:
    offsets.append(position)
    position += len(line) + 1
starts = [index for index, line in enumerate(lines)
          if line == start_line or line == start_line + b"\r"]
ends = [index for index, line in enumerate(lines)
        if line == end_line or line == end_line + b"\r"]
if len(starts) != 1 or len(ends) != 1 or starts[0] >= ends[0]:
    refuse("AGENTS.md's Ribbon block is missing, duplicated or out of order; fix it before re-running")
begin = offsets[starts[0]]
if begin > 0 and data[begin - 1:begin] == b"\n":
    begin -= 1
finish = offsets[ends[0]] + len(end_line)
if data[finish:finish + 1] == b"\r" and data[finish + 1:finish + 2] == b"\n":
    finish += 2
elif data[finish:finish + 1] == b"\n":
    finish += 1
block = open(rendered, "rb").read()
if block and not block.endswith(b"\n"):
    block += b"\n"
frame = b"\n" + start_line + b"\n" + block + end_line + b"\n"
new = data[:begin] + frame + data[finish:]
if new == data:
    print("same")
    raise SystemExit(0)
mode = stat.S_IMODE(os.stat(agents).st_mode)
directory = os.path.dirname(agents) or "."
temporary = os.path.join(directory, ".ribbon-agents-" + secrets.token_hex(12))
fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
try:
    with os.fdopen(fd, "wb") as stream:
        stream.write(new)
        os.fchmod(stream.fileno(), mode)
    os.replace(temporary, agents)
    temporary = None
finally:
    if temporary is not None:
        os.unlink(temporary)
print("changed")
PY
}

#######################################
# Whether a seat path is one the receipt records.
# Globals:
#   RECORDED_SEATS
#######################################
recorded_seat() {
  local candidate="$1" name
  for name in "${RECORDED_SEATS[@]}"; do
    if [[ "${name}" == "${candidate}" ]]; then
      return 0
    fi
  done
  return 1
}

#######################################
# Refuse a new seat path that holds an entry the receipt does not record.
# Globals:
#   PROJECT_REPO, SEAT_FILES, RECORDED_SEATS
#######################################
prepare_update_seat_ownership() {
  local rel
  for rel in "${SEAT_FILES[@]}"; do
    if path_present "${PROJECT_REPO}/${rel}" && ! recorded_seat "${rel}"; then
      die "seat file exists and is not Ribbon's: ${rel}"
    fi
  done
}

#######################################
# Collect the recorded seat files that the template no longer names; a link
# or another entry at one of them stops the run.
# Globals:
#   PROJECT_REPO, SEAT_FILES, RECORDED_SEATS, REMOVED_SEAT_PATHS (set)
#######################################
prepare_update_removals() {
  local rel candidate named
  REMOVED_SEAT_PATHS=()
  for rel in "${RECORDED_SEATS[@]}"; do
    named=0
    for candidate in "${SEAT_FILES[@]}"; do
      if [[ "${candidate}" == "${rel}" ]]; then
        named=1
        break
      fi
    done
    (( named == 0 )) || continue
    if path_present "${PROJECT_REPO}/${rel}"; then
      if [[ -L "${PROJECT_REPO}/${rel}" || ! -f "${PROJECT_REPO}/${rel}" ]]; then
        die "unsafe seat file: ${rel}"
      fi
      REMOVED_SEAT_PATHS+=("${rel}")
    elif git -C "${PROJECT_REPO}" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
      && git -C "${PROJECT_REPO}" cat-file -e "HEAD:${rel}" 2>/dev/null; then
      REMOVED_SEAT_PATHS+=("${rel}")
    fi
  done
}

#######################################
# Every --update destination: each directory of its path below the
# project is a real directory (not a link), and the leaf, when it exists,
# is a regular file, not a link, with one hard link. Runs after V4's
# checks, so their messages fire first where they apply.
# Globals:
#   PROJECT_REPO, SEAT_FILES, SEED_RECORD, INSTALL_RECEIPT
#######################################
validate_update_destinations() {
  local rel path current component
  local -a parts
  for rel in "${SEAT_FILES[@]}" "${SEED_RECORD}" "${INSTALL_RECEIPT}" "AGENTS.md"; do
    current="${PROJECT_REPO}"
    IFS='/' read -ra parts <<< "${rel}"
    for component in "${parts[@]:0:${#parts[@]}-1}"; do
      current="${current}/${component}"
      if [[ -L "${current}" ]] || { [[ -e "${current}" ]] && [[ ! -d "${current}" ]]; }; then
        die "unsafe destination: ${rel}"
      fi
    done
    path="${PROJECT_REPO}/${rel}"
    if [[ -e "${path}" || -L "${path}" ]]; then
      if [[ -L "${path}" || ! -f "${path}" ]] \
        || [[ -n "$(find "${path}" -maxdepth 0 -links +1 -print -quit)" ]]; then
        die "unsafe destination: ${rel}"
      fi
    fi
  done
}

#######################################
# Write each seat file whose rendering differs from the file on disk,
# through a temporary file in the same directory and a rename.
# Globals:
#   PROJECT_REPO, SEAT_FILES, SEAT_RENDERS, UPDATED_PATHS,
#   UPDATED_SEATS, UPDATE_CHANGED (set)
#######################################
write_update_seat_files() {
  local rel index=0 target
  for rel in "${SEAT_FILES[@]}"; do
    if ! cmp -s "${SEAT_RENDERS[$index]}" "${PROJECT_REPO}/${rel}" 2>/dev/null; then
      mkdir -p "${PROJECT_REPO}/${rel%/*}"
      target="${PROJECT_REPO}/${rel}"
      cp "${SEAT_RENDERS[$index]}" "${target}.ribbon-new"
      mv -f "${target}.ribbon-new" "${target}"
      UPDATED_PATHS+=("${rel}")
      UPDATED_SEATS=$((UPDATED_SEATS + 1))
      UPDATE_CHANGED=1
    fi
    index=$((index + 1))
  done
}

write_update_agents_md() {
  local outcome
  outcome="$(splice_agents_block)"
  if [[ "${outcome}" == 'changed' ]]; then
    UPDATED_PATHS+=("AGENTS.md")
    UPDATE_CHANGED=1
  fi
}

#######################################
# Remove the recorded seat files the template dropped, then the directories
# they leave empty: os.rmdir, deepest first, .ribbon last, never a link.
# Globals:
#   PROJECT_REPO, REMOVED_SEAT_PATHS, UPDATED_PATHS, REMOVED_SEAT_COUNT,
#   UPDATE_CHANGED (set)
#######################################
remove_update_seats() {
  local rel
  ((${#REMOVED_SEAT_PATHS[@]} > 0)) || return 0
  for rel in "${REMOVED_SEAT_PATHS[@]}"; do
    rm -f "${PROJECT_REPO}/${rel}"
    UPDATED_PATHS+=("${rel}")
    REMOVED_SEAT_COUNT=$((REMOVED_SEAT_COUNT + 1))
    UPDATE_CHANGED=1
  done
  python3 - "${PROJECT_REPO}" "${REMOVED_SEAT_PATHS[@]}" <<'PY'
import errno
import os
from pathlib import PurePosixPath
import stat
import sys

root = sys.argv[1]
directories = set()
for name in sys.argv[2:]:
    parts = PurePosixPath(name).parts
    if len(parts) < 3 or parts[0] != ".ribbon" or parts[1] != "protocol":
        continue
    for depth in range(len(parts) - 1, 0, -1):
        directories.add(PurePosixPath(*parts[:depth]).as_posix())
ordered = sorted(directories, key=lambda path: (-len(PurePosixPath(path).parts), path))
root_fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
try:
    for name in ordered:
        fd = os.dup(root_fd)
        try:
            parts = PurePosixPath(name).parts
            for component in parts[:-1]:
                child = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                                dir_fd=fd)
                os.close(fd)
                fd = child
            info = os.stat(parts[-1], dir_fd=fd, follow_symlinks=False)
            if not stat.S_ISDIR(info.st_mode):
                continue
            os.rmdir(parts[-1], dir_fd=fd)
        except FileNotFoundError:
            continue
        except OSError as error:
            if error.errno in (errno.ENOTEMPTY, errno.EEXIST):
                continue
            raise
        finally:
            os.close(fd)
finally:
    os.close(root_fd)
PY
}

#######################################
# Build the new seed record and the new receipt in the render directory.
# Globals:
#   RENDER_DIR, SEED_VERSION, SEED_RECORD, SEAT_FILES, SEAT_RENDERS,
#   UPDATE_BLOCK_KIND
#######################################
build_update_record() {
  printf 'Seeded from the Ribbon Protocol, %s.\n' "${SEED_VERSION}" \
    > "${RENDER_DIR}/record.new"
}

build_update_receipt() {
  local name digest index=0 rel
  {
    printf 'ribbon-full-install-receipt-v2\0'
    while IFS=$'\t' read -r name digest; do
      [[ -n "${name}" ]] || continue
      printf 'file\0%s\0%s\0' "${name}" "${digest}"
    done < "${RENDER_DIR}/receipt-docs"
    for rel in "${SEAT_FILES[@]}"; do
      digest="$(file_digest < "${SEAT_RENDERS[$index]}")"
      printf 'file\0%s\0%s\0' "${rel}" "${digest}"
      index=$((index + 1))
    done
    digest="$(full_instruction_block | normalized_block_digest)"
    printf '%s\0AGENTS.md\0%s\0' "${UPDATE_BLOCK_KIND}" "${digest}"
    digest="$(file_digest < "${RENDER_DIR}/record.new")"
    printf 'file\0%s\0%s\0' "${SEED_RECORD}" "${digest}"
  } > "${RENDER_DIR}/receipt.new"
}

write_update_records() {
  if ! cmp -s "${RENDER_DIR}/record.new" "${PROJECT_REPO}/${SEED_RECORD}" 2>/dev/null; then
    cp "${RENDER_DIR}/record.new" "${PROJECT_REPO}/${SEED_RECORD}.ribbon-new"
    mv -f "${PROJECT_REPO}/${SEED_RECORD}.ribbon-new" "${PROJECT_REPO}/${SEED_RECORD}"
    UPDATED_PATHS+=("${SEED_RECORD}")
    UPDATE_CHANGED=1
  fi
  if ! cmp -s "${RENDER_DIR}/receipt.new" "${PROJECT_REPO}/${INSTALL_RECEIPT}" 2>/dev/null; then
    cp "${RENDER_DIR}/receipt.new" "${PROJECT_REPO}/${INSTALL_RECEIPT}.ribbon-new"
    mv -f "${PROJECT_REPO}/${INSTALL_RECEIPT}.ribbon-new" "${PROJECT_REPO}/${INSTALL_RECEIPT}"
    UPDATED_PATHS+=("${INSTALL_RECEIPT}")
    UPDATE_CHANGED=1
  fi
}

#######################################
# Commit the update's own paths when the project is a git repository. A
# write that only restores the committed bytes leaves nothing to commit:
# the run then reports the write with 'nothing to commit, the files match
# HEAD' instead of an empty commit.
# Globals:
#   RIBBON_HOME, PROJECT_REPO, UPDATED_PATHS, COMMIT_NOTE (set)
#######################################
commit_update() {
  local version
  version="$(head -1 "${RIBBON_HOME}/VERSION")"
  if git -C "${PROJECT_REPO}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local -a literal_specs=()
    local p
    for p in "${UPDATED_PATHS[@]}"; do
      literal_specs+=(":(literal)${p}")
    done
    git -C "${PROJECT_REPO}" add -- "${literal_specs[@]}"
    if git -C "${PROJECT_REPO}" diff --cached --quiet HEAD -- "${literal_specs[@]}"; then
      COMMIT_NOTE='nothing to commit, the files match HEAD'
      return 0
    fi
    git -C "${PROJECT_REPO}" commit -m "Update the Ribbon Protocol, ${version}" \
      -- "${literal_specs[@]}"
    COMMIT_NOTE="committed as 'Update the Ribbon Protocol, ${version}'"
  else
    COMMIT_NOTE='not a git repository, nothing committed'
  fi
}

#######################################
# Print the update summary.
# Globals:
#   PROJECT_REPO, SEED_VERSION, UPDATED_SEATS, REMOVED_SEAT_COUNT,
#   COMMIT_NOTE, UPDATE_CHANGED
#######################################
print_update_summary() {
  if (( UPDATE_CHANGED == 0 )); then
    printf 'Nothing to update: %s already holds the current rendering.\n' "${PROJECT_REPO}"
    return 0
  fi
  cat <<EOF
Updated the Ribbon Protocol (${SEED_VERSION}) in ${PROJECT_REPO}:

  AGENTS.md       the block rendered again; the roster and the gate kept
  .ribbon/        ${UPDATED_SEATS} seat files written, ${REMOVED_SEAT_COUNT} removed
  git:            ${COMMIT_NOTE}
EOF
}

#######################################
# Entry point: update a full install in place, or stop before any write.
# Globals:
#   PROJECT_REPO, RIBBON_HOME, UPDATE_CHANGED (set)
#######################################
update_full_install() {
  resolve_update_repo
  SEED_VERSION="$(head -1 "${RIBBON_HOME}/VERSION")"
  [[ "${SEED_VERSION}" =~ ^ribbon\ [0-9]+$ ]] || die "invalid Ribbon seed version: ${SEED_VERSION}"
  confirm_target
  collect_existing_project_docs_and_rules
  refuse_standalone_update
  case "$(update_mode)" in
    old)
      if [[ -f "${PROJECT_REPO}/AGENTS.md" ]]; then
        old_install_belt_rows
      fi
      die "${PROJECT_REPO} holds an older full install, which --update cannot change; uninstall it (--uninstall --remove-ribbon), then install"
      ;;
    none)
      die "no full install in ${PROJECT_REPO}; install it first"
      ;;
  esac
  prepare_render_dir
  read_update_receipt
  prepare_update_agents_md
  OLD_BLOCK_FILE="${RENDER_DIR}/old-block"
  extract_agents_block
  BLOCK_KEEP_FROM="${OLD_BLOCK_FILE}"
  render_protocol
  prepare_block_seat_pointers
  prepare_seat_files
  prepare_update_seat_ownership
  prepare_update_removals
  validate_update_destinations
  prepare_write_paths "${SEAT_FILES[@]}" "${REMOVED_SEAT_PATHS[@]}" \
    "AGENTS.md" "${SEED_RECORD}" "${INSTALL_RECEIPT}"
  build_update_record
  build_update_receipt
  write_update_seat_files
  write_update_agents_md
  remove_update_seats
  write_update_records
  if (( UPDATE_CHANGED == 1 )); then
    commit_update
  fi
  print_update_summary
}

#######################################
# Entry point: validate, seed, wire, commit, report.
# Arguments:
#   The raw command line.
#######################################
main() {
  parse_args "$@"
  find_gnu_realpath
  if (( UPDATE == 1 )); then
    (( UNINSTALL == 0 )) || die "--update cannot be used with --uninstall"
    (( REMOVE_RIBBON == 0 )) || die "--update cannot be used with --remove-ribbon"
    (( ${#IMPORT_RULES[@]} == 0 )) || die "--update cannot be used with --import-rules"
  fi
  if (( UNINSTALL == 1 )); then
    [[ "${#IMPORT_RULES[@]}" -eq 0 ]] || die "--import-rules cannot be used with --uninstall"
    uninstall_full_install
    return
  fi
  (( REMOVE_RIBBON == 0 )) || die "--remove-ribbon requires --uninstall"
  if (( UPDATE == 1 )); then
    update_full_install
    return
  fi
  validate_import_rules
  resolve_repo
  SEED_VERSION="$(head -1 "${RIBBON_HOME}/VERSION")"
  [[ "${SEED_VERSION}" =~ ^ribbon\ [0-9]+$ ]] || die "invalid Ribbon seed version: ${SEED_VERSION}"
  confirm_target
  collect_existing_project_docs_and_rules
  refuse_standalone_install
  refuse_existing_ribbon_path
  if (( AMEND == 0 )); then
    prepare_agents_md
    render_protocol
    prepare_seat_files
    prepare_block_seat_pointers
    prepare_doc_seeds
    prepare_seed_record
  fi
  if ! path_present "${PROJECT_REPO}/rules"; then
    validate_instruction_destination rules
  fi
  visit_rule_seeds validate_instruction_destination
  prepare_user_rule_imports
  collect_planned_rule_paths
  if (( AMEND == 0 )); then
    prepare_write_paths "${DOC_SEEDS[@]}" "${SEAT_FILES[@]}" "AGENTS.md" \
      "${INSTALL_RECEIPT}" "${SEED_RECORD}" "${PLANNED_RULE_PATHS[@]}"
  else
    prepare_write_paths "${PLANNED_RULE_PATHS[@]}"
  fi
  if (( AMEND == 1 )); then
    seed_rules
    import_user_rules
    [[ "${#WRITTEN_PATHS[@]}" -gt 0 ]] \
      || die "every Ribbon theme is already present in ${PROJECT_REPO}; nothing to amend"
    commit_amend
    print_amend_summary
    warn_unlinked_claude_files
    return
  fi
  seed_docs
  seed_rules
  import_user_rules
  write_seat_files
  write_agents_block
  write_seed_record
  write_install_receipt
  commit_seed
  print_summary
  warn_unlinked_claude_files
}

main "$@"
