#!/usr/bin/env bash
# ribbon-seed-project — the full install: seed a project repository with the
# Ribbon Protocol, committed for every collaborator and agent.
#
# Usage: scripts/ribbon-seed-project [--ribbon-home DIR] [--yes]
#     [--import-rules F]... <project-repo-path>
#
# Seeds missing project docs and rules, writes a separate full-install
# record, and appends the protocol to the project's AGENTS.md (or creates
# one). Copies herdr-config.md beside it, leaves Claude instruction files
# untouched, and commits as "Seed the Ribbon Protocol, ribbon N".
#
# An already-seeded project that predates rules/ gets a rules-only amendment
# instead of a refusal. With --import-rules F (repeatable), copies F from
# ~/.claude/rules into the project's rules/ so every engineer gets the user's
# conventions; in a terminal the script offers a multi-select picker.
#
# --ribbon-home DIR points at the template checkout; it defaults to the
# repository containing this script, so a clone at ~/ribbon-protocol needs
# no flags.

# macOS ships bash 3.2 as /bin/bash. Before 4.4, `set -u` treats an empty
# array as unbound, and this script expands empty arrays on purpose.
if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4) )); then
  printf 'ribbon-seed-project: needs bash 4.4 or newer, not %s; on macOS: brew install bash\n' \
    "${BASH_VERSION}" >&2
  exit 1
fi

set -euo pipefail

readonly START_MARK='<!-- ribbon:full-install:start -->'
readonly END_MARK='<!-- ribbon:full-install:end -->'
readonly SEED_RECORD='docs/.ribbon-full-install'
readonly INSTALL_RECEIPT='docs/.ribbon-full-install-receipt'
readonly SEED_STAMP_PATTERN='Seeded from the Ribbon Protocol, ribbon [0-9]+\.'

# State set by parse_args and consumed by the pipeline below.
RIBBON_HOME=''
PROJECT_REPO=''
COMMIT_NOTE=''
IMPORT_NOTE=''
IMPORT_RULES=()
AMEND=0
ASSUME_YES=0
UNINSTALL=0
REMOVE_RIBBON=0
WRITTEN_PATHS=()
OWNED_INSTALL_FILES=()
AGENTS_BLOCK_DIGEST=''
AGENTS_WRITE_NEEDED=1
DOC_SEEDS=()
SELECTED_RULES=()
SEED_VERSION=''
EXISTING_PROJECT_DOCS_AND_RULES=()
GNU_REALPATH=''

#######################################
# Print an error message to STDERR and exit.
# Arguments:
#   Message text.
# Outputs:
#   Writes to STDERR.
#######################################
die() {
  printf 'ribbon-seed-project: %s\n' "$*" >&2
  exit 1
}

#######################################
# Print usage to STDOUT.
# Outputs:
#   Writes to STDOUT.
#######################################
usage() {
  cat <<'EOF'
Usage:
  scripts/ribbon-seed-project [--ribbon-home DIR] [--yes] [--import-rules F]... \
      <project-repo-path>
  scripts/ribbon-seed-project --uninstall [--remove-ribbon] [--yes] <project-repo-path>

The full install: seeds a project repository with the Ribbon Protocol and
commits it for every collaborator. A project seeded before rules/ existed
gets a rules-only amendment instead of a refusal.

Options:
  --ribbon-home DIR  The template checkout. Default: the repository that
                     contains this script (~/ribbon-protocol when cloned
                     there).
  --import-rules F   Copy F from ~/.claude/rules into the project's rules/.
                     One file name per occurrence; repeat the flag for more.
                     Unknown names and paths containing / fail the run before
                     anything is written. Default in a terminal: a
                     multi-select picker offers the files. Non-interactive
                     runs skip with a note and never hang.
  --uninstall        Preview removal of a recorded full install; no writes by default.
  --remove-ribbon    Apply the uninstall plan after confirmation; requires --uninstall.
  --yes              Skip confirmation; required for non-interactive removal.
  -h, --help         Show this help and exit.

Examples:
  # seed the project in the current directory (run from the project root)
  scripts/ribbon-seed-project .

  # seed a project somewhere else
  scripts/ribbon-seed-project ~/dev/my-app

  # seed and import your own conventions without the picker
  scripts/ribbon-seed-project ~/dev/my-app \
      --import-rules xunit-patterns.md --import-rules clojure-preferences.md
EOF
}

#######################################
# Validate every --import-rules file before any mutating step, so a typo
# fails fast instead of halfway through an install.
# Globals:
#   HOME, IMPORT_RULES
#######################################
validate_import_rules() {
  [[ "${#IMPORT_RULES[@]}" -gt 0 ]] || return 0
  local f
  for f in "${IMPORT_RULES[@]}"; do
    [[ "${f}" != */* ]] || die "--import-rules takes file names, not paths: ${f}"
    [[ -f "${HOME}/.claude/rules/${f}" ]] \
      || die "--import-rules file not found: ${HOME}/.claude/rules/${f}"
  done
}

#######################################
# Parse the command line into the state globals.
# Globals:
#   RIBBON_HOME, PROJECT_REPO
# Arguments:
#   The raw command line.
#######################################
parse_args() {
  local ribbon_home_override=''
  local -a positional=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --ribbon-home) shift; ribbon_home_override="${1:-}"; shift ;;
      --yes) ASSUME_YES=1; shift ;;
      --uninstall) UNINSTALL=1; shift ;;
      --remove-ribbon) REMOVE_RIBBON=1; shift ;;
      --import-rules)
        shift
        [[ $# -gt 0 && -n "$1" && "$1" != --* ]] \
          || die "--import-rules takes exactly one file name (repeat the flag for more)"
        IMPORT_RULES+=("$1")
        shift
        ;;
      -h|--help) usage; exit 0 ;;
      *) positional+=("$1"); shift ;;
    esac
  done
  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  RIBBON_HOME="${ribbon_home_override:-$(cd "${script_dir}/.." && pwd)}"
  PROJECT_REPO="${positional[0]:-}"
  [[ "${#positional[@]}" -le 1 ]] \
    || die "unexpected extra arguments: ${positional[*]:1}"
}

path_present() {
  [[ -e "$1" || -L "$1" ]]
}

file_digest() {
  local checksum
  checksum="$(sha256sum)" || return 1
  printf '%s\n' "${checksum%% *}"
}

record_owned_doc() {
  local rel="$1" name="${1##*/}"
  case "${rel}" in
    docs/README.md|docs/field-guide.md|docs/tasks/README.md|docs/llm-context/README.md)
      OWNED_INSTALL_FILES+=("${rel}") ;;
    *)
      if [[ "${rel%/*}" == docs/tasks && "${name}" == _template.* ]] \
        || [[ "${rel%/*}" == docs/llm-context && "${name}" == _*.md ]]; then
        OWNED_INSTALL_FILES+=("${rel}")
      fi ;;
  esac
}

# A planned write may use only real project directories, never a link or
# another entry where a directory is needed.
validate_project_directory() {
  local directory="${PROJECT_REPO}/$1"
  while [[ "${directory}" != "${PROJECT_REPO}" ]]; do
    if [[ -L "${directory}" ]] || { [[ -e "${directory}" ]] && [[ ! -d "${directory}" ]]; }; then
      die "unsafe project directory: ${directory}"
    fi
    directory="${directory%/*}"
  done
}

collect_existing_project_docs_and_rules() {
  local name path listing
  local -a roots=()
  for name in docs rules; do
    path="${PROJECT_REPO}/${name}"
    [[ ! -d "${path}" ]] || roots+=("${path}")
  done
  (( ${#roots[@]} > 0 )) || return 0
  listing="$(mktemp)"
  if ! find "${roots[@]}" \( -type f -o -type l \) -print0 > "${listing}"; then
    rm -f "${listing}"
    die "cannot inspect existing project docs and rules"
  fi
  while IFS= read -r -d '' path; do
    EXISTING_PROJECT_DOCS_AND_RULES+=("${path}")
  done < "${listing}"
  rm -f "${listing}"
  for path in "${EXISTING_PROJECT_DOCS_AND_RULES[@]}"; do
    if [[ -L "${path}" && -d "${path}" ]]; then
      die "unsafe project directory link: ${path}"
    fi
  done
}

#######################################
# Find GNU realpath, whose -m resolves a path that does not exist yet: the
# system's realpath on Linux, Homebrew coreutils' grealpath on macOS, whose
# own realpath has no -m (and none at all before macOS 13).
# Globals:
#   GNU_REALPATH (set)
#######################################
find_gnu_realpath() {
  local candidate
  for candidate in realpath grealpath; do
    if "${candidate}" -m -- / >/dev/null 2>&1; then
      GNU_REALPATH="${candidate}"
      return 0
    fi
  done
  die "needs GNU realpath to resolve paths that do not exist yet; on macOS: brew install coreutils"
}

#######################################
# Print the canonical form of a path: every link followed, `.` and `..`
# folded, and components that do not exist yet kept as written.
# Globals:
#   GNU_REALPATH
# Arguments:
#   A path.
# Outputs:
#   The canonical path on STDOUT.
#######################################
canonical_path() {
  "${GNU_REALPATH}" -m -- "$1"
}

# Walk the link without dropping missing components canceled by `..`.
missing_link_component_matches_write() {
  local pending="$1" destination="$2" parent='' component entry target hops=0
  while [[ -n "${pending}" ]]; do
    component="${pending%%/*}"
    if [[ "${pending}" == */* ]]; then pending="${pending#*/}"; else pending=''; fi
    case "${component}" in
      ''|.) continue ;;
      ..) parent="${parent%/*}"; continue ;;
    esac
    entry="${parent}/${component}"
    if [[ -L "${entry}" ]]; then
      if (( ++hops > 40 )); then return 1; fi
      target="$(readlink -n -- "${entry}" && printf /)" || die "cannot read project link: ${entry}"
      if [[ "${target}" == /* ]]; then parent=''; fi
      pending="${target}${pending}"
    else
      if [[ ! -e "${entry}" && ( "${destination}" == "${entry}" || "${destination}" == "${entry}/"* ) ]]; then
        return 0
      fi
      parent="${entry}"
    fi
  done
  return 1
}

validate_existing_project_paths() {
  local destination="$1" path resolved_destination='' target
  for path in "${EXISTING_PROJECT_DOCS_AND_RULES[@]}"; do
    if [[ ! "${destination}" -ef "${path}" ]]; then
      [[ -L "${path}" ]] || continue
      if [[ -z "${resolved_destination}" ]]; then
        resolved_destination="$(canonical_path "${destination}")"
      fi
      target="$(canonical_path "${path}")"
      if [[ "${resolved_destination}" != "${target}" && "${resolved_destination}" != "${target%/}/"* ]] \
        && { [[ -e "${path}" ]] || ! missing_link_component_matches_write "${path}" "${resolved_destination}"; }; then
        continue
      fi
    fi
    die "${destination} would change existing project path: ${path#"${PROJECT_REPO}"/}"
  done
}

#######################################
# Validate inputs and resolve the project repository path.
# Globals:
#   RIBBON_HOME, PROJECT_REPO (set)
#######################################
resolve_repo() {
  [[ -n "${PROJECT_REPO}" ]] || { usage; die "missing <project-repo-path>"; }
  [[ -f "${RIBBON_HOME}/AGENTS.md" && -d "${RIBBON_HOME}/docs" && -d "${RIBBON_HOME}/rules" ]] \
    || die "template not found under ${RIBBON_HOME} (point --ribbon-home at the template repo)"
  [[ -d "${PROJECT_REPO}" ]] || die "project repo not found: ${PROJECT_REPO}"
  [[ -w "${PROJECT_REPO}" && -x "${PROJECT_REPO}" ]] \
    || die "project repo is not writable with your permissions: ${PROJECT_REPO}"
  PROJECT_REPO="$(canonical_path "${PROJECT_REPO}")"
  validate_project_directory docs
  validate_project_directory rules

  local record="${PROJECT_REPO}/${SEED_RECORD}" readme="${PROJECT_REPO}/docs/README.md"
  if path_present "${record}"; then
    if [[ -f "${record}" && ! -L "${record}" ]] && grep -qxE "${SEED_STAMP_PATTERN}" "${record}"; then
      die "${PROJECT_REPO} is already full-installed (merge template changes by hand)"
    fi
    die "reserved seed record already exists: ${record}; left untouched"
  fi

  AMEND=0
  if [[ -f "${readme}" && ! -L "${readme}" ]] \
    && head -1 "${readme}" | grep -qxE "${SEED_STAMP_PATTERN}"; then
    if path_present "${PROJECT_REPO}/rules/README.md"; then
      die "${PROJECT_REPO} is already full-installed (merge template changes by hand)"
    fi
    AMEND=1
  fi
}

#######################################
# Refuse the classic misinstalls — the user's home directory and the template
# repository itself — and, in a terminal, ask for confirmation before any
# write. Non-interactive runs proceed so agents never hang.
# Globals:
#   PROJECT_REPO, RIBBON_HOME, HOME, ASSUME_YES
#######################################
confirm_target() {
  local home_resolved ribbon_resolved
  home_resolved="$(canonical_path "${HOME}")"
  ribbon_resolved="$(canonical_path "${RIBBON_HOME}")"
  [[ "${PROJECT_REPO}" != "${home_resolved}" ]] \
    || die "refusing to seed your home directory: ${PROJECT_REPO}"
  [[ "${PROJECT_REPO}" != "${ribbon_resolved}" ]] \
    || die "refusing to seed the template repository itself: ${PROJECT_REPO}"
  if [[ -t 0 && "${ASSUME_YES}" -eq 0 ]]; then
    local answer
    printf 'About to write Ribbon files into %s. Proceed? [y/N] ' "${PROJECT_REPO}" >&2
    read -r answer || answer=''
    if [[ "${answer}" != "y" && "${answer}" != "Y" ]]; then
      die "aborted"
    fi
  fi
}

#######################################
# Plan only missing template paths; an occupied entry belongs to the project.
# Globals:
#   RIBBON_HOME, PROJECT_REPO
#######################################
prepare_doc_seeds() {
  local raw_list f rel
  local -a missing=()
  raw_list="$(mktemp)"
  if ! find "${RIBBON_HOME}/docs" -type f -print0 2>/dev/null | sort -z > "${raw_list}"; then
    rm -f "${raw_list}"
    die "cannot enumerate ${RIBBON_HOME}/docs (check permissions); nothing was copied or committed"
  fi
  while IFS= read -r -d '' f; do
    rel="${f#"${RIBBON_HOME}"/}"
    [[ "${rel}" != "${SEED_RECORD}" && "${rel}" != "${INSTALL_RECEIPT}" ]] || continue
    DOC_SEEDS+=("${rel}")
  done < "${raw_list}"
  rm -f "${raw_list}"
  for rel in "${DOC_SEEDS[@]}"; do
    validate_project_directory "${rel%/*}"
    path_present "${PROJECT_REPO}/${rel}" && continue
    validate_instruction_destination "${rel}"
    missing+=("${rel}")
  done
  DOC_SEEDS=("${missing[@]}")
}

seed_docs() {
  local rel destination
  for rel in "${DOC_SEEDS[@]}"; do
    destination="${PROJECT_REPO}/${rel}"
    mkdir -p "${destination%/*}"
    if [[ "${rel}" == docs/README.md ]]; then
      (set -o noclobber; sed "1s|<ribbon-version>|${SEED_VERSION}|" "${RIBBON_HOME}/${rel}" > "${destination}")
    else
      cp "${RIBBON_HOME}/${rel}" "${destination}"
    fi
    WRITTEN_PATHS+=("${rel}")
    record_owned_doc "${rel}"
  done
}

write_seed_record() {
  mkdir -p "${PROJECT_REPO}/docs"
  (set -o noclobber; printf 'Seeded from the Ribbon Protocol, %s.\n' "${SEED_VERSION}" > "${PROJECT_REPO}/${SEED_RECORD}")
  WRITTEN_PATHS+=("${SEED_RECORD}")
  OWNED_INSTALL_FILES+=("${SEED_RECORD}")
}

prepare_seed_record() {
  local rel
  for rel in "${SEED_RECORD}" "${INSTALL_RECEIPT}"; do
    if path_present "${PROJECT_REPO}/${rel}"; then
      die "reserved install metadata already exists: ${rel}"
    fi
    validate_instruction_destination "${rel}"
    if git -C "${PROJECT_REPO}" check-ignore -q -- "${rel}" 2>/dev/null; then
      die "seed record is ignored by Git: ${rel}; allow it before installing"
    fi
  done
}

write_install_receipt() {
  local rel digest
  (
    set -o noclobber
    {
      printf 'ribbon-full-install-receipt-v1\0'
      for rel in "${OWNED_INSTALL_FILES[@]}"; do
        digest="$(file_digest < "${PROJECT_REPO}/${rel}")"
        printf 'file\0%s\0%s\0' "${rel}" "${digest}"
      done
      if [[ -n "${AGENTS_BLOCK_DIGEST}" ]]; then
        printf 'block\0AGENTS.md\0%s\0' "${AGENTS_BLOCK_DIGEST}"
      fi
    } > "${PROJECT_REPO}/${INSTALL_RECEIPT}"
  )
  WRITTEN_PATHS+=("${INSTALL_RECEIPT}")
}

uninstall_full_install() {
  [[ -n "${PROJECT_REPO}" && -d "${PROJECT_REPO}" ]] || die "uninstall requires an existing project directory"
  local home_resolved ribbon_resolved
  PROJECT_REPO="$(canonical_path "${PROJECT_REPO}")"
  home_resolved="$(canonical_path "${HOME}")"
  ribbon_resolved="$(canonical_path "${RIBBON_HOME}")"
  [[ "${PROJECT_REPO}" != / && "${PROJECT_REPO}" != "${home_resolved}" \
    && "${PROJECT_REPO}" != "${ribbon_resolved}" ]] \
    || die "refusing to uninstall from the filesystem root, home, or template repository"
  python3 -c "$(cat <<'PY'
from contextlib import contextmanager
import errno
import hashlib
import os
from pathlib import Path, PurePosixPath
import re
import secrets
import stat
import sys

root = Path(sys.argv[1])
receipt, marker, start, end = sys.argv[2:6]
apply, yes = (flag == "1" for flag in sys.argv[6:8])
start = b"\n" + start.encode() + b"\n"
end = end.encode() + b"\n"

def refuse(message):
    raise SystemExit(f"ribbon-seed-project: {message}")

def permitted(name):
    path = PurePosixPath(name)
    if path.as_posix() != name or path.is_absolute() or ".." in path.parts:
        return False
    return name in {"AGENTS.md", "herdr-config.md", marker, "docs/README.md",
                    "docs/field-guide.md", "docs/tasks/README.md", "docs/llm-context/README.md"} or (
        (str(path.parent) == "docs/tasks" and path.name.startswith("_template.")) or
        (str(path.parent) == "docs/llm-context" and path.name.startswith("_") and path.suffix == ".md")
    )

@contextmanager
def bound_parent(name):
    fd = os.dup(root_fd)
    parts = PurePosixPath(name).parts
    try:
        for component in parts[:-1]:
            child = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = child
        yield fd, parts[-1]
    finally:
        os.close(fd)

def snapshot_at(fd, leaf, name):
    before = os.stat(leaf, dir_fd=fd, follow_symlinks=False)
    if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1:
        return None, None
    with os.fdopen(os.open(leaf, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=fd), "rb") as stream:
        current = os.fstat(stream.fileno())
        if not same_inode(current, before) or current.st_nlink != 1:
            raise OSError(f"path changed during uninstall: {name}")
        return before, stream.read()

def snapshot(name):
    try:
        with bound_parent(name) as (fd, leaf):
            return snapshot_at(fd, leaf, name)
    except FileNotFoundError:
        return None, b""
    except PermissionError as error:
        raise PermissionError(error.errno, error.strerror, name) from error
    except OSError as error:
        if error.errno in (errno.ELOOP, errno.ENOTDIR):
            return None, None
        raise

def same_inode(first, second):
    return (first.st_dev, first.st_ino) == (second.st_dev, second.st_ino)

def replace_block(fd, leaf, replacement, mode):
    temporary = ".ribbon-agents-" + secrets.token_hex(12)
    temp_fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600, dir_fd=fd)
    try:
        with os.fdopen(temp_fd, "wb") as stream:
            stream.write(replacement)
            os.fchmod(stream.fileno(), stat.S_IMODE(mode))
        os.replace(temporary, leaf, src_dir_fd=fd, dst_dir_fd=fd)
        temporary = None
    finally:
        if temporary is not None:
            os.unlink(temporary, dir_fd=fd)

def display(name):
    return name if name.isprintable() else repr(name)

def unchanged_block(data):
    if data.count(start) != 1 or data.count(end) != 1:
        return None, None
    lo = data.index(start)
    hi = data.index(end) + len(end)
    if hi <= lo:
        return None, None
    return data[lo:hi], data[:lo] + data[hi:]

def report_changed(changed):
    if changed:
        print("Review changed files manually; these were left in place:")
        for name in changed:
            print(f"  {display(name)}")

def uninstall():
    receipt_stat, proof = snapshot(receipt)
    if receipt_stat is None:
        refuse("no safe full-install ownership receipt; nothing removed")
    fields = proof.split(b"\0")
    if fields[0] != b"ribbon-full-install-receipt-v1" or fields[-1] != b"" or len(fields[1:-1]) % 3:
        refuse("invalid full-install ownership receipt; nothing removed")
    plan, changed, seen = [], [], set()
    for idx in range(1, len(fields) - 1, 3):
        kind, raw_path, digest = fields[idx:idx + 3]
        name = os.fsdecode(raw_path)
        if (name in seen or not permitted(name) or kind not in (b"file", b"block")
                or (kind == b"block" and name != "AGENTS.md")
                or not re.fullmatch(b"[0-9a-f]{64}", digest)):
            refuse("invalid ownership entry in full-install receipt; nothing removed")
        seen.add(name)
        info, content = snapshot(name)
        if info is None:
            if content is None:
                changed.append(name)
            continue
        owned, remaining = unchanged_block(content) if kind == b"block" else (content, None)
        if owned is None or hashlib.sha256(owned).hexdigest().encode() != digest:
            changed.append(name)
        else:
            plan.append((name, info, content, remaining))
    if marker not in seen:
        refuse("incomplete full-install ownership receipt; nothing removed")
    plan.append((receipt, receipt_stat, proof, None))
    print("Would remove Ribbon-owned paths or blocks:")
    for name, _, _, replacement in plan:
        print(f"  {display(name)}" + (" (Ribbon block only)" if replacement is not None else ""))
    if not apply:
        print("Dry run only; use --uninstall --remove-ribbon to apply.")
    elif not yes:
        if not sys.stdin.isatty():
            refuse("non-interactive removal requires --yes; nothing removed")
        sys.stdout.flush()
        print("Remove these Ribbon files and blocks? [y/N] ", end="", file=sys.stderr, flush=True)
        if input().strip().lower() not in ("y", "yes"):
            print("Uninstall declined; nothing removed.")
            return
    if apply:
        for name, _, _, replacement in plan:
            path = root / name
            if not os.access(path.parent, os.W_OK | os.X_OK) or (
                    replacement is not None and not os.access(path, os.W_OK)):
                report_changed(changed)
                refuse(f"permission denied: {name}; nothing removed")
        for name, original, content, _ in plan:
            now, current = snapshot(name)
            if now is None or not same_inode(original, now) or current != content:
                refuse(f"path changed since preview: {name}; nothing removed")
        completed = []
        for name, original, content, replacement in plan:
            try:
                with bound_parent(name) as (fd, leaf):
                    now, current = snapshot_at(fd, leaf, name)
                    if now is None or not same_inode(original, now) or current != content:
                        raise OSError("path changed since preview")
                    if replacement is None:
                        os.unlink(leaf, dir_fd=fd)
                    else:
                        replace_block(fd, leaf, replacement, now.st_mode)
                completed.append(name)
            except OSError as error:
                if completed:
                    print("Completed before uninstall stopped:", file=sys.stderr)
                    for path in completed:
                        print(f"  {display(path)}", file=sys.stderr)
                report_changed(changed)
                refuse(f"uninstall stopped at {display(name)}: {error}")
        print("Full-install removal complete. No Git changes were staged.")
    report_changed(changed)

try:
    root_fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        uninstall()
    finally:
        os.close(root_fd)
except (OSError, EOFError) as error:
    refuse(f"uninstall stopped: {error}")
PY
)" "${PROJECT_REPO}" "${INSTALL_RECEIPT}" "${SEED_RECORD}" "${START_MARK}" "${END_MARK}" \
    "${REMOVE_RIBBON}" "${ASSUME_YES}"
}

#######################################
# Copy the template's rules/ themes into the project repository, merging
# into an existing rules/ directory and never overwriting project themes.
# Globals:
#   RIBBON_HOME, PROJECT_REPO, WRITTEN_PATHS (appended)
#######################################
visit_rule_seeds() {
  local visit="$1" f rel
  for f in "${RIBBON_HOME}/rules"/*.md; do
    [[ -e "${f}" ]] || continue
    rel="rules/${f##*/}"
    path_present "${PROJECT_REPO}/${rel}" && continue
    "${visit}" "${rel}"
  done
}

copy_rule_seed() {
  cp "${RIBBON_HOME}/$1" "${PROJECT_REPO}/$1"
  WRITTEN_PATHS+=("$1")
}

seed_rules() {
  mkdir -p "${PROJECT_REPO}/rules"
  visit_rule_seeds copy_rule_seed
}

#######################################
# Refuse any seed that would write through an instruction alias, including
# a dangling link whose target the seed would create. Claude -> AGENTS.md
# is intentional wiring, not a Claude-owned destination.
# Globals:
#   PROJECT_REPO
#######################################
validate_instruction_destination() {
  local name="$1" destination="${PROJECT_REPO}/$1" instruction path resolved_destination resolved_instruction
  if [[ "${name}" == AGENTS.md || "${name}" == herdr-config.md ]] \
    && [[ -e "${destination}" || -L "${destination}" ]]; then
    [[ -f "${destination}" ]] || die "not a regular file: ${destination}"
  fi
  validate_existing_project_paths "${destination}"
  for instruction in AGENTS.md AGENTS.local.md CLAUDE.md CLAUDE.local.md; do
    [[ "${instruction}" != "${name}" ]] || continue
    path="${PROJECT_REPO}/${instruction}"
    if [[ ! "${destination}" -ef "${path}" ]]; then
      [[ -L "${path}" && ! -e "${path}" ]] || continue
      resolved_destination="$(canonical_path "${destination}")"
      resolved_instruction="$(canonical_path "${path}")"
      [[ "${resolved_destination}" == "${resolved_instruction}" ]] || continue
    fi
    if [[ "${name}" == AGENTS.md && "${instruction}" == CLAUDE* && ! -L "${destination}" && -L "${path}" ]]; then
      continue
    fi
    die "${name} aliases ${instruction}; refusing to write it"
  done
}

#######################################
# Determine which instruction destinations will be written before seeding.
#######################################
prepare_instruction_files() {
  local agents="${PROJECT_REPO}/AGENTS.md"
  if [[ -f "${agents}" ]]; then
    [[ -r "${agents}" ]] || die "not readable: ${agents}"
    if grep -Fq "${START_MARK}" "${agents}"; then
      AGENTS_WRITE_NEEDED=0
    else
      [[ -w "${agents}" ]] || die "not writable: ${agents}"
    fi
  fi
  if (( AGENTS_WRITE_NEEDED == 1 )); then
    validate_instruction_destination AGENTS.md
  fi
  validate_instruction_destination herdr-config.md
}

#######################################
# Append the marked protocol to AGENTS.md, or create it when absent.
#######################################
full_instruction_block() {
  printf '\n%s\n' "${START_MARK}"
  cat "${RIBBON_HOME}/AGENTS.md"
  printf '%s\n' "${END_MARK}"
}

wire_agents_md() {
  (( AGENTS_WRITE_NEEDED == 1 )) || return 0
  if [[ ! -f "${PROJECT_REPO}/AGENTS.md" ]]; then
    cp "${RIBBON_HOME}/AGENTS.md" "${PROJECT_REPO}/AGENTS.md"
    WRITTEN_PATHS+=("AGENTS.md")
    OWNED_INSTALL_FILES+=("AGENTS.md")
    return
  fi
  AGENTS_BLOCK_DIGEST="$(full_instruction_block | file_digest)"
  full_instruction_block >> "${PROJECT_REPO}/AGENTS.md"
  WRITTEN_PATHS+=("AGENTS.md")
}

#######################################
# Copy herdr-config.md beside AGENTS.md.
# Globals:
#   RIBBON_HOME, PROJECT_REPO
#######################################
wire_herdr() {
  if ! path_present "${PROJECT_REPO}/herdr-config.md"; then
    OWNED_INSTALL_FILES+=("herdr-config.md")
  fi
  cp "${RIBBON_HOME}/herdr-config.md" "${PROJECT_REPO}/herdr-config.md"
  WRITTEN_PATHS+=("herdr-config.md")
}

#######################################
# Warn about existing Claude files without a direct AGENTS import or link.
# Never create, modify or stage either Claude file.
#######################################
warn_unlinked_claude_files() {
  local suffix agents claude
  for suffix in .md .local.md; do
    agents="AGENTS${suffix}"
    claude="CLAUDE${suffix}"
    [[ -f "${PROJECT_REPO}/${agents}" && -f "${PROJECT_REPO}/${claude}" ]] || continue
    if [[ -L "${PROJECT_REPO}/${claude}" && "${PROJECT_REPO}/${claude}" -ef "${PROJECT_REPO}/${agents}" ]] \
      || grep -Eq "^@(\./)?${agents//./\\.}[[:space:]]*$" "${PROJECT_REPO}/${claude}" 2>/dev/null; then
      continue
    fi
    printf 'warning: %s does not point to %s; left unchanged\n' "${claude}" "${agents}" >&2
  done
}

#######################################
# Commit the seed as one commit when the project is a git repository.
# Globals:
#   PROJECT_REPO, COMMIT_NOTE (set)
#######################################
commit_seed() {
  local version
  version="$(head -1 "${RIBBON_HOME}/VERSION")"
  if git -C "${PROJECT_REPO}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local -a literal_specs=()
    local p
    for p in "${WRITTEN_PATHS[@]}"; do
      literal_specs+=(":(literal)${p}")
    done
    git -C "${PROJECT_REPO}" add -- "${literal_specs[@]}"
    git -C "${PROJECT_REPO}" commit -m "Seed the Ribbon Protocol, ${version}" \
      -- "${literal_specs[@]}"
    COMMIT_NOTE="committed as 'Seed the Ribbon Protocol, ${version}'"
  else
    COMMIT_NOTE='not a git repository, nothing committed'
  fi
}

#######################################
# Print a summary of what happened.
# Globals:
#   PROJECT_REPO, COMMIT_NOTE, START_MARK, END_MARK, RIBBON_HOME
#######################################
print_summary() {
  local version
  version="$(head -1 "${RIBBON_HOME}/VERSION")"
  cat <<EOF
Seeded the Ribbon Protocol (${version}) into ${PROJECT_REPO}:

  docs/           missing homes, schemas, templates and field guide added
  rules/          missing coding conventions added; existing paths kept
  seed record     ${SEED_RECORD}
  uninstall proof ${INSTALL_RECEIPT}
  AGENTS.md       protocol appended (${START_MARK} .. ${END_MARK})
  herdr-config.md the optional Herdr overlay, beside AGENTS.md
  Claude files   left unchanged
  git:            ${COMMIT_NOTE}

Next: fill the belt — open AGENTS.md, replace every TODO(belt) with your
names, models and gate commands.
EOF
}

#######################################
# Offer the user's machine-global rules (~/.claude/rules) as project themes so
# every engineer gets them. With --import-rules, copies exactly those files.
# In a terminal, shows a multi-select prompt. Otherwise prints a note and
# imports nothing. Existing project themes are never overwritten.
# Globals:
#   HOME, PROJECT_REPO, IMPORT_RULES, IMPORT_NOTE (set)
#######################################
prepare_user_rule_imports() {
  local rules_dir="${HOME}/.claude/rules"
  local -a candidates=()
  local f
  if [[ -d "${rules_dir}" ]]; then
    for f in "${rules_dir}"/*.md; do
      [[ -f "${f}" ]] && candidates+=("$(basename "${f}")")
    done
  fi
  IMPORT_NOTE=''

  if [[ "${#IMPORT_RULES[@]}" -gt 0 ]]; then
    SELECTED_RULES=("${IMPORT_RULES[@]}")
  elif [[ "${#candidates[@]}" -eq 0 ]]; then
    return 0
  elif [[ -t 0 ]]; then
    pick_rules "${candidates[@]}"
    SELECTED_RULES=("${PICKED[@]}")
  else
    printf 'note: %d rule file(s) in %s not imported (not interactive); re-run in a terminal or pass --import-rules\n' \
      "${#candidates[@]}" "${rules_dir}" >&2
    return 0
  fi

  for f in "${SELECTED_RULES[@]}"; do
    [[ -f "${rules_dir}/${f}" ]] || die "--import-rules file not found: ${rules_dir}/${f}"
    path_present "${PROJECT_REPO}/rules/${f}" || validate_instruction_destination "rules/${f}"
  done
}

import_user_rules() {
  [[ "${#SELECTED_RULES[@]}" -gt 0 ]] || return 0
  local rules_dir="${HOME}/.claude/rules" f imported=0 kept=0
  for f in "${SELECTED_RULES[@]}"; do
    if path_present "${PROJECT_REPO}/rules/${f}"; then
      kept=$((kept + 1))
      continue
    fi
    cp "${rules_dir}/${f}" "${PROJECT_REPO}/rules/${f}"
    WRITTEN_PATHS+=("rules/${f}")
    imported=$((imported + 1))
  done
  IMPORT_NOTE="imported ${imported} user rule file(s) from ${rules_dir}"
  if (( kept > 0 )); then
    IMPORT_NOTE+=" (${kept} already present, kept as-is)"
  fi
}

#######################################
# Interactive multi-select over the candidate rule files. Sets PICKED.
# Arguments:
#   Candidate file names.
# Globals:
#   PICKED (set)
# Outputs:
#   Prompt and menu to STDERR.
#######################################
pick_rules() {
  local -a picked=() options=("$@")
  local input tok opt p mark
  while true; do
    printf '\nImport coding rules from ~/.claude/rules so every engineer gets them?\n' >&2
    local i=1
    for opt in "${options[@]}"; do
      mark=' '
      for p in "${picked[@]}"; do
        [[ "${p}" == "${opt}" ]] && mark='x'
      done
      printf '  [%s] %d) %s\n' "${mark}" "${i}" "${opt}" >&2
      i=$((i + 1))
    done
    printf 'Toggle numbers, [a]ll, [n]one, [d]one: ' >&2
    read -r input || input='d'
    case "${input}" in
      a) picked=("${options[@]}") ;;
      n) picked=() ;;
      d) break ;;
      *[!0-9\ ]*) printf 'Answer with numbers, a, n or d.\n' >&2 ;;
      *)
        local -a toks=()
        read -ra toks <<< "${input}"
        for tok in "${toks[@]}"; do
          if [[ ! "${tok}" =~ ^[0-9]+$ ]] || (( ${#tok} > 9 )); then
            printf 'Not a rule number: %s\n' "${tok}" >&2
            continue
          fi
          local num=$((10#$tok))
          if (( num < 1 || num > ${#options[@]} )); then
            printf 'No rule number %s.\n' "${tok}" >&2
            continue
          fi
          opt="${options[$((num - 1))]}"
          local -a next=()
          local found=0
          for p in "${picked[@]}"; do
            if [[ "${p}" == "${opt}" ]]; then
              found=1
            else
              next+=("${p}")
            fi
          done
          if (( found == 0 )); then
            next+=("${opt}")
          fi
          picked=("${next[@]}")
        done
        ;;
    esac
  done
  PICKED=("${picked[@]}")
}

#######################################
# Commit a rules-only amendment when the project is a git repository.
# Globals:
#   RIBBON_HOME, PROJECT_REPO, COMMIT_NOTE (set)
#######################################
commit_amend() {
  local version
  version="$(head -1 "${RIBBON_HOME}/VERSION")"
  if git -C "${PROJECT_REPO}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local -a literal_specs=()
    local p
    for p in "${WRITTEN_PATHS[@]}"; do
      literal_specs+=(":(literal)${p}")
    done
    git -C "${PROJECT_REPO}" add -- "${literal_specs[@]}"
    git -C "${PROJECT_REPO}" commit -m "Add Ribbon coding rules, ${version}" \
      -- "${literal_specs[@]}"
    COMMIT_NOTE="committed as 'Add Ribbon coding rules, ${version}'"
  else
    COMMIT_NOTE='not a git repository, nothing committed'
  fi
}

#######################################
# Print the amendment summary.
# Globals:
#   PROJECT_REPO, COMMIT_NOTE, IMPORT_NOTE
#######################################
print_amend_summary() {
  local import_line=''
  if [[ -n "${IMPORT_NOTE}" ]]; then
    import_line="  user rules:      ${IMPORT_NOTE}
"
  fi
  cat <<EOF
Added Ribbon coding rules to the already-seeded project ${PROJECT_REPO}:

  rules/          coding conventions, one theme per file
${import_line}  git:            ${COMMIT_NOTE}

Next: run --update on any standalone instances of this project.
EOF
}

#######################################
# Entry point: validate, seed, wire, commit, report.
# Arguments:
#   The raw command line.
#######################################
main() {
  parse_args "$@"
  find_gnu_realpath
  if (( UNINSTALL == 1 )); then
    [[ "${#IMPORT_RULES[@]}" -eq 0 ]] || die "--import-rules cannot be used with --uninstall"
    uninstall_full_install
    return
  fi
  (( REMOVE_RIBBON == 0 )) || die "--remove-ribbon requires --uninstall"
  validate_import_rules
  resolve_repo
  SEED_VERSION="$(head -1 "${RIBBON_HOME}/VERSION")"
  [[ "${SEED_VERSION}" =~ ^ribbon\ [0-9]+$ ]] || die "invalid Ribbon seed version: ${SEED_VERSION}"
  confirm_target
  collect_existing_project_docs_and_rules
  if (( AMEND == 0 )); then
    prepare_instruction_files
    prepare_doc_seeds
    prepare_seed_record
  fi
  if ! path_present "${PROJECT_REPO}/rules"; then
    validate_instruction_destination rules
  fi
  visit_rule_seeds validate_instruction_destination
  prepare_user_rule_imports
  if (( AMEND == 1 )); then
    seed_rules
    import_user_rules
    [[ "${#WRITTEN_PATHS[@]}" -gt 0 ]] \
      || die "every Ribbon theme is already present in ${PROJECT_REPO}; nothing to amend"
    commit_amend
    print_amend_summary
    warn_unlinked_claude_files
    return
  fi
  seed_docs
  seed_rules
  import_user_rules
  wire_agents_md
  wire_herdr
  write_seed_record
  write_install_receipt
  commit_seed
  print_summary
  warn_unlinked_claude_files
}

main "$@"
